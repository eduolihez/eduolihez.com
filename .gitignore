# build output
dist/
.astro/
dist-ssr/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment / secrets (NUNCA subir credenciales al repo)
.env
.env.*
!.env.example
server/config.php

# Copias sueltas de credenciales en la RAIZ del repo.
# Las reglas de arriba son rutas exactas: una copia de db.php o config.php en
# la raiz no quedaba cubierta y un "git add ." la habria subido al repositorio
# publico con la contrasena de la base de datos dentro.
# Se anclan con "/" para no afectar a server/db.php, que si va versionado
# (ese lee las credenciales de config.php y no las lleva escritas).
/db.php
/config.php

# uploads (keep folder structures but ignore uploaded files)
server/uploads/*
!server/uploads/.htaccess
!server/uploads/index.html

# editor / OS
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# setup documentation (guias locales)
DEPLOY.md
GUIA.md
SEO.md
CLOUDFLARE.md
