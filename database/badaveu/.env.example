# ────────────────────────────────────────────────────────────────
# BadaVeu — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena tus valores reales.
# El fichero `.env` está ignorado por git: NUNCA subas credenciales.
# ────────────────────────────────────────────────────────────────

# Base de datos (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=badaveu
DB_USER=tu_usuario
DB_PASS=tu_contraseña_segura
DB_CHARSET=utf8mb4

# Clave de aplicación (genera una aleatoria, p.ej. `openssl rand -hex 32`)
APP_KEY=

# Entorno: development | production
APP_ENV=production
APP_DEBUG=false

# Versión de la API
API_VERSION=1

# Proxy de confianza (IP o vacío)
TRUSTED_PROXY=

# URL pública de la app (usada para CORS). Sin barra final.
APP_URL=https://badaveu.eduolihez.com
