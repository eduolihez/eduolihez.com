# PhishLab "lab" — herramienta completa (marca real), acceso restringido.
#
# Ya NO es HTTP Basic Auth: el gate lo hace index.php en PHP, con cuentas
# individuales en la tabla lab_users (gestionadas desde /admin ->
# lab-users.php) y bloqueo por fuerza bruta real -- Apache Basic Auth no
# sabe contar intentos fallidos, así que ese bloqueo solo es posible
# pasando por PHP. Ver server/lab/auth.php.
#
# Todo lo que llegue a /lab-app/ se reescribe a index.php, EXCEPTO login.php
# y logout.php (que tienen que poder cargarse ellos mismos sin sesión
# todavía). index.php resuelve la ruta pedida contra _content/ (que tiene su
# propio .htaccess con "Require all denied": ni siquiera una URL directa a
# /lab-app/_content/... se sirve sin pasar por aquí).
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/lab-app/login\.php$
RewriteCond %{REQUEST_URI} !^/lab-app/logout\.php$
RewriteRule ^ index.php [L]
