# ===========================================================================
#  .htaccess de la aplicacion BadaVeu  (/projects/badaveu/)
#
#  DEFENSA EN PROFUNDIDAD. El .htaccess de la raiz (server/.htaccess ->
#  public_html/.htaccess) ya bloquea .env, *.sql, *.md y db.php en todo el
#  sitio, pero esa proteccion depende de UN solo archivo oculto que hay que
#  acordarse de subir por FTP. Si un dia se sube el sitio sin el, esta app
#  quedaria con las credenciales de la base de datos al descubierto.
#
#  Este archivo hace que la carpeta se proteja a si misma.
# ===========================================================================

# --- Credenciales y configuracion -----------------------------------------
# .env contiene DB_USER, DB_PASS y APP_KEY en texto plano. Apache serviria un
# archivo .env como texto/plano si no se bloquea: fuga total de la BD.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "^(db|config)\.php$">
  Require all denied
</FilesMatch>

# Cualquier archivo oculto (.env, .gitignore, .htaccess, .DS_Store...).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Volcados de base de datos y documentacion ------------------------------
# database.sql / demo_incidencies.sql revelan el esquema completo (y datos de
# ejemplo). README.md describe la arquitectura. No deben servirse jamas.
<FilesMatch "\.(sql|md|log|bak|inc|ini|yml|yaml|sh)$">
  Require all denied
</FilesMatch>

# --- Endurecimiento general -------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
  # El API y el panel de esta app no deben indexarse.
  <FilesMatch "\.php$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
