# ===========================================================================
#  BLOQUEO TOTAL - cache del rate limiter
#
#  RateLimiter.php guarda aqui archivos <sha256>.json con el recuento de
#  intentos por IP y accion. No son secretos criticos, pero exponerlos revela
#  actividad del sitio y permitiria a un atacante comprobar si su IP esta
#  bloqueada. No hay ninguna razon para servirlos por HTTP.
# ===========================================================================

Require all denied

Options -Indexes

# php_flag solo es valido con mod_php; sin <IfModule> rompe con PHP-FPM/CGI.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
</IfModule>
