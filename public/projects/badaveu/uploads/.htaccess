# ===========================================================================
#  Carpeta de imagenes subidas por los ciudadanos (fotos de incidencias).
#
#  Las subidas son ANONIMAS, asi que esta carpeta es el objetivo natural de
#  un intento de subir un webshell. api/index.php ya valida MIME real, magic
#  bytes, extension en lista blanca y renombra con bin2hex(random_bytes(16)),
#  pero eso es UNA capa. Esta es la segunda: aunque un dia entrara un .php,
#  aqui no se ejecutaria nunca.
# ===========================================================================

# Nada de codigo en esta carpeta: solo se sirven imagenes.
Options -Indexes

# php_flag solo existe con mod_php. Si el hosting usa PHP-FPM/CGI, la directiva
# sin <IfModule> tumba la carpeta entera con un 500. Por eso va protegida.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .sh
</IfModule>

# Lista blanca real: solo se puede descargar lo que es una imagen.
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
  Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(jpg|jpeg|png|webp|gif)$).*$">
  Require all denied
</FilesMatch>

# Que el navegador no interprete nada raro que llegue de aqui.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
