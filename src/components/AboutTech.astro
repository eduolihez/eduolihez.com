---
/**
 * <AboutTech /> - Cuerpo de la pagina "Sobre esta web".
 *
 * El contenido vive en src/data/about-tech.ts y se recorre desde aqui, asi que
 * las versiones en espanol, ingles y catalan comparten estructura y no pueden
 * descompasarse. Cada pagina solo aporta sus textos de cabecera.
 */
import { techSections, stackRows } from '../data/about-tech';
import { pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  /** Etiquetas de la pagina que no salen del archivo de datos. */
  labels: {
    stackTitle: string;
    sourceNote: string;
    metricsTitle: string;
    metricsNote: string;
    metrics: string[];
    ctaCode: string;
    ctaContact: string;
  };
  contactHref: string;
}
const { lang, labels, contactHref } = Astro.props;

/** Clases de color por bloque. Se escriben enteras para que Tailwind las vea. */
const tones = {
  accent: 'bg-accent/10 border-accent/20 text-accent',
  cyan: 'bg-cyan/10 border-cyan/20 text-cyan',
  violet: 'bg-violet/10 border-violet/20 text-violet',
} as const;
---

<!-- Resumen del stack -->
<div class="reveal mb-16 overflow-hidden rounded-xl border border-bg-border bg-bg-card">
  <p
    class="border-b border-bg-border bg-bg-soft/50 px-6 py-3 font-mono text-xs font-semibold uppercase tracking-wider text-text-muted"
  >
    {labels.stackTitle}
  </p>
  <dl class="divide-y divide-bg-border">
    {
      stackRows.map((row) => (
        <div class="flex flex-col gap-1 px-6 py-3 sm:flex-row sm:items-baseline sm:gap-6">
          <dt class="w-36 shrink-0 font-mono text-xs uppercase tracking-wider text-text-faint">
            {pick(row.label, lang)}
          </dt>
          <dd class="text-sm text-text">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<!-- Bloques tecnicos -->
<div class="space-y-8">
  {
    techSections.map((section) => (
      <section class="reveal rounded-xl border border-bg-border bg-bg-card p-6 sm:p-8">
        <div class="mb-5 flex items-start gap-4">
          <div
            class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border ${tones[section.tone]}`}
          >
            <Icon name={section.icon} class="h-5 w-5" />
          </div>
          <div class="min-w-0">
            <p class="font-mono text-xs uppercase tracking-wider text-text-faint">
              {section.num} / {pick(section.title, lang)}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-text-muted">
              {pick(section.intro, lang)}
            </p>
          </div>
        </div>

        <ul class="space-y-4 border-t border-bg-border pt-5">
          {section.items.map((item) => (
            <li>
              <p class="text-sm font-semibold text-text">{pick(item.term, lang)}</p>
              <p class="mt-1 text-sm leading-relaxed text-text-muted">{pick(item.detail, lang)}</p>
              {item.source && (
                <p class="mt-1.5">
                  <code class="rounded-sm bg-bg-soft px-1.5 py-0.5 font-mono text-[11px] text-text-faint">
                    {item.source}
                  </code>
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<p class="reveal mt-6 text-center text-xs leading-relaxed text-text-faint">
  {labels.sourceNote}
</p>

<!-- Rendimiento -->
<div class="reveal mt-16 rounded-xl border border-bg-border bg-bg-card p-8">
  <h2
    class="mb-6 text-center font-mono text-sm font-semibold uppercase tracking-wider text-text"
  >
    {labels.metricsTitle}
  </h2>

  <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
    {
      labels.metrics.map((name) => (
        <div class="flex flex-col items-center">
          <div class="flex h-20 w-20 items-center justify-center rounded-full border-4 border-accent font-mono text-xl font-bold text-accent shadow-[0_0_15px_rgba(74,222,128,0.2)]">
            100
          </div>
          <span class="mt-2 text-xs font-medium text-text">{name}</span>
        </div>
      ))
    }
  </div>

  <p class="mt-6 text-center text-[11px] leading-relaxed text-text-faint">
    {labels.metricsNote}
  </p>
</div>

<!-- Acciones -->
<div class="reveal mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
  <a
    href={SITE.githubRepo}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-primary flex w-full items-center justify-center gap-2 text-xs font-semibold sm:w-auto"
  >
    <Icon name="github" class="h-4 w-4" />
    {labels.ctaCode}
  </a>
  <a
    href={contactHref}
    class="btn-ghost flex w-full items-center justify-center gap-2 text-xs font-semibold sm:w-auto"
  >
    <Icon name="mail" class="h-4 w-4" />
    {labels.ctaContact}
  </a>
</div>
