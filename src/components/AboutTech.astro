---
/**
 * <AboutTech /> - Cuerpo de la pagina "Sobre esta web".
 *
 * El contenido vive en src/data/about-tech.ts y se recorre desde aqui, asi que
 * las versiones en espanol, ingles y catalan comparten estructura y no pueden
 * descompasarse. Cada pagina solo aporta sus textos de cabecera.
 */
import { techSections, stackRows, pagespeedScores } from '../data/about-tech';
import { pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  /** Etiquetas de la pagina que no salen del archivo de datos. */
  labels: {
    stackTitle: string;
    sourceNote: string;
    metricsTitle: string;
    metricsNote: string;
    metrics: string[];
    ctaCode: string;
    ctaContact: string;
  };
  contactHref: string;
}
const { lang, labels, contactHref } = Astro.props;
---

<!-- Resumen del stack -->
<section class="reveal about-block">
  <h2 class="about-h2">{labels.stackTitle}</h2>
  <dl class="spec-list">
    {
      stackRows.map((row) => (
        <div class="spec-row">
          <dt class="spec-term spec-term--meta">{pick(row.label, lang)}</dt>
          <dd class="spec-desc">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Bloques tecnicos: cada control con el motivo y el archivo que lo prueba -->
{
  techSections.map((section) => (
    <section class="reveal about-block">
      <h2 class="about-h2">{pick(section.title, lang)}</h2>
      <p class="about-intro">{pick(section.intro, lang)}</p>
      <dl class="spec-list">
        {section.items.map((item) => (
          <div class="spec-row">
            <dt class="spec-term">{pick(item.term, lang)}</dt>
            <dd class="spec-desc">
              {pick(item.detail, lang)}
              {item.source && (
                <code class="spec-source">{item.source}</code>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))
}

<p class="reveal about-note">{labels.sourceNote}</p>

<!-- Rendimiento: foto de un momento, datos de about-tech.ts -->
<section class="reveal about-block">
  <h2 class="about-h2">{labels.metricsTitle}</h2>
  <dl class="spec-list">
    {
      labels.metrics.map((name, i) => (
        <div class="spec-row">
          <dt class="spec-term">{name}</dt>
          <dd class="spec-desc"><span class="spec-score">{pagespeedScores.values[i]}</span> / 100</dd>
        </div>
      ))
    }
  </dl>
  <p class="about-note">{labels.metricsNote}</p>
</section>

<!-- Acciones -->
<div class="reveal about-actions">
  <a href={SITE.githubRepo} target="_blank" rel="noopener noreferrer" class="btn-primary about-btn">
    <Icon name="github" class="h-4 w-4" />
    {labels.ctaCode}
  </a>
  <a href={contactHref} class="btn-ghost about-btn">
    <Icon name="mail" class="h-4 w-4" />
    {labels.ctaContact}
  </a>
</div>
