---
/**
 * <AppPage /> - Plantilla compartida para /apps/<id>/ y /en/apps/<id>/.
 *
 * Recibe un AppData completo (src/data/apps.ts) y el idioma, y renderiza:
 * hero (nombre, tagline, badges, CTA a tienda o badge de estado, con la
 * captura/mockup principal integrada), como funciona (3 pasos), features
 * con icono, privacidad/seguridad, capturas adicionales si las hay, y FAQ.
 *
 * El SoftwareApplication JSON-LD se pasa a Seo/BaseLayout desde la propia
 * pagina .astro (necesita `path`/`alternates`, que son distintos por
 * idioma), no desde aqui.
 */
import type { AppData } from '../data/apps';
import type { Lang } from '../i18n/ui';
import { pick } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  app: AppData;
  lang: Lang;
  /** Ruta absoluta de vuelta al indice de proyectos, ya localizada. */
  backHref: string;
  backLabel: string;
}

const { app, lang, backHref, backLabel } = Astro.props;

const t = {
  es: {
    permissions: 'Permisos y por qué se piden',
    privacy: 'Privacidad y seguridad',
    features: 'Qué incluye',
    howItWorks: 'Cómo funciona',
    faq: 'Preguntas frecuentes',
    screenshots: 'Más capturas',
    mockupBefore: 'Antes',
    mockupAfter: 'Después',
    chrome: 'Chrome Web Store',
    firefox: 'Firefox Add-ons',
    notPublished: 'Aún no publicada en tienda',
    statusOss: 'Open Source',
    statusWip: 'En desarrollo',
    statusClosed: 'Código privado',
    platformChrome: 'Chrome / Chromium',
    platformFirefox: 'Firefox',
  },
  en: {
    permissions: 'Permissions and why they are requested',
    privacy: 'Privacy and security',
    features: 'What it includes',
    howItWorks: 'How it works',
    faq: 'Frequently asked questions',
    screenshots: 'More screenshots',
    mockupBefore: 'Before',
    mockupAfter: 'After',
    chrome: 'Chrome Web Store',
    firefox: 'Firefox Add-ons',
    notPublished: 'Not yet published to a store',
    statusOss: 'Open Source',
    statusWip: 'In development',
    statusClosed: 'Private code',
    platformChrome: 'Chrome / Chromium',
    platformFirefox: 'Firefox',
  },
}[lang === 'ca' ? 'es' : lang];

const statusLabel = { oss: t.statusOss, wip: t.statusWip, closed: t.statusClosed }[app.status];
const statusClass = {
  oss: 'bg-oss/10 text-oss border-oss/25',
  wip: 'bg-warn/10 text-warn border-warn/25',
  closed: 'bg-closed/10 text-closed border-closed/25',
}[app.status];

const hasStoreLink = Boolean(app.links.chromeWebStore || app.links.firefoxAddons);

const mockups: Record<string, { before: string; after: string }> = {
  nowait: { before: 'linkvertise.com/1234/abc?r=…', after: 'destino-final.com/pagina-real' },
  'password-centinel': { before: 'contraseña123', after: 'xK9#mQ2$vL7pR4wZ — TOTP: 482 913' },
  'prompt-master': {
    before: '"escríbeme un email de ventas"',
    after: 'Actúa como copywriter B2B con 10 años de experiencia. Escribe un email de ventas para…',
  },
};
const mockup = mockups[app.id];
const heroScreenshot = app.screenshots[0];
const moreScreenshots = app.screenshots.slice(1);
---

<section class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page">
    <a
      href={backHref}
      class="group mb-10 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span> {backLabel}
    </a>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-center lg:gap-16">
      <div class="reveal min-w-0">
        <div class="mb-5 flex items-center gap-4">
          <img
            src={app.iconPath}
            alt={`Icono de ${app.name}`}
            width="56"
            height="56"
            class="h-14 w-14 shrink-0 rounded-xl border border-bg-border bg-bg-card object-contain p-2.5"
          />
          <div class="flex flex-wrap items-center gap-2">
            <span
              class={`inline-flex items-center rounded-sm border px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider ${statusClass}`}
            >
              {statusLabel}
            </span>
            <span class="badge">{t.platformChrome}</span>
            <span class="badge">{t.platformFirefox}</span>
          </div>
        </div>

        <h1 class="mb-4 text-4xl font-bold tracking-tight text-text sm:text-5xl">{app.name}</h1>
        <p class="mb-8 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg">
          {pick(app.tagline, lang)}
        </p>

        <div class="flex flex-wrap gap-3">
          {
            app.links.chromeWebStore && (
              <a href={app.links.chromeWebStore} class="btn-primary" target="_blank" rel="noopener noreferrer">
                <Icon name="store" class="h-4 w-4" /> {t.chrome}
              </a>
            )
          }
          {
            app.links.firefoxAddons && (
              <a href={app.links.firefoxAddons} class="btn-ghost" target="_blank" rel="noopener noreferrer">
                <Icon name="external" class="h-4 w-4" /> {t.firefox}
              </a>
            )
          }
          {
            !hasStoreLink && (
              <span class={`inline-flex items-center gap-2 rounded-sm border px-3 py-2 font-mono text-xs ${statusClass}`}>
                <Icon name="shield" class="h-4 w-4" /> {t.notPublished}
              </span>
            )
          }
        </div>
      </div>

      <div class="reveal">
        {
          heroScreenshot ? (
            <img
              src={heroScreenshot}
              alt={`Captura de ${app.name}`}
              loading="eager"
              class="w-full rounded-xl border border-bg-border object-cover shadow-2xl"
            />
          ) : (
            <div class="rounded-xl border border-bg-border bg-bg-card p-6 shadow-2xl">
              <div class="mb-4 flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-danger/70" />
                <span class="h-2.5 w-2.5 rounded-full bg-warn/70" />
                <span class="h-2.5 w-2.5 rounded-full bg-accent/70" />
              </div>
              <p class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-text-faint">
                {t.mockupBefore}
              </p>
              <p class="mb-4 rounded-md border border-bg-border bg-bg px-4 py-3 font-mono text-xs text-text-muted">
                {mockup.before}
              </p>
              <p class="mb-4 text-center font-mono text-accent">&darr;</p>
              <p class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-accent">
                {t.mockupAfter}
              </p>
              <p class="rounded-md border border-accent/30 bg-accent-soft/20 px-4 py-3 font-mono text-xs text-text">
                {mockup.after}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
  <div class="container-page max-w-4xl">
    <div class="reveal mb-12">
      <p class="section-kicker">{app.name}</p>
      <h2 class="section-title">{t.howItWorks}</h2>
      <p class="section-subtitle">{pick(app.description, lang)}</p>
    </div>

    <ol class="reveal grid gap-8 sm:grid-cols-3">
      {
        app.howItWorks.map((step, i) => (
          <li class="relative">
            <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-full border border-accent/30 bg-accent/10 font-mono text-sm font-semibold text-accent">
              {i + 1}
            </span>
            <h3 class="mb-2 text-base font-semibold text-text">{pick(step.title, lang)}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{pick(step.description, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page max-w-4xl">
    <div class="reveal mb-12">
      <p class="section-kicker">{app.name}</p>
      <h2 class="section-title">{t.features}</h2>
    </div>

    <ul class="reveal grid gap-5 sm:grid-cols-2">
      {
        app.features.map((f) => (
          <li class="card flex gap-4 p-6">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-bg-border bg-bg text-accent">
              <Icon name={f.icon} class="h-4 w-4" />
            </span>
            <div class="min-w-0">
              <h3 class="mb-1.5 text-base font-semibold text-text">{pick(f.title, lang)}</h3>
              <p class="text-sm leading-relaxed text-text-muted">{pick(f.description, lang)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  moreScreenshots.length > 0 && (
    <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
      <div class="container-page max-w-4xl">
        <div class="reveal mb-10">
          <p class="section-kicker">{t.screenshots}</p>
          <h2 class="section-title">{app.name}</h2>
        </div>
        <div class="reveal grid gap-5 sm:grid-cols-3">
          {moreScreenshots.map((src) => (
            <img
              src={src}
              alt={`Captura de ${app.name}`}
              loading="lazy"
              class="w-full rounded-lg border border-bg-border object-cover"
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<section class:list={["border-b border-bg-border py-20 sm:py-28", { "bg-bg-soft": moreScreenshots.length === 0 }]}>
  <div class="container-page max-w-4xl">
    <div class="reveal mb-10">
      <p class="section-kicker">{t.privacy}</p>
      <h2 class="section-title">{t.privacy}</h2>
      <p class="section-subtitle">{pick(app.privacy.intro, lang)}</p>
    </div>

    <ul class="reveal mb-12 grid gap-3 sm:grid-cols-2">
      {
        app.privacy.points.map((p) => (
          <li class="flex gap-3 rounded-lg border border-bg-border bg-bg-card p-4">
            <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
            <p class="text-sm leading-relaxed text-text-muted">{pick(p, lang)}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.2em] text-text-faint">
      {t.permissions}
    </h3>
    <div class="reveal overflow-x-auto rounded-lg border border-bg-border">
      <table class="w-full border-collapse text-left text-sm">
        <tbody>
          {
            app.permissions.map((perm) => (
              <tr class="border-b border-bg-border last:border-0">
                <td class="w-1/3 whitespace-nowrap bg-bg-card px-4 py-3 font-mono text-xs text-accent">
                  {perm.name}
                </td>
                <td class="px-4 py-3 text-text-muted">{pick(perm.reason, lang)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="py-20 sm:py-28">
  <div class="container-page max-w-4xl">
    <div class="reveal mb-10">
      <p class="section-kicker">FAQ</p>
      <h2 class="section-title">{t.faq}</h2>
    </div>
    <div class="reveal flex flex-col divide-y divide-bg-border rounded-lg border border-bg-border">
      {
        app.faq.map((item) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-text">
              {pick(item.question, lang)}
              <span class="shrink-0 font-mono text-accent group-open:hidden">+</span>
              <span class="hidden shrink-0 font-mono text-accent group-open:inline">&minus;</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{pick(item.answer, lang)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
