---
/**
 * <BlogPostBody /> - Maquetacion del detalle de un articulo, compartida por
 * los 3 idiomas (/blog/post/[slug], /en/blog/post/[slug], /ca/blog/post/[slug]).
 *
 * Antes cada idioma tenia su propio molde HTML casi identico (ver el
 * historial de src/scripts/blog.ts: exactamente ese problema, "seis copias
 * del mismo JavaScript", es lo que motivo centralizar blog.ts). Un solo
 * componente evita repetir el mismo error en la version server-rendered.
 *
 * El cuerpo del articulo SI se inyecta como HTML a proposito: se redacta
 * desde /admin, una zona autenticada, igual que en el render de cliente que
 * sustituye. La CSP del sitio (script-src 'self' con hashes, sin
 * 'unsafe-inline') impide que un <script> o un onclick= colado ahi llegue a
 * ejecutarse.
 */
import { formatDate } from '../scripts/blog';
import { safeUrl } from '../scripts/shared';
import { fetchAllPostSummaries, type PostDetail } from '../lib/posts';
import { relatedPosts } from '../lib/related';
import { blogPostPath } from '../data/soc-profile';
import { authorByline, socAlternates } from '../data/soc-profile';
import type { Lang } from '../i18n/ui';

interface Props {
  post: PostDetail;
  lang: string;
  backHref: string;
  backLabel: string;
}

const { post, lang, backHref, backLabel } = Astro.props;
const byline = authorByline[(lang as Lang) in authorByline ? (lang as Lang) : 'es'];
const socHref = socAlternates[(lang as Lang) in socAlternates ? (lang as Lang) : 'es'];
const L: Lang = (lang as Lang) in authorByline ? (lang as Lang) : 'es';
const related = relatedPosts(post, await fetchAllPostSummaries(L));
const moreTitle = { es: 'Sigue leyendo', en: 'Keep reading', ca: 'Continua llegint' }[L];
// Solo portada propia: la generada repite el titulo que ya se ve en el <h1>.
const cover = safeUrl(post.cover_url);

// Indice (TOC) solo con >= 3 secciones, sin JS: se anaden ids a los <h2> sin
// atributos del cuerpo (el texto no cambia) y se enlaza a ellos con anclas.
const tocTitle = { es: 'Contenido', en: 'Contents', ca: 'Continguts' }[L];
const decode = (v: string) =>
  v.replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").trim();
const toc: { id: string; text: string }[] = [];
const bodyHtml = (post.content || '').replace(/<h2>(.*?)<\/h2>/gs, (_m, inner: string) => {
  const id = `seccion-${toc.length + 1}`;
  toc.push({ id, text: decode(inner) });
  return `<h2 id="${id}">${inner}</h2>`;
});
const showToc = toc.length >= 3;
---

<article class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
  <div class="container-page">
    <a
      href={backHref}
      class="group mb-8 inline-flex min-h-11 items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span> {backLabel}
    </a>

    <header class="mb-8">
      <div class="post-head-meta mb-3">
        <time
          class="font-mono text-xs text-text-muted"
          datetime={post.published_at.replace(' ', 'T').slice(0, 10)}
        >
          {formatDate(post.published_at, lang, true)}
        </time>
        {
          post.read_minutes ? (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.read_minutes} min</span>
            </>
          ) : null
        }
        {
          post.category ? (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.category}</span>
            </>
          ) : null
        }
        <span
          class="rounded-sm border border-bg-border px-1.5 py-0.5 font-mono text-xs uppercase text-text-muted"
        >
          {lang}
        </span>
      </div>
      <h1 class="mb-4 text-3xl font-bold leading-tight text-text-title sm:text-4xl">
        {post.title}
      </h1>
      <p class="post-lead">
        {post.summary}
      </p>
      <p class="mt-4 text-sm text-text-muted">
        {byline.before}<a href={socHref} class="text-accent hover:underline">{byline.link}</a>{byline.after}
      </p>
      {
        post.tags?.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {post.tags.map((tag) => (
              <li class="rounded-sm border border-bg-border px-1.5 py-0.5 font-mono text-xs text-text-muted">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <div class="mb-10">
          <img
            src={cover}
            alt={post.title}
            width="1200"
            height="630"
            class="aspect-[1200/630] max-h-[400px] w-full rounded-xl border border-bg-border object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    {
      showToc && (
        <nav class="post-toc" aria-label={tocTitle}>
          <p class="mb-1 font-bold text-text-title">{tocTitle}</p>
          <ol>
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose text-text" set:html={bodyHtml} />

    {
      related.length > 0 && (
        <aside class="post-related mt-12 border-t border-bg-border pt-8">
          <h2 class="mb-4 text-xl font-bold text-text-title">{moreTitle}</h2>
          <ul class="list-disc space-y-1 pl-5">
            {related.map((r) => (
              <li>
                <a href={blogPostPath(L, r.slug)}>{r.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</article>
