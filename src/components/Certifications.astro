---
/**
 * <Certifications /> - Isla dinamica (MySQL via PHP). Contador animado + grid.
 *
 * La vista "Todas" NO lista las certificaciones una a una: son demasiadas y
 * saturaban la seccion. Muestra una tarjeta por emisor con su nombre y cuantas
 * credenciales tiene ("Trend Micro · 10"); al pulsarla se entra al detalle de
 * ese emisor. Los filtros por tema (Ciberseguridad, IA & Cloud...) siguen
 * mostrando las certificaciones sueltas, porque ahi el conjunto ya es pequeno.
 *
 * Script PROCESADO (externo, CSP-safe). safeUrl() sanea las URLs de la BD (S3).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';
import { getImage } from 'astro:assets';
import { buildLogoMap, fetchCertificationSummaries } from '../lib/certifications';
import StatusPanel from './StatusPanel.astro';
import CertRow from './CertRow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/certifications.php?lang=${lang}`);

// Primer pintado en build-time (ver src/lib/certifications.ts). Lista plana,
// sin agrupar por emisor: initCerts() la sustituye por la vista agrupada en
// cuanto carga (ver #certs-grid mas abajo) -- esto solo evita que un
// rastreador sin JS vea el contenedor vacio.
const ssrCerts = await fetchCertificationSummaries(lang);
// Logos a 128 px (2x de la caja de 64 px) en WebP; image.domains en
// astro.config.mjs autoriza a images.credly.com.
const LOGO_WIDTH = 128;
const logoMap = await buildLogoMap(ssrCerts, async (src) => {
  const img = await getImage({ src, inferSize: true, width: LOGO_WIDTH, format: 'webp' });
  return img.src;
});

// Destacadas visibles (= DEFAULT_LIMIT de scripts/certifications.ts); el resto va
// en <details> pero SIEMPRE en el HTML estatico (SEO).
const FEATURED = 8;

const pick = <T,>(es: T, ca: T, en: T): T => (lang === 'es' ? es : lang === 'ca' ? ca : en);

const labels = {
  loading: t('certs.loading'),
  error: t('certs.error'),
  empty: t('certs.empty'),
  countLabel: t('certs.count.label'),
  verify: t('certs.verify'),
};
---

<section id="certificaciones" class="border-b border-bg-border py-14 sm:py-16">
  <div class="container-page">
    <div class="reveal mb-8">
      <h2 class="section-title">{t('certs.title')}</h2>
      <p class="section-subtitle">{t('certs.subtitle')}</p>
      <p class="mt-3 text-sm text-text-muted">
        <span id="certs-counter" class="font-mono font-semibold tabular-nums text-text" data-target="0">{ssrCerts.length}</span>
        {labels.countLabel}
      </p>
    </div>

    <StatusPanel
      id="certs-status"
      class="mb-6 hidden"
      loadingText={t('certs.loading')}
      retryText={t('status.retry')}
    />

    {!ssrCerts.length && (
      <noscript><p class="status-panel mb-6 border-dashed">{t('certs.empty')}</p></noscript>
    )}

    <!-- Buscador y filtros -->
    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="relative w-full lg:max-w-xs">
        <span
          class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-text-muted"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <input
          type="search"
          id="certs-search"
          aria-label={pick('Buscar certificación', 'Cercar certificació', 'Search certification')}
          class="min-h-11 w-full rounded-md border border-control-border bg-bg-card py-2 pl-9 pr-3 text-sm text-text placeholder-text-muted transition-colors"
          placeholder={pick(
            'Buscar certificación o emisor...',
            'Cercar certificació o emissor...',
            'Search certification or issuer...'
          )}
        />
      </div>

      {/* Scroll horizontal en movil: seis filtros no caben y apilarlos comia
          media pantalla. En pantallas grandes vuelven a fluir en varias lineas. */}
      <div
        id="certs-filter-container"
        role="group"
        aria-label={pick('Filtrar por categoría', 'Filtrar per categoria', 'Filter by category')}
        class="-mx-5 flex snap-x gap-1.5 overflow-x-auto px-5 pb-1 sm:-mx-6 sm:px-6 lg:mx-0 lg:flex-wrap lg:justify-end lg:overflow-visible lg:px-0"
      >
        <button type="button" data-filter="all" class="cert-filter-btn is-active" aria-pressed="true">
          {pick('Todas', 'Totes', 'All')}
        </button>
        <button type="button" data-filter="cyber" class="cert-filter-btn">
          {pick('Ciberseguridad', 'Ciberseguretat', 'Cybersecurity')}
        </button>
        <button type="button" data-filter="ai-cloud" class="cert-filter-btn">IA &amp; Cloud</button>
        <button type="button" data-filter="cisco" class="cert-filter-btn">Cisco</button>
        <button type="button" data-filter="tryhackme" class="cert-filter-btn">TryHackMe</button>
        <button type="button" data-filter="sys-dev" class="cert-filter-btn">
          {pick('Sistemas & Dev', 'Sistemes & Dev', 'Systems & Dev')}
        </button>
      </div>
    </div>

    <!-- Lista densa: los destacados (orden de la API) arriba, el resto plegado. -->
    <div class="certs-body">
      <div
        id="certs-grid"
        class="border-t border-bg-border bg-bg-card"
        data-api={apiUrl}
        data-labels={JSON.stringify(labels)}
        data-logos={JSON.stringify(logoMap)}
      >
        {ssrCerts.slice(0, FEATURED).map((c) => <CertRow cert={c} logoMap={logoMap} />)}
        {
          ssrCerts.length > FEATURED && (
            <details class="certs-more">
              <summary class="certs-more-summary">
                {pick('Ver todas', 'Veure-les totes', 'Show all')} ({ssrCerts.length})
              </summary>
              {ssrCerts.slice(FEATURED).map((c) => <CertRow cert={c} logoMap={logoMap} />)}
            </details>
          )
        }
      </div>
    </div>

    <div id="certs-load-more-container" class="mt-6 hidden justify-center">
      <button id="certs-load-more-btn" type="button" class="btn-ghost min-h-11 cursor-pointer">
        <span>{pick('Ver todas', 'Veure-les totes', 'Show all')}</span>
      </button>
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href="https://www.credly.com/users/eduolihez"
        target="_blank"
        rel="noopener noreferrer"
        class="project-link"
      >
        {t('certs.credly')}
      </a>
    </div>
  </div>
</section>

<script>
  import { initCerts } from '../scripts/certifications';
  initCerts();
  document.addEventListener('astro:page-load', initCerts);
</script>
