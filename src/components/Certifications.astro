---
/**
 * <Certifications /> - Isla dinamica (MySQL via PHP). Contador animado + grid.
 *
 * La vista "Todas" NO lista las certificaciones una a una: son demasiadas y
 * saturaban la seccion. Muestra una tarjeta por emisor con su nombre y cuantas
 * credenciales tiene ("Trend Micro · 10"); al pulsarla se entra al detalle de
 * ese emisor. Los filtros por tema (Ciberseguridad, IA & Cloud...) siguen
 * mostrando las certificaciones sueltas, porque ahi el conjunto ya es pequeno.
 *
 * Script PROCESADO (externo, CSP-safe). safeUrl() sanea las URLs de la BD (S3).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/certifications.php?lang=${lang}`);

const pick = <T,>(es: T, ca: T, en: T): T => (lang === 'es' ? es : lang === 'ca' ? ca : en);

const labels = {
  loading: t('certs.loading'),
  error: t('certs.error'),
  empty: t('certs.empty'),
  countLabel: t('certs.count.label'),
  showMore: pick('Mostrar {count} más', 'Mostra {count} més', 'Show {count} more'),
  // Texto de la tarjeta de emisor: "10 credenciales"
  credentials: pick('credenciales', 'credencials', 'credentials'),
  credential: pick('credencial', 'credencial', 'credential'),
  back: pick('Todas', 'Totes', 'All'),
  // Se anuncia a los lectores de pantalla al pulsar una tarjeta de emisor.
  viewIssuer: pick('Ver certificaciones de', 'Veure certificacions de', 'View certifications from'),
};
---

<section id="certificaciones" class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page">
    <div class="reveal mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="section-kicker">{t('kicker.certs')}</p>
        <h2 class="section-title">{t('certs.title')}</h2>
        <p class="section-subtitle">{t('certs.subtitle')}</p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <Icon name="award" class="h-8 w-8 text-accent" />
        <div>
          <div
            id="certs-counter"
            class="font-mono text-3xl font-bold leading-none text-accent"
            data-target="0"
          >
            0
          </div>
          <div class="mt-1 text-xs text-text-muted">{labels.countLabel}</div>
        </div>
      </div>
    </div>

    <div id="certs-status" class="mb-6 flex flex-wrap items-center gap-3 text-sm text-text-muted">
      <span
        id="certs-spinner"
        class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
      ></span>
      <span id="certs-status-text">{t('certs.loading')}</span>
      <button
        id="certs-retry-btn"
        class="hidden cursor-pointer rounded-md border border-accent/20 bg-accent/5 px-2.5 py-1 text-xs font-semibold text-accent transition duration-150 hover:bg-accent hover:text-bg"
        type="button"
      >
        {pick('Volver a intentar', 'Tornar-ho a provar', 'Try again')}
      </button>
    </div>

    <!-- Buscador y filtros -->
    <div class="reveal mb-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="relative w-full lg:max-w-xs">
        <span
          class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-text-muted"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
        <input
          type="search"
          id="certs-search"
          aria-label={pick('Buscar certificación', 'Cercar certificació', 'Search certification')}
          class="w-full rounded-lg border border-bg-border bg-bg-card py-2 pl-9 pr-3 text-sm text-text placeholder-text-muted/60 transition focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
          placeholder={pick(
            'Buscar certificación o emisor...',
            'Cercar certificació o emissor...',
            'Search certification or issuer...'
          )}
        />
      </div>

      {/* Scroll horizontal en movil: seis filtros no caben y apilarlos comia
          media pantalla. En pantallas grandes vuelven a fluir en varias lineas. */}
      <div
        id="certs-filter-container"
        role="group"
        aria-label={pick('Filtrar por categoría', 'Filtrar per categoria', 'Filter by category')}
        class="-mx-4 flex snap-x gap-1.5 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-wrap lg:justify-end lg:overflow-visible lg:px-0"
      >
        <button type="button" data-filter="all" class="cert-filter-btn is-active">
          {pick('Todas', 'Totes', 'All')}
        </button>
        <button type="button" data-filter="cyber" class="cert-filter-btn">
          {pick('Ciberseguridad', 'Ciberseguretat', 'Cybersecurity')}
        </button>
        <button type="button" data-filter="ai-cloud" class="cert-filter-btn">IA &amp; Cloud</button>
        <button type="button" data-filter="cisco" class="cert-filter-btn">Cisco</button>
        <button type="button" data-filter="tryhackme" class="cert-filter-btn">TryHackMe</button>
        <button type="button" data-filter="sys-dev" class="cert-filter-btn">
          {pick('Sistemas & Dev', 'Sistemes & Dev', 'Systems & Dev')}
        </button>
      </div>
    </div>

    <!-- Migas: solo aparecen al entrar en un emisor concreto -->
    <div id="certs-breadcrumb" class="reveal mb-5 hidden items-center gap-2 text-sm">
      <button
        id="certs-back-btn"
        type="button"
        class="inline-flex cursor-pointer items-center gap-1.5 rounded-md px-2 py-1 font-medium text-text-muted transition hover:bg-bg-soft hover:text-accent"
      >
        <span aria-hidden="true">&larr;</span>
        <span>{labels.back}</span>
      </button>
      <span class="text-text-faint" aria-hidden="true">/</span>
      <span id="certs-breadcrumb-current" class="truncate font-semibold text-text"></span>
    </div>

    <div
      id="certs-grid"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
      data-api={apiUrl}
      data-labels={JSON.stringify(labels)}
    >
    </div>

    <div id="certs-load-more-container" class="reveal mt-6 hidden justify-center">
      <button
        id="certs-load-more-btn"
        type="button"
        class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-bg-border bg-bg-soft/40 px-4 py-2 text-xs font-semibold text-text-muted shadow-sm transition duration-200 hover:border-accent hover:bg-bg-card hover:text-accent"
      >
        <span>{pick('Ver más', 'Veure més', 'Show more')}</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>

    <div class="reveal mt-10 flex justify-center">
      <a
        href="https://www.credly.com/users/eduolihez"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        <Icon name="award" class="h-4 w-4" />
        {t('certs.credly')}
      </a>
    </div>
  </div>
</section>

<style>
  /* Los botones de filtro se estilan aqui y no con clases sueltas repetidas
     seis veces en el marcado. Ademas el JS solo tiene que alternar .is-active
     en vez de reescribir el className entero, que era lo que hacia antes y
     borraba de paso los atributos de accesibilidad. */
  .cert-filter-btn {
    flex-shrink: 0;
    scroll-snap-align: start;
    border-radius: 0.5rem;
    border: 1px solid theme('colors.bg.border');
    background-color: theme('colors.bg.card');
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: theme('colors.text.muted');
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
    /* 40px de alto minimo: objetivo tactil comodo en movil. */
    min-height: 2.5rem;
  }
  .cert-filter-btn:hover {
    color: theme('colors.text.DEFAULT');
    border-color: theme('colors.text.faint');
  }
  .cert-filter-btn.is-active {
    border-color: theme('colors.accent.DEFAULT');
    background-color: rgb(74 222 128 / 0.1);
    color: theme('colors.accent.DEFAULT');
  }
  /* Oculta la barra de scroll de los filtros sin impedir el desplazamiento. */
  #certs-filter-container {
    scrollbar-width: none;
  }
  #certs-filter-container::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initCerts() {
    const grid = document.getElementById('certs-grid');
    const status = document.getElementById('certs-status');
    const statusText = document.getElementById('certs-status-text');
    const spinner = document.getElementById('certs-spinner');
    const retryBtn = document.getElementById('certs-retry-btn');
    const counter = document.getElementById('certs-counter');
    const searchInput = document.getElementById('certs-search');
    const filterButtons = document.querySelectorAll('.cert-filter-btn');
    const breadcrumb = document.getElementById('certs-breadcrumb');
    const breadcrumbCurrent = document.getElementById('certs-breadcrumb-current');
    const backBtn = document.getElementById('certs-back-btn');
    const loadMoreContainer = document.getElementById('certs-load-more-container');
    const loadMoreBtn = document.getElementById('certs-load-more-btn');
    if (!grid || grid.dataset.loaded) return;

    const apiUrl = grid.dataset.api || '';
    const labels = JSON.parse(grid.dataset.labels || '{}');

    let allCerts = [];
    let activeFilter = 'all';
    let activeIssuer = null; // emisor abierto desde la vista "Todas"
    let searchQuery = '';
    let animationFrameId = null;
    let hasAnimatedOnce = false;
    let limit = 12; // multiplo de 2 y 3: no parte la ultima fila del grid

    function safeUrl(url) {
      if (typeof url !== 'string') return '';
      const u = url.trim();
      if (/^(https?:\/\/|mailto:|\/)/i.test(u)) return u;
      return '';
    }

    /**
     * Color estable por emisor. Antes el hueco del logo mostraba la primera
     * LETRA del emisor, que quedaba pobre y no distinguia nada. Ahora se usa
     * siempre el mismo sello de credencial, y lo que cambia es el color: son
     * reconocibles de un vistazo sin inventar logotipos de marcas ajenas.
     * Va en estilo en linea a proposito: una clase compuesta en tiempo de
     * ejecucion no la veria Tailwind al compilar y se perderia.
     */
    const PALETTE = ['#4ade80', '#22d3ee', '#a78bfa', '#f59e0b', '#f472b6', '#60a5fa', '#34d399'];
    function issuerColor(name) {
      let h = 0;
      for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
      return PALETTE[h % PALETTE.length];
    }

    /** Sello de credencial en SVG (mismo icono que el contador de la seccion). */
    function sealIcon(color, size) {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('class', size);
      svg.setAttribute('aria-hidden', 'true');
      svg.style.color = color;
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('fill', 'currentColor');
      p.setAttribute(
        'd',
        'M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V22l-4-2-4 2v-7.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7m0 2a5 5 0 0 0-5 5 5 5 0 0 0 5 5 5 5 0 0 0 5-5 5 5 0 0 0-5-5Z'
      );
      svg.appendChild(p);
      return svg;
    }

    /** Recuadro del logo: imagen real si la hay, si no el sello coloreado. */
    function logoBox(logoUrl, altText, color) {
      const box = document.createElement('div');
      box.className =
        'flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-md border border-bg-border';
      const logo = safeUrl(logoUrl);
      if (logo) {
        box.classList.add('bg-bg-soft');
        const img = document.createElement('img');
        img.src = logo;
        img.alt = altText || '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.className = 'h-full w-full object-contain p-1.5';
        box.appendChild(img);
      } else {
        // Fondo tenue del mismo color, para que el sello no flote suelto.
        box.style.backgroundColor = color + '1a'; // ~10% de opacidad
        box.style.borderColor = color + '33';
        box.appendChild(sealIcon(color, 'h-5 w-5'));
      }
      return box;
    }

    function animateCounter(target) {
      if (!counter) return;
      if (animationFrameId) cancelAnimationFrame(animationFrameId);

      const run = () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          counter.textContent = String(target);
          return;
        }
        const dur = 800;
        const start = performance.now();
        const startVal = parseInt(counter.textContent) || 0;
        const diff = target - startVal;
        function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          counter.textContent = String(Math.round(startVal + eased * diff));
          animationFrameId = p < 1 ? requestAnimationFrame(tick) : null;
        }
        animationFrameId = requestAnimationFrame(tick);
      };

      if (!hasAnimatedOnce && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                hasAnimatedOnce = true;
                run();
                obs.disconnect();
              }
            });
          },
          { threshold: 0.4 }
        );
        obs.observe(counter);
      } else {
        run();
      }
    }

    /** Aplica busqueda + filtro de categoria + emisor abierto. */
    function getFiltered() {
      return allCerts.filter((c) => {
        if (searchQuery) {
          const term = searchQuery.toLowerCase();
          const hay = [c.name, c.issuer, c.category].map((v) => (v || '').toLowerCase());
          if (!hay.some((v) => v.includes(term))) return false;
        }

        if (activeIssuer) {
          return (c.issuer || 'Otros').trim() === activeIssuer;
        }

        if (activeFilter === 'all') return true;

        const cat = (c.category || '').toLowerCase();
        const issuer = (c.issuer || '').toLowerCase();
        if (activeFilter === 'cyber') {
          return (
            cat.includes('security') || cat.includes('secops') || cat.includes('intel') ||
            cat.includes('cyber') || issuer.includes('tryhackme')
          );
        }
        if (activeFilter === 'ai-cloud') return cat.includes('ai') || cat.includes('cloud');
        if (activeFilter === 'cisco') return issuer.includes('cisco');
        if (activeFilter === 'tryhackme') return issuer.includes('tryhackme');
        if (activeFilter === 'sys-dev') {
          return (
            cat.includes('sistemas') || cat.includes('desarrollo') ||
            cat.includes('system') || cat.includes('dev')
          );
        }
        return false;
      });
    }

    function render() {
      grid.innerHTML = '';
      const filtered = getFiltered();
      animateCounter(filtered.length);

      // Migas visibles solo dentro de un emisor.
      if (breadcrumb) {
        breadcrumb.classList.toggle('hidden', !activeIssuer);
        breadcrumb.classList.toggle('flex', !!activeIssuer);
        if (activeIssuer && breadcrumbCurrent) breadcrumbCurrent.textContent = activeIssuer;
      }

      if (!filtered.length) {
        hideLoadMore();
        return message(labels.empty);
      }

      // Vista "Todas" sin busqueda: resumen por emisor, no la lista completa.
      const summaryView = activeFilter === 'all' && !activeIssuer && !searchQuery;
      const items = summaryView ? buildIssuerCards(filtered) : filtered.map(makeCertCard);

      // El resumen se muestra ENTERO: son una decena de filas compactas y su
      // razon de ser es dar el panorama de un vistazo. Paginarlo escondia
      // emisores detras de un boton, que es justo lo que se queria evitar.
      const pageSize = summaryView ? items.length : limit;
      items.slice(0, pageSize).forEach((el) => grid.appendChild(el));

      if (items.length > pageSize) {
        loadMoreContainer?.classList.remove('hidden');
        loadMoreContainer?.classList.add('flex');
      } else {
        hideLoadMore();
      }
    }

    function hideLoadMore() {
      loadMoreContainer?.classList.remove('flex');
      loadMoreContainer?.classList.add('hidden');
    }

    /** Una tarjeta por emisor: nombre + numero de credenciales. */
    function buildIssuerCards(certs) {
      const order = [];
      const groups = {};
      certs.forEach((c) => {
        const key = (c.issuer || 'Otros').trim();
        if (!groups[key]) {
          groups[key] = [];
          order.push(key);
        }
        groups[key].push(c);
      });
      // De mas a menos credenciales: los bloques grandes primero.
      order.sort((a, b) => groups[b].length - groups[a].length);
      return order.map((issuer) => makeIssuerCard(issuer, groups[issuer]));
    }

    function makeIssuerCard(issuer, certs) {
      const color = issuerColor(issuer);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'reveal is-visible group flex w-full cursor-pointer items-center gap-3 rounded-lg border border-bg-border bg-bg-card p-4 text-left transition hover:border-accent/40 hover:bg-bg-soft/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent';
      btn.setAttribute('aria-label', `${labels.viewIssuer} ${issuer} (${certs.length})`);

      let logo = '';
      for (const c of certs) {
        const l = safeUrl(c.logo_url);
        if (l) { logo = l; break; }
      }
      btn.appendChild(logoBox(logo, issuer, color));

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';

      const name = document.createElement('p');
      name.className = 'truncate text-sm font-semibold text-text';
      name.textContent = issuer;
      info.appendChild(name);

      const sub = document.createElement('p');
      sub.className = 'mt-0.5 text-xs text-text-muted';
      sub.textContent = `${certs.length} ${certs.length === 1 ? labels.credential : labels.credentials}`;
      info.appendChild(sub);
      btn.appendChild(info);

      // Numero grande a la derecha: es el dato que se busca de un vistazo.
      const count = document.createElement('span');
      count.className =
        'shrink-0 rounded-full px-2 py-0.5 font-mono text-sm font-bold tabular-nums';
      count.style.color = color;
      count.style.backgroundColor = color + '1a';
      count.textContent = String(certs.length);
      btn.appendChild(count);

      btn.addEventListener('click', () => {
        activeIssuer = issuer;
        limit = 12;
        render();
        // Devuelve el foco al principio de la lista para quien navega con teclado.
        grid.querySelector('a, button')?.focus({ preventScroll: true });
      });

      return btn;
    }

    /** Tarjeta de UNA certificacion. */
    function makeCertCard(c) {
      const href = safeUrl(c.credential_url);
      const wrap = document.createElement(href ? 'a' : 'div');
      wrap.className =
        'reveal is-visible group flex items-center gap-3 rounded-lg border border-bg-border bg-bg-card p-4 transition hover:border-text-faint/40';
      if (href) {
        wrap.href = href;
        wrap.target = '_blank';
        wrap.rel = 'noopener noreferrer';
      }

      wrap.appendChild(logoBox(c.logo_url, c.issuer || c.name, issuerColor((c.issuer || c.name || '?').trim())));

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const name = document.createElement('p');
      name.className = 'line-clamp-2 text-sm font-medium text-text';
      name.textContent = c.name || '';
      info.appendChild(name);
      const meta = document.createElement('p');
      meta.className = 'mt-0.5 truncate text-xs text-text-muted';
      meta.textContent = [c.issuer, c.issue_date].filter(Boolean).join(' · ');
      info.appendChild(meta);
      wrap.appendChild(info);

      if (href) {
        const a = document.createElement('span');
        a.className = 'shrink-0 text-text-faint transition group-hover:text-accent';
        a.setAttribute('aria-hidden', 'true');
        a.textContent = '↗';
        wrap.appendChild(a);
      }
      return wrap;
    }

    function message(text) {
      const p = document.createElement('p');
      p.className = 'col-span-full text-sm text-text-muted';
      p.textContent = text;
      grid.appendChild(p);
    }

    function fetchWithRetry(url, options = {}, retries = 3, delay = 500) {
      return fetch(url, options)
        .then((res) => {
          if (!res.ok) {
            if (retries > 0) {
              return new Promise((r) => setTimeout(r, delay)).then(() =>
                fetchWithRetry(url, options, retries - 1, delay * 1.5)
              );
            }
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .catch((err) => {
          if (retries > 0) {
            return new Promise((r) => setTimeout(r, delay)).then(() =>
              fetchWithRetry(url, options, retries - 1, delay * 1.5)
            );
          }
          throw err;
        });
    }

    function loadData() {
      status?.classList.remove('hidden');
      spinner?.classList.add('animate-spin');
      if (statusText) statusText.textContent = labels.loading;
      retryBtn?.classList.add('hidden');
      grid.innerHTML = '';

      fetchWithRetry(apiUrl, { headers: { Accept: 'application/json' } })
        .then((data) => {
          grid.dataset.loaded = '1';
          allCerts = Array.isArray(data) ? data : data.items || [];
          status?.classList.add('hidden');
          render();
        })
        .catch(() => {
          if (statusText) statusText.textContent = labels.error;
          spinner?.classList.remove('animate-spin');
          retryBtn?.classList.remove('hidden');
        });
    }

    retryBtn?.addEventListener('click', loadData);

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      activeIssuer = null; // buscar sale del detalle de un emisor
      limit = 12;
      render();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.removeAttribute('aria-pressed');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        activeFilter = btn.dataset.filter;
        activeIssuer = null;
        limit = 12;
        render();
      });
    });

    backBtn?.addEventListener('click', () => {
      activeIssuer = null;
      limit = 12;
      render();
    });

    loadMoreBtn?.addEventListener('click', () => {
      limit = 1299;
      render();
    });

    loadData();
  }
  initCerts();
  document.addEventListener('astro:page-load', initCerts);
</script>
