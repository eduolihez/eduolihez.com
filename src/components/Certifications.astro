---
/**
 * <Certifications /> - Isla dinamica (MySQL via PHP). Contador animado + grid.
 * Script PROCESADO (externo, CSP-safe). safeUrl() sanea las URLs de la BD (S3).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/certifications.php?lang=${lang}`);
const labels = {
  loading: t('certs.loading'),
  error: t('certs.error'),
  empty: t('certs.empty'),
  countLabel: t('certs.count.label'),
};
---

<section id="certificaciones" class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page">
    <div
      class="reveal mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <p class="section-kicker">{t('kicker.certs')}</p>
        <h2 class="section-title">{t('certs.title')}</h2>
        <p class="section-subtitle">{t('certs.subtitle')}</p>
      </div>

      <div class="flex items-center gap-3">
        <Icon name="award" class="h-8 w-8 text-accent" />
        <div>
          <div
            id="certs-counter"
            class="font-mono text-3xl font-bold leading-none text-accent"
            data-target="0"
          >
            0
          </div>
          <div class="mt-1 text-xs text-text-muted">{labels.countLabel}</div>
        </div>
      </div>
    </div>

    <div id="certs-status" class="flex items-center gap-3 text-sm text-text-muted">
      <span
        id="certs-spinner"
        class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
      ></span>
      <span id="certs-status-text">{t('certs.loading')}</span>
      <button
        id="certs-retry-btn"
        class="hidden px-2.5 py-1 text-xs font-semibold text-accent rounded-md border border-accent/20 bg-accent/5 hover:bg-accent hover:text-bg transition duration-150 cursor-pointer"
        type="button"
      >
        Volver a intentar
      </button>
    </div>

    <div
      id="certs-grid"
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
      data-api={apiUrl}
      data-labels={JSON.stringify(labels)}
    >
    </div>

    <div class="reveal mt-8 flex justify-center">
      <a
        href="https://www.credly.com/users/eduolihez"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-bg-border bg-bg-soft/40 px-3.5 py-1.5 text-xs font-semibold text-text-muted hover:border-accent hover:text-accent hover:bg-bg-card transition duration-200 hover:no-underline shadow-sm"
      >
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 fill-current transition-colors text-orange" style="color: #FF5A00;">
          <title>Credly</title>
          <path d="M23.8 13.154a.299.299 0 0 0-.101-.024.407.407 0 0 0-.202.048c-.06.028-.092.08-.127.136-.087.128-.15.268-.226.4-.107.187-.246.351-.38.515-.135.156-.286.291-.424.44-.028.027-.072.043-.107.027-.028-.016-.036-.056-.032-.088.04-.38.075-.763.123-1.138.02-.172.043-.336.063-.512.028-.247.056-.487.087-.735l.234-1.824c.02-.128.032-.372-.135-.52a.446.446 0 0 0-.233-.116.46.46 0 0 0-.254.06c-.226.16-.297.504-.365.76-.142.603-.178 1.241-.471 1.804a1.772 1.772 0 0 1-.202.316.668.668 0 0 1-.186.18.332.332 0 0 1-.246.051.365.365 0 0 1-.238-.207.871.87 0 0 1-.063-.324 4.499 4.499 0 0 1 .24-1.585c.045-.132.089-.252.104-.383.028-.156.028-.38-.114-.516-.131-.128-.337-.18-.504-.128-.194.056-.31.244-.372.392-.198.463-.25.95-.317 1.446-.044.327-.127.64-.293.926a2.717 2.717 0 0 1-.603.72c-.118.087-.222.123-.328.107a.376.376 0 0 1-.278-.208.875.875 0 0 1-.095-.315 3.361 3.36 0 0 1-.036-.616c.004-.223 0-.44.044-.658.075-.39.678-1.937.808-2.345.135-.407.262-.823.353-1.246.08-.38.123-.767.11-1.15-.007-.277-.07-.576-.288-.736a.611.61 0 0 0-.603-.048.968.968 0 0 0-.455.428 2.53 2.53 0 0 0-.226.59 12.01 12.01 0 0 0-.266 1.29c-.071.429-.138.848-.206 1.268-.06.355-.206 1.614-.261 1.88-.06.272-.175.54-.301.787-.131.268-.258.536-.408.791a.694.694 0 0 1-.175.224c-.08.06-.182.088-.27.048-.102-.048-.146-.176-.166-.292-.075-.435-.012-.875.072-1.302.083-.431.44-2.4.519-2.851.099-.532.24-1.05.285-1.59.028-.388.09-.88-.202-1.187-.115-.136-.31-.16-.44-.136-.174.036-.31.176-.388.296-.1.128-.186.28-.258.467-.115.284-.186.615-.261.91l-.032.129c-.083.383-.143.77-.186 1.162a16.95 16.948 0 0 0-.06.632c-.008.1-.016.203-.027.307 0 .08.007.168-.028.244a.304.304 0 0 1-.052.068c-.08.072-.202.06-.31.056-.557-.016-1.045.3-1.35.755-.18.252-.281.542-.39.834-.01.048-.034.1-.054.152-.051.143-.13.327-.222.511a3.037 3.037 0 0 1-.317.46 3.285 3.285 0 0 1-.384.41 1.123 1.123 0 0 1-.515.26c-.174.04-.384-.043-.543-.203a.916.916 0 0 1-.206-.54c-.004-.055-.004-.115.028-.163.05-.068.146-.072.23-.076a1.623 1.623 0 0