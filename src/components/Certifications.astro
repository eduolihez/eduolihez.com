</section>

<script>
  function initCerts() {
    const grid = document.getElementById('certs-grid');
    const status = document.getElementById('certs-status');
    const statusText = document.getElementById('certs-status-text');
    const spinner = document.getElementById('certs-spinner');
    const retryBtn = document.getElementById('certs-retry-btn');
    const counter = document.getElementById('certs-counter');
    if (!grid || grid.dataset.loaded) return;

    const apiUrl = grid.dataset.api || '';
    const labels = JSON.parse(grid.dataset.labels || '{}');

    function safeUrl(url) {
      if (typeof url !== 'string') return '';
      const u = url.trim();
      if (/^(https?:\/\/|mailto:|\/)/i.test(u)) return u;
      return '';
    }

    function animateCounter(target) {
      if (!counter) return;
      counter.setAttribute('data-target', String(target));
      const run = () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || target <= 0) {
          counter.textContent = String(target);
          return;
        }
        const dur = 1100;
        const start = performance.now();
        function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          counter.textContent = String(Math.round(eased * target));
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      };
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                run();
                obs.disconnect();
              }
            });
          },
          { threshold: 0.4 },
        );
        obs.observe(counter);
      } else {
        run();
      }
    }

    function makeCard(c) {
      const href = safeUrl(c.credential_url);
      const wrap = href ? document.createElement('a') : document.createElement('div');
      wrap.className =
        'reveal is-visible group flex items-center gap-3 rounded-lg border border-bg-border bg-bg-card p-4 transition hover:border-text-faint/40';
      if (href) {
        wrap.href = href;
        wrap.target = '_blank';
        wrap.rel = 'noopener noreferrer';
      }

      const logoBox = document.createElement('div');
      logoBox.className =
        'flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-md border border-bg-border bg-bg-soft';
      const logo = safeUrl(c.logo_url);
      if (logo) {
        const img = document.createElement('img');
        img.src = logo;
        img.alt = c.issuer || c.name || '';
        img.loading = 'lazy';
        img.className = 'h-full w-full object-contain p-1.5';
        logoBox.appendChild(img);
      } else {
        const s = document.createElement('span');
        s.className = 'font-mono text-base font-bold text-accent';
        s.textContent = (c.issuer || c.name || '?').charAt(0).toUpperCase();
        logoBox.appendChild(s);
      }
      wrap.appendChild(logoBox);

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const name = document.createElement('p');
      name.className = 'truncate text-sm font-medium text-text';
      name.textContent = c.name || '';
      info.appendChild(name);
      const meta = document.createElement('p');
      meta.className = 'truncate text-xs text-text-muted';
      meta.textContent = [c.issuer, c.issue_date].filter(Boolean).join(' · ');
      info.appendChild(meta);
      wrap.appendChild(info);

      if (href) {
        const a = document.createElement('span');
        a.className = 'shrink-0 text-text-faint transition group-hover:text-accent';
        a.setAttribute('aria-hidden', 'true');
        a.textContent = '↗';
        wrap.appendChild(a);
      }
      return wrap;
    }

    function message(text) {
      if (status) status.classList.add('hidden');
      const p = document.createElement('p');
      p.className = 'text-sm text-text-muted';
      p.textContent = text;
      grid.appendChild(p);
    }

    function fetchWithRetry(url, options = {}, retries = 3, delay = 500) {
      return fetch(url, options)
        .then((res) => {
          if (!res.ok) {
            if (retries > 0) {
              return new Promise((resolve) => setTimeout(resolve, delay))
                .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
            }
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .catch((err) => {
          if (retries > 0) {
            return new Promise((resolve) => setTimeout(resolve, delay))
              .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
          }
          throw err;
        });
    }

    function loadData() {
      // Estado de carga inicial
      if (status) status.classList.remove('hidden');
      if (spinner) spinner.classList.add('animate-spin');
      if (statusText) statusText.textContent = labels.loading;
      if (retryBtn) retryBtn.classList.add('hidden');
      grid.innerHTML = '';

      fetchWithRetry(apiUrl, { headers: { Accept: 'application/json' } })
        .then((data) => {
          grid.dataset.loaded = '1';
          const items = Array.isArray(data) ? data : data.items || [];
          if (status) status.classList.add('hidden');
          animateCounter(items.length);
          if (!items.length) return message(labels.empty);
          items.forEach((c) => grid.appendChild(makeCard(c)));
        })
        .catch(() => {
          if (statusText) statusText.textContent = labels.error;
          if (spinner) spinner.classList.remove('animate-spin');
          if (retryBtn) retryBtn.classList.remove('hidden');
        });
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', loadData);
    }

    loadData();
  }
  initCerts();
  document.addEventListener('astro:page-load', initCerts);
</script>
