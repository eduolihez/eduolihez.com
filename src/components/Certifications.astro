---
/**
 * <Certifications /> - Isla dinamica (MySQL via PHP). Contador animado + grid.
 * Script PROCESADO (externo, CSP-safe). safeUrl() sanea las URLs de la BD (S3).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/certifications.php?lang=${lang}`);
const labels = {
  loading: t('certs.loading'),
  error: t('certs.error'),
  empty: t('certs.empty'),
  countLabel: t('certs.count.label'),
  showMore: lang === 'es' ? 'Mostrar {count} más' : lang === 'ca' ? 'Mostra {count} més' : 'Show {count} more',
  showLess: lang === 'es' ? 'Ocultar' : lang === 'ca' ? 'Amaga' : 'Hide',
};
---

<section id="certificaciones" class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page">
    <div
      class="reveal mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <p class="section-kicker">{t('kicker.certs')}</p>
        <h2 class="section-title">{t('certs.title')}</h2>
        <p class="section-subtitle">{t('certs.subtitle')}</p>
      </div>

      <div class="flex items-center gap-3">
        <Icon name="award" class="h-8 w-8 text-accent" />
        <div>
          <div
            id="certs-counter"
            class="font-mono text-3xl font-bold leading-none text-accent"
            data-target="0"
          >
            0
          </div>
          <div class="mt-1 text-xs text-text-muted">{labels.countLabel}</div>
        </div>
      </div>
    </div>

    <div id="certs-status" class="flex items-center gap-3 text-sm text-text-muted">
      <span
        id="certs-spinner"
        class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
      ></span>
      <span id="certs-status-text">{t('certs.loading')}</span>
      <button
        id="certs-retry-btn"
        class="hidden px-2.5 py-1 text-xs font-semibold text-accent rounded-md border border-accent/20 bg-accent/5 hover:bg-accent hover:text-bg transition duration-150 cursor-pointer"
        type="button"
      >
        Volver a intentar
      </button>
    </div>

    <!-- Buscador y Filtros -->
    <div class="reveal mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <!-- Buscador -->
      <div class="relative flex-1 max-w-md w-full">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-text-muted">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input
          type="search"
          id="certs-search"
          class="w-full pl-9 pr-4 py-2 text-sm rounded-lg border border-bg-border bg-bg-card text-text placeholder-text-muted/60 focus:border-accent focus:ring-1 focus:ring-accent focus:outline-none transition"
          placeholder={lang === 'es' ? 'Buscar certificación o emisor...' : lang === 'ca' ? 'Cercar certificació o emissor...' : 'Search certification or issuer...'}
        />
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap gap-1.5" id="certs-filter-container">
        <button type="button" data-filter="all" class="cert-filter-btn active-filter px-3 py-1.5 text-xs font-semibold rounded-lg border border-accent bg-accent/10 text-accent transition cursor-pointer">
          {lang === 'es' ? 'Todas' : lang === 'ca' ? 'Totes' : 'All'}
        </button>
        <button type="button" data-filter="cyber" class="cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer">
          {lang === 'es' ? 'Ciberseguridad' : lang === 'ca' ? 'Ciberseguretat' : 'Cybersecurity'}
        </button>
        <button type="button" data-filter="ai-cloud" class="cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer">
          {lang === 'es' ? 'IA & Cloud' : lang === 'ca' ? 'IA & Cloud' : 'AI & Cloud'}
        </button>
        <button type="button" data-filter="cisco" class="cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer">
          Cisco
        </button>
        <button type="button" data-filter="tryhackme" class="cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer">
          TryHackMe
        </button>
        <button type="button" data-filter="sys-dev" class="cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer">
          {lang === 'es' ? 'Sistemas & Dev' : lang === 'ca' ? 'Sistemes & Dev' : 'Systems & Dev'}
        </button>
      </div>
    </div>

    <div
      id="certs-grid"
      class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
      data-api={apiUrl}
      data-labels={JSON.stringify(labels)}
    >
    </div>

    <!-- Botón Ver más global para el Grid -->
    <div id="certs-load-more-container" class="reveal mt-6 hidden justify-center">
      <button
        id="certs-load-more-btn"
        type="button"
        class="inline-flex items-center gap-2 rounded-lg border border-bg-border bg-bg-soft/40 px-4 py-2 text-xs font-semibold text-text-muted hover:border-accent hover:text-accent hover:bg-bg-card transition duration-200 cursor-pointer shadow-sm"
      >
        <span>{lang === 'es' ? 'Ver más certificaciones' : lang === 'ca' ? 'Veure más certificacions' : 'Show more certifications'}</span>
        <svg class="h-3.5 w-3.5 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <div class="reveal mt-10 flex justify-center">
      <a
        href="https://www.credly.com/users/eduolihez"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
      >
        <Icon name="award" class="h-4 w-4" />
        {t('certs.credly')}
      </a>
    </div>
  </div>
</section>

<script>
  function initCerts() {
    const grid = document.getElementById('certs-grid');
    const status = document.getElementById('certs-status');
    const statusText = document.getElementById('certs-status-text');
    const spinner = document.getElementById('certs-spinner');
    const retryBtn = document.getElementById('certs-retry-btn');
    const counter = document.getElementById('certs-counter');
    const searchInput = document.getElementById('certs-search');
    const filterButtons = document.querySelectorAll('.cert-filter-btn');
    if (!grid || grid.dataset.loaded) return;

    const apiUrl = grid.dataset.api || '';
    const labels = JSON.parse(grid.dataset.labels || '{}');

    let allCerts = [];
    let activeFilter = 'all';
    let searchQuery = '';
    let animationFrameId = null;
    let hasAnimatedOnce = false;
    let limit = 6;

    function safeUrl(url) {
      if (typeof url !== 'string') return '';
      const u = url.trim();
      if (/^(https?:\/\/|mailto:|\/)/i.test(u)) return u;
      return '';
    }

    function animateCounter(target) {
      if (!counter) return;
      if (animationFrameId) cancelAnimationFrame(animationFrameId);

      const run = () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          counter.textContent = String(target);
          return;
        }
        const dur = 800;
        const start = performance.now();
        const startVal = parseInt(counter.textContent) || 0;
        const diff = target - startVal;
        function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          counter.textContent = String(Math.round(startVal + eased * diff));
          if (p < 1) {
            animationFrameId = requestAnimationFrame(tick);
          } else {
            animationFrameId = null;
          }
        }
        animationFrameId = requestAnimationFrame(tick);
      };

      if (!hasAnimatedOnce && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                hasAnimatedOnce = true;
                run();
                obs.disconnect();
              }
            });
          },
          { threshold: 0.4 },
        );
        obs.observe(counter);
      } else {
        run();
      }
    }

    function renderCerts() {
      grid.innerHTML = '';

      const filtered = allCerts.filter(c => {
        // Filtrar por término de búsqueda
        let matchesSearch = true;
        if (searchQuery) {
          const term = searchQuery.toLowerCase();
          const name = (c.name || '').toLowerCase();
          const issuer = (c.issuer || '').toLowerCase();
          const cat = (c.category || '').toLowerCase();
          matchesSearch = name.includes(term) || issuer.includes(term) || cat.includes(term);
        }

        // Filtrar por categoría
        let matchesCat = true;
        if (activeFilter !== 'all') {
          const cat = (c.category || '').toLowerCase();
          const issuer = (c.issuer || '').toLowerCase();

          if (activeFilter === 'cyber') {
            matchesCat = cat.includes('security') || cat.includes('secops') || cat.includes('intel') || cat.includes('cyber') || issuer.includes('tryhackme');
          } else if (activeFilter === 'ai-cloud') {
            matchesCat = cat.includes('ai') || cat.includes('cloud');
          } else if (activeFilter === 'cisco') {
            matchesCat = issuer.includes('cisco');
          } else if (activeFilter === 'tryhackme') {
            matchesCat = issuer.includes('tryhackme');
          } else if (activeFilter === 'sys-dev') {
            matchesCat = cat.includes('sistemas') || cat.includes('desarrollo') || cat.includes('system') || cat.includes('dev');
          } else {
            matchesCat = false;
          }
        }

        return matchesSearch && matchesCat;
      });

      animateCounter(filtered.length);

      if (!filtered.length) {
        // Ocultar botón Ver más si no hay resultados
        const loadMoreContainer = document.getElementById('certs-load-more-container');
        if (loadMoreContainer) {
          loadMoreContainer.classList.remove('flex');
          loadMoreContainer.classList.add('hidden');
        }
        return message(labels.empty);
      }

      const issuersOrder = [];
      const grouped = {};
      filtered.forEach((c) => {
        const issuer = c.issuer ? c.issuer.trim() : 'Otros';
        if (!grouped[issuer]) {
          grouped[issuer] = [];
          issuersOrder.push(issuer);
        }
        grouped[issuer].push(c);
      });

      // Lista de grupos para limitar el renderizado inicial y evitar sobrecarga visual
      const groupsList = issuersOrder.map(issuer => {
        return { issuer, certs: grouped[issuer] };
      });

      const loadMoreContainer = document.getElementById('certs-load-more-container');
      const visibleGroups = groupsList.slice(0, limit);

      visibleGroups.forEach((group) => {
        if (group.certs.length === 1) {
          grid.appendChild(makeSingleCard(group.certs[0]));
        } else {
          grid.appendChild(makeGroupedCard(group.issuer, group.certs));
        }
      });

      if (groupsList.length > limit) {
        if (loadMoreContainer) {
          loadMoreContainer.classList.remove('hidden');
          loadMoreContainer.classList.add('flex');
        }
      } else {
        if (loadMoreContainer) {
          loadMoreContainer.classList.remove('flex');
          loadMoreContainer.classList.add('hidden');
        }
      }
    }

    function makeSingleCard(c) {
      const href = safeUrl(c.credential_url);
      const wrap = href ? document.createElement('a') : document.createElement('div');
      wrap.className =
        'reveal is-visible group flex items-center gap-3 rounded-lg border border-bg-border bg-bg-card p-4 transition hover:border-text-faint/40';
      if (href) {
        wrap.href = href;
        wrap.target = '_blank';
        wrap.rel = 'noopener noreferrer';
      }

      const logoBox = document.createElement('div');
      logoBox.className =
        'flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-md border border-bg-border bg-bg-soft';
      const logo = safeUrl(c.logo_url);
      if (logo) {
        const img = document.createElement('img');
        img.src = logo;
        img.alt = c.issuer || c.name || '';
        img.loading = 'lazy';
        img.className = 'h-full w-full object-contain p-1.5';
        logoBox.appendChild(img);
      } else {
        const s = document.createElement('span');
        s.className = 'font-mono text-base font-bold text-accent';
        s.textContent = (c.issuer || c.name || '?').charAt(0).toUpperCase();
        logoBox.appendChild(s);
      }
      wrap.appendChild(logoBox);

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const name = document.createElement('p');
      name.className = 'truncate text-sm font-medium text-text';
      name.textContent = c.name || '';
      info.appendChild(name);
      const meta = document.createElement('p');
      meta.className = 'truncate text-xs text-text-muted';
      meta.textContent = [c.issuer, c.issue_date].filter(Boolean).join(' · ');
      info.appendChild(meta);
      wrap.appendChild(info);

      if (href) {
        const a = document.createElement('span');
        a.className = 'shrink-0 text-text-faint transition group-hover:text-accent';
        a.setAttribute('aria-hidden', 'true');
        a.textContent = '↗';
        wrap.appendChild(a);
      }
      return wrap;
    }

    function makeListItem(c) {
      const href = safeUrl(c.credential_url);
      const item = href ? document.createElement('a') : document.createElement('div');
      item.className = 'group/item flex items-center justify-between gap-2 rounded-md bg-bg-soft/30 px-3 py-2 text-xs border border-bg-border/20 transition-all hover:bg-bg-soft/60 hover:border-bg-border/60 hover:text-accent w-full min-w-0';
      if (href) {
        item.href = href;
        item.target = '_blank';
        item.rel = 'noopener noreferrer';
      }

      const certName = document.createElement('span');
      certName.className = 'truncate font-medium text-text group-hover/item:text-accent min-w-0 flex-1 text-left';
      certName.textContent = c.name || '';
      item.appendChild(certName);

      const meta = document.createElement('span');
      meta.className = 'shrink-0 text-[10px] text-text-faint font-mono mr-1';
      meta.textContent = c.issue_date || '';
      item.appendChild(meta);

      if (href) {
        const arrow = document.createElement('span');
        arrow.className = 'shrink-0 text-text-faint font-mono transition group-hover/item:text-accent';
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '↗';
        item.appendChild(arrow);
      }

      return item;
    }

    function makeGroupedCard(issuerName, certs) {
      const card = document.createElement('div');
      card.className =
        'reveal is-visible flex flex-col justify-between rounded-lg border border-bg-border bg-bg-card p-4 transition-all duration-200 hover:border-bg-border/80';

      const header = document.createElement('div');
      header.className = 'flex items-center gap-3 mb-3';

      const logoBox = document.createElement('div');
      logoBox.className =
        'flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-md border border-bg-border bg-bg-soft';
      
      let logo = '';
      for (const c of certs) {
        const l = safeUrl(c.logo_url);
        if (l) {
          logo = l;
          break;
        }
      }

      if (logo) {
        const img = document.createElement('img');
        img.src = logo;
        img.alt = issuerName;
        img.loading = 'lazy';
        img.className = 'h-full w-full object-contain p-1.5';
        logoBox.appendChild(img);
      } else {
        const s = document.createElement('span');
        s.className = 'font-mono text-base font-bold text-accent';
        s.textContent = issuerName.charAt(0).toUpperCase();
        logoBox.appendChild(s);
      }
      header.appendChild(logoBox);

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      
      const titleWrapper = document.createElement('div');
      titleWrapper.className = 'flex items-center gap-2';
      
      const name = document.createElement('h3');
      name.className = 'truncate text-sm font-semibold text-text';
      name.textContent = issuerName;
      titleWrapper.appendChild(name);

      const badge = document.createElement('span');
      badge.className = 'inline-flex items-center rounded-full bg-accent/10 px-1.5 py-0.5 text-[10px] font-semibold text-accent';
      badge.textContent = String(certs.length);
      titleWrapper.appendChild(badge);
      
      info.appendChild(titleWrapper);

      const sub = document.createElement('p');
      sub.className = 'text-[11px] text-text-muted mt-0.5';
      const dates = certs.map(c => c.issue_date).filter(Boolean);
      sub.textContent = dates.length ? [...new Set(dates)].join(', ') : 'Credenciales';
      info.appendChild(sub);
      
      header.appendChild(info);
      card.appendChild(header);

      const listContainer = document.createElement('div');
      listContainer.className = 'flex flex-col gap-2 w-full mt-1';

      listContainer.appendChild(makeListItem(certs[0]));

      const collapsableContainer = document.createElement('div');
      collapsableContainer.className = 'hidden flex-col gap-2 w-full transition-all duration-300';
      for (let i = 1; i < certs.length; i++) {
        collapsableContainer.appendChild(makeListItem(certs[i]));
      }
      listContainer.appendChild(collapsableContainer);
      card.appendChild(listContainer);

      const toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.className = 'mt-3 text-center text-[11px] font-semibold text-text-muted hover:text-accent transition duration-150 flex items-center justify-center gap-1 cursor-pointer w-full py-1.5 rounded bg-bg-soft/20 hover:bg-bg-soft/40 border border-bg-border/30';
      
      const remainingCount = certs.length - 1;
      const showMoreText = labels.showMore.replace('{count}', String(remainingCount));
      const showLessText = labels.showLess;
      
      const btnText = document.createElement('span');
      btnText.textContent = showMoreText;
      toggleBtn.appendChild(btnText);

      const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      icon.setAttribute('class', 'h-3 w-3 transform transition-transform duration-200 text-text-faint');
      icon.setAttribute('fill', 'none');
      icon.setAttribute('viewBox', '0 0 24 24');
      icon.setAttribute('stroke', 'currentColor');
      
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      path.setAttribute('stroke-width', '2.5');
      path.setAttribute('d', 'M19 9l-7 7-7-7');
      icon.appendChild(path);
      toggleBtn.appendChild(icon);
      card.appendChild(toggleBtn);

      toggleBtn.addEventListener('click', () => {
        const isCollapsed = collapsableContainer.classList.contains('hidden');
        if (isCollapsed) {
          collapsableContainer.classList.remove('hidden');
          collapsableContainer.classList.add('flex');
          btnText.textContent = showLessText;
          icon.classList.add('rotate-180');
        } else {
          collapsableContainer.classList.remove('flex');
          collapsableContainer.classList.add('hidden');
          btnText.textContent = showMoreText;
          icon.classList.remove('rotate-180');
        }
      });

      return card;
    }

    function message(text) {
      if (status) status.classList.add('hidden');
      const p = document.createElement('p');
      p.className = 'text-sm text-text-muted';
      p.textContent = text;
      grid.appendChild(p);
    }

    function fetchWithRetry(url, options = {}, retries = 3, delay = 500) {
      return fetch(url, options)
        .then((res) => {
          if (!res.ok) {
            if (retries > 0) {
              return new Promise((resolve) => setTimeout(resolve, delay))
                .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
            }
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .catch((err) => {
          if (retries > 0) {
            return new Promise((resolve) => setTimeout(resolve, delay))
              .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
          }
          throw err;
        });
    }

    function loadData() {
      if (status) status.classList.remove('hidden');
      if (spinner) spinner.classList.add('animate-spin');
      if (statusText) statusText.textContent = labels.loading;
      if (retryBtn) retryBtn.classList.add('hidden');
      grid.innerHTML = '';

      fetchWithRetry(apiUrl, { headers: { Accept: 'application/json' } })
        .then((data) => {
          grid.dataset.loaded = '1';
          allCerts = Array.isArray(data) ? data : data.items || [];
          if (status) status.classList.add('hidden');
          renderCerts();
        })
        .catch(() => {
          if (statusText) statusText.textContent = labels.error;
          if (spinner) spinner.classList.remove('animate-spin');
          if (retryBtn) retryBtn.classList.remove('hidden');
        });
    }

    if (retryBtn) {
      retryBtn.addEventListener('click', loadData);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        limit = 6;
        renderCerts();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active-filter');
          b.className = 'cert-filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg border border-bg-border bg-bg-card text-text-muted hover:text-text hover:border-text-faint/40 transition cursor-pointer';
        });
        btn.classList.add('active-filter');
        btn.className = 'cert-filter-btn active-filter px-3 py-1.5 text-xs font-semibold rounded-lg border border-accent bg-accent/10 text-accent transition cursor-pointer';
        activeFilter = btn.dataset.filter;
        limit = 6;
        renderCerts();
      });
    });

    const loadMoreBtn = document.getElementById('certs-load-more-btn');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        limit = 999;
        renderCerts();
      });
    }

    loadData();
  }
  initCerts();
  document.addEventListener('astro:page-load', initCerts);
</script>
