---
/**
 * <ConsentBanner /> - Aviso OPT-IN de la cookie de analitica `eo_vid` (tarea 11).
 *
 * Se renderiza con `hidden`: sin JS no aparece (y sin JS tampoco hay cookie).
 * src/scripts/consent.ts lo muestra en la primera visita, lo oculta con DNT/GPC
 * y lo reabre desde el enlace "Cookies" del pie. No es modal: no bloquea la
 * pagina ni atrapa el foco. Los dos botones tienen exactamente el mismo estilo.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { privacyPaths } from '../data/privacy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// "Mas detalles" lleva a la politica de privacidad, seccion de cookies.
const aboutPath = `${privacyPaths[lang]}#cookies`;
const btn =
  'inline-flex min-h-11 flex-1 items-center justify-center rounded-lg border border-bg-border bg-bg-soft px-4 text-sm font-semibold text-text-title transition hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:flex-none';
---

<section
  id="consent-banner"
  data-consent-banner
  aria-labelledby="consent-title"
  hidden
  class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-xl rounded-xl border border-bg-border bg-bg-card p-4 text-sm shadow-[0_8px_24px_rgb(0_0_0/0.18)] sm:inset-x-6 sm:bottom-6 sm:p-5"
>
  <h2 id="consent-title" data-consent-title tabindex="-1" class="font-display text-base font-bold text-text-title focus:outline-none">
    {t('consent.title')}
  </h2>
  <p class="mt-2 text-text-muted">
    {t('consent.body')}
    <a href={aboutPath} class="font-semibold text-text underline underline-offset-2 hover:text-accent">{t('consent.more')}</a>
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    <button type="button" data-consent-choice="denied" class={btn}>{t('consent.reject')}</button>
    <button type="button" data-consent-choice="granted" class={btn}>{t('consent.accept')}</button>
  </div>
</section>
