---
/**
 * <Contact /> - Formulario de contacto (minimalista).
 * - Script PROCESADO (externo, CSP-safe); config via data-* en el formulario.
 * - Envio: /api/contact.php (MySQL + email) con respaldo Formspree.
 * - Honeypot accesible-oculto (B6) + Cloudflare Turnstile OPCIONAL (F9).
 * - vCard descargable (F10).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE, api } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api('/api/contact.php');
const settingsUrl = api(`/api/settings.php?lang=${lang}`);
const turnstileKey = SITE.turnstileSiteKey;
const messages = {
  sending: t('contact.sending'),
  send: t('contact.send'),
  success: t('contact.success'),
  error: t('contact.error'),
  required: t('contact.required'),
  invalidEmail: t('contact.invalidEmail'),
  disabled: t('contact.disabled'),
  captcha: t('contact.captcha'),
  fieldRequired: t('contact.fieldRequired'),
};
---

<section id="contacto" class="bg-bg-soft py-14 sm:py-16">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-14">
      <div>
        <h2 class="section-title">{t('contact.title')}</h2>
        <p class="section-subtitle">{t('contact.subtitle')}</p>

        <div class="mt-6">
          <a
            href={`mailto:${SITE.social.email}`}
            class="group flex min-h-11 items-center gap-3 text-sm text-text hover:text-accent"
          >
            <Icon name="mail" class="h-4 w-4 shrink-0 text-text-muted group-hover:text-accent" />
            {SITE.social.email}
          </a>
          <a
            href={SITE.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-11 items-center gap-3 text-sm text-text hover:text-accent"
          >
            <Icon name="linkedin" class="h-4 w-4 shrink-0 text-text-muted group-hover:text-accent" />
            LinkedIn
          </a>
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-11 items-center gap-3 text-sm text-text hover:text-accent"
          >
            <Icon name="github" class="h-4 w-4 shrink-0 text-text-muted group-hover:text-accent" />
            GitHub
          </a>
          <a
            href={SITE.vcard}
            download
            class="group flex min-h-11 items-center gap-3 text-sm text-text hover:text-accent"
          >
            <Icon name="download" class="h-4 w-4 shrink-0 text-text-muted group-hover:text-accent" />
            {t('contact.vcard')}
          </a>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="rounded-md border border-bg-border bg-bg-card p-5 sm:p-6"
          novalidate
          data-api={apiUrl}
          data-settings={settingsUrl}
          data-formspree={SITE.formspree}
          data-lang={lang}
          data-messages={JSON.stringify(messages)}
        >
          <!-- Honeypot: oculto para humanos y lectores, presente para bots (B6).
               Usa clases (hoja externa), no style inline, por la CSP estricta. -->
          <div aria-hidden="true" class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden">
            <label for="website">No rellenar</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-x-4 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-text">
                {t('contact.name')} <span class="text-danger" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                maxlength="100"
                autocomplete="name"
                aria-describedby="name-error"
                class="w-full rounded-md border border-bg-border bg-bg px-3.5 py-3 text-base text-text placeholder:text-text-faint aria-[invalid=true]:border-danger sm:text-sm"
              />
              <p id="name-error" class="field-error"></p>
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-text">
                {t('contact.email')} <span class="text-danger" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                maxlength="150"
                autocomplete="email"
                aria-describedby="email-error"
                class="w-full rounded-md border border-bg-border bg-bg px-3.5 py-3 text-base text-text placeholder:text-text-faint aria-[invalid=true]:border-danger sm:text-sm"
              />
              <p id="email-error" class="field-error"></p>
            </div>
          </div>

          <div class="mt-1">
            <label for="subject" class="mb-1.5 block text-sm font-medium text-text">{t('contact.subject')}</label>
            <input
              type="text"
              id="subject"
              name="subject"
              maxlength="150"
              class="w-full rounded-md border border-bg-border bg-bg px-3.5 py-3 text-base text-text placeholder:text-text-faint aria-[invalid=true]:border-danger sm:text-sm"
            />
          </div>

          <div class="mt-4">
            <label for="message" class="mb-1.5 block text-sm font-medium text-text">
              {t('contact.message')} <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              maxlength="3000"
              aria-describedby="message-error"
              class="w-full rounded-md border border-bg-border bg-bg px-3.5 py-3 text-base text-text placeholder:text-text-faint aria-[invalid=true]:border-danger sm:text-sm resize-y"
            ></textarea>
            <p id="message-error" class="field-error"></p>
          </div>

          {
            turnstileKey && (
              <div class="cf-turnstile mt-2" data-sitekey={turnstileKey} data-theme="auto" />
            )
          }

          <button type="submit" id="contact-submit" class="btn-primary mt-4 min-h-11 w-full">
            <span id="contact-submit-text">{t('contact.send')}</span>
          </button>

          <p id="contact-feedback" role="status" aria-live="polite" class="mt-3 min-h-10 text-sm font-medium"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { getSettings, captchaPending } from '../scripts/shared';
  import { loadTurnstileOnDemand } from '../scripts/turnstile';

  // Turnstile se carga bajo demanda (ver scripts/turnstile.ts). Su dominio ya
  // esta en la CSP de astro.config.mjs (ver CLOUDFLARE.md).
  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js';

  function initContact() {
    const form = document.getElementById('contact-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    loadTurnstileOnDemand(form, TURNSTILE_SRC);

    const apiUrl = form.dataset.api || '';
    const formspree = form.dataset.formspree || '';
    const messages = JSON.parse(form.dataset.messages || '{}');
    const btn = document.getElementById('contact-submit');
    const btnText = document.getElementById('contact-submit-text');
    const feedback = document.getElementById('contact-feedback');

    function setFeedback(text, ok) {
      feedback.textContent = text;
      feedback.classList.remove('text-accent', 'text-danger');
      feedback.classList.add(ok ? 'text-accent' : 'text-danger');
    }

    // Validacion inline: el mensaje va junto al campo (#<id>-error, ya
    // enlazado con aria-describedby) y aria-invalid marca el campo.
    function setFieldError(id, msg) {
      const input = document.getElementById(id);
      const slot = document.getElementById(id + '-error');
      if (!input || !slot) return;
      slot.textContent = msg;
      if (msg) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }
    ['name', 'email', 'message'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => setFieldError(id, ''));
    });

    // El formulario se puede apagar desde /admin -> Ajustes (util si llega
    // spam). Si esta apagado, bloqueamos el envio y mostramos las vias
    // alternativas, que siguen visibles a la izquierda de la seccion.
    let formEnabled = true;
    getSettings(form.dataset.settings || '')
      .then((data) => {
        if (data && String((data as { contact_enabled?: unknown }).contact_enabled) === '0') {
          formEnabled = false;
          btn.setAttribute('disabled', 'true');
          btn.classList.add('opacity-50', 'cursor-not-allowed');
          setFeedback(messages.disabled, false);
        }
      })
      .catch(() => {
        /* si el API no responde, dejamos el formulario activo: el propio
           endpoint volvera a comprobarlo al recibir el envio */
      });
    function isEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }

    async function sendFormspree(payload) {
      const res = await fetch(formspree, {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('formspree');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!formEnabled) return setFeedback(messages.disabled, false);

      const data = Object.fromEntries(new FormData(form).entries());

      if (data.website) {
        setFeedback(messages.success, true);
        form.reset();
        return;
      }
      const problems = [];
      if (!data.name?.trim()) problems.push(['name', messages.fieldRequired]);
      if (!data.email?.trim()) problems.push(['email', messages.fieldRequired]);
      else if (!isEmail(data.email)) problems.push(['email', messages.invalidEmail]);
      if (!data.message?.trim()) problems.push(['message', messages.fieldRequired]);
      ['name', 'email', 'message'].forEach((id) => {
        const found = problems.find((p) => p[0] === id);
        setFieldError(id, found ? found[1] : '');
      });
      if (problems.length > 0) {
        feedback.textContent = '';
        document.getElementById(problems[0][0])?.focus();
        return;
      }

      // Captcha de Cloudflare: si hay widget y aun no esta resuelto, no se
      // envia nada (el servidor tambien lo exige, esto solo evita el viaje).
      const widgetPresent = !!form.querySelector('.cf-turnstile');
      if (captchaPending(widgetPresent, String(data['cf-turnstile-response'] || ''))) {
        return setFeedback(messages.captcha, false);
      }

      btn.setAttribute('disabled', 'true');
      btn.classList.add('opacity-60', 'cursor-not-allowed');
      btnText.textContent = messages.sending;
      feedback.textContent = '';

      const payload = {
        name: data.name.trim(),
        email: data.email.trim(),
        subject: (data.subject || '').trim(),
        message: data.message.trim(),
        turnstileToken: data['cf-turnstile-response'] || '',
        // Idioma de la pagina: sale en el email de aviso (es/en/ca).
        lang: form.dataset.lang || '',
      };

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        // 503 = formulario desactivado a proposito desde el panel.
        // 429 = demasiados envios desde esta IP.
        // En ambos casos NO usamos el respaldo de Formspree: seria saltarse
        // justo lo que el servidor acaba de denegar.
        if (res.status === 503) {
          formEnabled = false;
          btn.setAttribute('disabled', 'true');
          return setFeedback(messages.disabled, false);
        }
        if (res.status === 429 || res.status === 422 || res.status === 403) {
          const body = await res.json().catch(() => null);
          return setFeedback((body && body.error) || messages.error, false);
        }
        if (!res.ok) throw new Error('php');

        setFeedback(messages.success, true);
        form.reset();
      } catch (err) {
        // Solo llegamos aqui si el backend PHP esta caido o no responde:
        // entonces si tiene sentido el respaldo de Formspree.
        try {
          await sendFormspree(payload);
          setFeedback(messages.success, true);
          form.reset();
        } catch (err2) {
          setFeedback(messages.error, false);
        }
      } finally {
        // Si el formulario quedo desactivado por el servidor, no lo
        // reactivamos (el bloque finally se ejecuta incluso tras un return).
        if (formEnabled) {
          btn.removeAttribute('disabled');
          btn.classList.remove('opacity-60', 'cursor-not-allowed');
        }
        btnText.textContent = messages.send;
        if (window.turnstile) {
          try {
            window.turnstile.reset();
          } catch (e) {}
        }
      }
    });
  }
  initContact();
  document.addEventListener('astro:page-load', initContact);
</script>
