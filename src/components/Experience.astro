---
/**
 * <Experience /> - Timeline vertical con la trayectoria profesional.
 * Datos: src/data/experience.ts. En catalan cae a espanol (pick()).
 */
import { useTranslations, pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { experiences } from '../data/experience';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Agrupar experiencias consecutivas de la misma empresa
const groupedExperiences = [];
for (const exp of experiences) {
  const lastGroup = groupedExperiences[groupedExperiences.length - 1];
  if (lastGroup && lastGroup.company === exp.company) {
    lastGroup.roles.push(exp);
  } else {
    groupedExperiences.push({
      company: exp.company,
      roles: [exp],
    });
  }
}

// Helper para obtener el periodo total de un grupo de roles consecutivas en la misma empresa
const getTotalPeriod = (roles: typeof experiences, lang: Lang) => {
  if (roles.length === 0) return '';
  const newestRole = roles[0];
  const oldestRole = roles[roles.length - 1];
  
  const oldestPeriod = pick(oldestRole.period, lang);
  const newestPeriod = pick(newestRole.period, lang);
  
  const start = oldestPeriod.split(' - ')[0];
  const end = newestPeriod.split(' - ')[1] || newestPeriod;
  
  return `${start} - ${end}`;
};
---

<section id="experiencia" class="border-b border-bg-border py-20 sm:py-28">
  <div class="container-page">
    <div class="reveal mb-12">
      <p class="section-kicker">{t('kicker.experience')}</p>
      <h2 class="section-title">{t('experience.title')}</h2>
      <p class="section-subtitle">{t('experience.subtitle')}</p>
    </div>

    <ol class="relative ml-3 space-y-8 border-l border-bg-border sm:ml-4">
      {
        groupedExperiences.map((group) => {
          if (group.roles.length === 1) {
            const exp = group.roles[0];
            return (
              <li class="reveal relative pl-8 sm:pl-10">
                {/* Timeline node aligned with card header */}
                <span
                  class={`absolute -left-[6px] top-8 h-3 w-3 rounded-full border-2 border-bg ${
                    exp.current ? 'bg-accent' : 'bg-bg-border'
                  }`}
                  aria-hidden="true"
                />

                {/* Company card */}
                <div class="rounded-xl border border-bg-border/50 bg-bg-card/25 hover:bg-bg-card/40 p-5 sm:p-6 transition-all duration-300 shadow-xs hover:shadow-md">
                  <div class="flex items-center gap-3 mb-4 border-b border-bg-border/30 pb-3">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-bg border border-bg-border text-text-muted shadow-xs">
                      <Icon name="briefcase" class="h-4 w-4" />
                    </span>
                    <div>
                      <h3 class="text-base font-semibold text-text leading-tight">{pick(exp.role, lang)}</h3>
                      <p class="font-mono text-xs text-text-faint mt-0.5">{exp.company}</p>
                    </div>
                  </div>

                  <p class="font-mono text-xs text-text-muted mb-3 flex items-center gap-2">
                    {pick(exp.period, lang)}
                    {exp.current && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-medium text-accent">
                        <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                        {t('experience.current')}
                      </span>
                    )}
                  </p>

                  <p class="text-sm leading-relaxed text-text-muted">
                    {pick(exp.description, lang)}
                  </p>

                  <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('experience.tech')}>
                    {exp.tech.map((tech) => (
                      <li class="badge">{tech}</li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          } else {
            // Formato ascenso/LinkedIn para múltiples roles en la misma empresa
            const totalPeriod = getTotalPeriod(group.roles, lang);
            const hasCurrent = group.roles.some((r) => r.current);
            return (
              <li class="reveal relative pl-8 sm:pl-10">
                {/* Main company timeline node aligned with card header */}
                <span
                  class={`absolute -left-[6px] top-8 h-3 w-3 rounded-full border-2 border-bg ${
                    hasCurrent ? 'bg-accent' : 'bg-bg-border'
                  }`}
                  aria-hidden="true"
                />

                {/* Company card with nested promotion timeline */}
                <div class="rounded-xl border border-bg-border/50 bg-bg-card/25 hover:bg-bg-card/40 p-5 sm:p-6 transition-all duration-300 shadow-xs hover:shadow-md">
                  {/* Encabezado de la empresa */}
                  <div class="flex items-center gap-3 mb-5 border-b border-bg-border/30 pb-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-bg border border-bg-border text-accent shadow-xs">
                      <Icon name="briefcase" class="h-5 w-5" />
                    </span>
                    <div>
                      <h3 class="text-lg font-bold text-text leading-tight">{group.company}</h3>
                      <p class="font-mono text-xs text-text-faint mt-0.5">{totalPeriod}</p>
                    </div>
                  </div>

                  {/* Listado de roles consecutivos con su propia sub-línea */}
                  <div class="relative border-l border-bg-border/60 ml-[18px] pl-6 space-y-6">
                    {group.roles.map((role) => (
                      <div class="relative">
                        {/* Sub-nodo de rol */}
                        <span
                          class={`absolute -left-[28px] top-1.5 h-2 w-2 rounded-full border border-bg-card bg-bg-border ${
                            role.current ? 'bg-accent border-accent' : 'bg-bg-border'
                          }`}
                          aria-hidden="true"
                        />

                        <div>
                          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <h4 class="text-sm font-semibold text-text leading-tight">{pick(role.role, lang)}</h4>
                            {role.current && (
                              <span class="inline-flex items-center gap-1 text-[10px] font-medium text-accent">
                                <span class="h-1 w-1 rounded-full bg-accent" />
                                {t('experience.current')}
                              </span>
                            )}
                          </div>

                          <p class="font-mono text-xs text-text-muted mt-0.5">
                            {pick(role.period, lang)}
                          </p>

                          <p class="mt-2 text-xs leading-relaxed text-text-muted">
                            {pick(role.description, lang)}
                          </p>

                          <!-- El interlineado del chip se fija a mano (/4 = 1rem):
                               .badge trae text-xs y en Tailwind 4 su line-height es
                               un ratio sin unidad, asi que al bajar el tamano a 10px
                               la altura del chip se encogeria sola. -->
                          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={t('experience.tech')}>
                            {role.tech.map((tech) => (
                              <li class="badge text-[10px]/4 py-0.5 px-1.5">{tech}</li>
                            ))}
                          </ul>

                          {role.link && (
                            <a
                              href={role.link.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="group/link mt-3 inline-flex items-center gap-1.5 font-mono text-xs text-accent transition hover:underline"
                            >
                              <Icon name="github" class="h-3.5 w-3.5" />
                              {pick(role.link.label, lang)}
                              <span class="transition-transform group-hover/link:translate-x-0.5">&rarr;</span>
                            </a>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            );
          }
        })
      }
    </ol>
  </div>
</section>
