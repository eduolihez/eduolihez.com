---
/**
 * <Experience /> - Linea de tiempo compacta: una fila por empresa, fechas en mono a la
 * izquierda, logros (frases de la descripcion) y tecnologias a la derecha. Sin tarjetas.
 * Datos: src/data/experience.ts. En catalan cae a espanol (pick()).
 */
import { useTranslations, pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { experiences } from '../data/experience';
import { splitSentences } from '../scripts/sentences';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Agrupar experiencias consecutivas de la misma empresa
const groupedExperiences = [];
for (const exp of experiences) {
  const lastGroup = groupedExperiences[groupedExperiences.length - 1];
  if (lastGroup && lastGroup.company === exp.company) {
    lastGroup.roles.push(exp);
  } else {
    groupedExperiences.push({
      company: exp.company,
      roles: [exp],
    });
  }
}

// Helper para obtener el periodo total de un grupo de roles consecutivas en la misma empresa
const getTotalPeriod = (roles: typeof experiences, lang: Lang) => {
  if (roles.length === 0) return '';
  const newestRole = roles[0];
  const oldestRole = roles[roles.length - 1];
  
  const oldestPeriod = pick(oldestRole.period, lang);
  const newestPeriod = pick(newestRole.period, lang);
  
  const start = oldestPeriod.split(' - ')[0];
  const end = newestPeriod.split(' - ')[1] || newestPeriod;
  
  return `${start} - ${end}`;
};
---

<section id="experiencia" class="border-b border-bg-border py-14 sm:py-16">
  <div class="container-page">
    <div class="reveal mb-8">
      <h2 class="section-title">{t('experience.title')}</h2>
      <p class="section-subtitle">{t('experience.subtitle')}</p>
    </div>

    <ol class="border-y border-bg-border">
      {
        groupedExperiences.map((group, gi) => {
          const hasCurrent = group.roles.some((r) => r.current);
          const multi = group.roles.length > 1;
          // Solo el primer puesto va abierto en movil; el resto se pliega (sigue en el DOM).
          const Detail = gi === 0 ? 'div' : 'details';
          return (
            <li
              class={`grid gap-x-8 gap-y-3 border-b border-bg-border px-4 py-6 last:border-b-0 sm:grid-cols-[11rem_1fr] ${
                hasCurrent ? 'bg-bg-soft' : ''
              }`}
            >
              <div>
                <h3 class="text-base font-semibold leading-snug text-text">{group.company}</h3>
                <p class="mt-1 font-mono text-xs text-text-muted">{getTotalPeriod(group.roles, lang)}</p>
                {hasCurrent && (
                  <p class="mt-2 inline-block rounded-sm bg-mark px-2 py-0.5 text-xs font-semibold text-on-mark">
                    {t('experience.current')}
                  </p>
                )}
              </div>

              <div class="space-y-6">
                {group.roles.map((role) => (
                  <div>
                    <h4 class="text-[15px] font-semibold leading-snug text-text-title">{pick(role.role, lang)}</h4>
                    {multi && <p class="mt-0.5 font-mono text-xs text-text-muted">{pick(role.period, lang)}</p>}
                    <Detail class="exp-detail" open={gi === 0 ? undefined : true} data-exp-fold={gi === 0 ? undefined : ''}>
                      {gi > 0 && <summary class="exp-summary">{t('experience.details')}</summary>}
                      <ul class="mt-2 list-disc space-y-1 pl-4 text-sm leading-relaxed text-text-muted marker:text-text-faint">
                        {splitSentences(pick(role.description, lang)).map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                      <ul class="dot-list mt-3 font-mono text-xs text-text-muted" aria-label={t('experience.tech')}>
                        {role.tech.map((tech) => (
                          <li>{tech}</li>
                        ))}
                      </ul>
                      {role.link && (
                        <a
                          href={role.link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm text-accent underline-offset-4 hover:underline"
                        >
                          <Icon name="github" class="h-4 w-4" />
                          {pick(role.link.label, lang)}
                          <span aria-hidden="true">&rarr;</span>
                        </a>
                      )}
                    </Detail>
                  </div>
                ))}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  import { foldExperience } from '../scripts/experience-fold';
  foldExperience();
  document.addEventListener('astro:page-load', foldExperience);
</script>
