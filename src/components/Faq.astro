---
/**
 * <Faq /> - Preguntas frecuentes.
 *
 * No es relleno: es la seccion que mas trabaja para las IAs.
 *   - Google retiro el rich result de FAQPage para todos los sitios el 7 de
 *     mayo de 2026 (antes solo afectaba a gov/salud) -- el dato FAQPage que
 *     genera Seo.astro a partir de este archivo ya NO produce el desplegable
 *     en resultados de busqueda. Se mantiene solo por su posible valor de
 *     citabilidad en IA (ver punto siguiente), no como tactica de SERP.
 *   - Los modelos de lenguaje leen respuestas cortas y autosuficientes, que es
 *     exactamente el formato de una FAQ. Es lo que citan cuando alguien les
 *     pregunta "¿quien es Eduardo Olivares?".
 *   - Y de paso mete de forma natural las palabras que buscan las personas:
 *     "analista SOC en Badalona", "ciberseguridad Barcelona".
 *
 * Usa <details>/<summary> nativos: acordeon accesible, con teclado, sin una
 * sola linea de JavaScript. El contenido esta SIEMPRE en el HTML, asi que los
 * rastreadores lo leen aunque no ejecuten scripts.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { faqItems } from '../data/faq';
import FaqItem from './FaqItem.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Las 5 primeras a la vista; el resto sigue en el DOM dentro de un <details> envolvente.
const VISIBLE = 5;
const shown = faqItems.slice(0, VISIBLE);
const more = faqItems.slice(VISIBLE);
---

<section id="faq" class="border-b border-bg-border bg-bg-soft py-14 sm:py-16">
  <div class="container-page grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-14">
    <div>
      <h2 class="section-title">{t('faq.title')}</h2>
      <p class="section-subtitle">{t('faq.subtitle')}</p>
    </div>

    <div class="border-y border-bg-border">
      {shown.map((item) => <FaqItem item={item} lang={lang} />)}
      {
        more.length > 0 && (
          <details class="faq-more border-t border-bg-border">
            <summary class="faq-more-summary flex min-h-11 cursor-pointer list-none items-center gap-2 py-3 text-sm font-semibold text-accent hover:underline">
              <span>{t('faq.more')}</span>
              <span class="font-mono text-xs text-text-muted" aria-hidden="true">+{more.length}</span>
            </summary>
            <div class="divide-y divide-bg-border border-t border-bg-border">
              {more.map((item) => <FaqItem item={item} lang={lang} />)}
            </div>
          </details>
        )
      }
    </div>
  </div>
</section>
