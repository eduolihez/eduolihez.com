---
/**
 * <Footer /> - Pie minimalista con enlaces sociales y "volver arriba".
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const aboutPath = lang === 'en' ? '/en/about-this-website/' : (lang === 'ca' ? '/ca/sobre-aquesta-web/' : '/sobre-esta-web/');

/**
 * Proyectos publicados bajo /projects/.
 *
 * IMPORTANTE (SEO): antes de esto, ninguna pagina del sitio enlazaba a estas
 * webs, asi que para Google eran "paginas huerfanas": sin ningun enlace
 * entrante, un rastreador no tiene forma de llegar a ellas ni de repartirles
 * autoridad, por mucho que esten en el sitemap. Al ponerlas en el pie
 * aparecen en TODAS las paginas del portfolio, que es la forma estandar de
 * resolverlo.
 *
 * La seccion "Proyectos" de la portada se sirve desde MySQL y sus enlaces
 * dependen de lo que haya en la base de datos; esta lista es estatica a
 * proposito, para que la ruta de rastreo no dependa del backend.
 */
const projects = [
  { name: 'Fluence', href: '/projects/fluence/' },
  { name: 'FollowGuard', href: '/projects/followguard/' },
  { name: 'Password Sentinel', href: '/projects/passwdcentinel/' },
  { name: 'PromptMaster', href: '/projects/promptmaster/' },
  { name: 'Zéora', href: '/projects/zeora/' },
];
---

<footer class="border-t border-bg-border">
  {/* Proyectos publicados: da a Google (y a las IAs) una ruta de rastreo
      hacia cada web, presente en todas las paginas del sitio. */}
  <div class="container-page border-b border-bg-border/60 py-6">
    <p class="mb-3 font-mono text-[11px] uppercase tracking-wider text-text-faint">
      <a href="/projects/" class="transition hover:text-accent">{t('footer.projects')}</a>
    </p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        projects.map((p) => (
          <li>
            <a
              href={p.href}
              class="font-mono text-xs text-text-muted transition hover:text-accent"
            >
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="container-page flex flex-col items-center justify-between gap-4 py-8 sm:flex-row"
  >
    <div class="text-center font-mono text-xs text-text-faint sm:text-left">
      <p>&copy; {year} {SITE.shortName} · {t('footer.built')}</p>
      {/* La ubicacion visible tambien es una senal de SEO local: Google la
          cruza con el dato estructurado del <head> para confirmar la ciudad. */}
      <p class="mt-1">
        <span class="not-italic">{t('footer.location')}</span>
        <span aria-hidden="true"> · </span>
        <a class="transition hover:text-accent" href={`mailto:${SITE.social.email}`}>
          {SITE.social.email}
        </a>
      </p>
      <p class="mt-1.5">
        <a class="transition hover:text-accent text-accent font-medium" href={aboutPath}>
          {t('footer.aboutSite')} &rarr;
        </a>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={SITE.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md p-2 text-text-faint transition hover:text-accent"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" class="h-5 w-5" />
      </a>
      <a
        href={SITE.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md p-2 text-text-faint transition hover:text-accent"
        aria-label="GitHub"
      >
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a
        href={`mailto:${SITE.social.email}`}
        class="rounded-md p-2 text-text-faint transition hover:text-accent"
        aria-label="Email"
      >
        <Icon name="mail" class="h-5 w-5" />
      </a>
      <a
        href="#top"
        class="rounded-md p-2 text-text-faint transition hover:text-accent"
        aria-label={t('footer.backTop')}
      >
        <Icon name="arrowUp" class="h-5 w-5" />
      </a>
    </div>
  </div>
</footer>
