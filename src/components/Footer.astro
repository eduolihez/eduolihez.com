---
/**
 * <Footer /> - Pie minimalista con enlaces sociales y "volver arriba".
 */
import { useTranslations, localeBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Los enlaces de este pie apuntaban todos a "/", asi que desde /en/ o /ca/
// devolvian al visitante a la home castellana. <Header /> ya resolvia esto
// con localeBase(); el pie no.
const base = localeBase(lang);
const year = new Date().getFullYear();
const aboutPath = lang === 'en' ? '/en/about-this-website/' : (lang === 'ca' ? '/ca/sobre-aquesta-web/' : '/sobre-esta-web/');

/**
 * Proyectos publicados bajo /projects/.
 *
 * IMPORTANTE (SEO): antes de esto, ninguna pagina del sitio enlazaba a estas
 * webs, asi que para Google eran "paginas huerfanas": sin ningun enlace
 * entrante, un rastreador no tiene forma de llegar a ellas ni de repartirles
 * autoridad, por mucho que esten en el sitemap. Al ponerlas en el pie
 * aparecen en TODAS las paginas del portfolio, que es la forma estandar de
 * resolverlo.
 *
 * La seccion "Proyectos" de la portada se sirve desde MySQL y sus enlaces
 * dependen de lo que haya en la base de datos; esta lista es estatica a
 * proposito, para que la ruta de rastreo no dependa del backend.
 */
const projects = [
  {
    name: 'Password Sentinel',
    href: '/projects/passwdcentinel/',
    badgeKey: 'projects.badge.openSource',
    badgeType: 'open-source'
  },
  {
    name: 'PromptMaster',
    href: '/projects/promptmaster/',
    badgeKey: 'projects.badge.privateCode',
    badgeType: 'private-code'
  },
  {
    name: 'FollowGuard',
    href: '/projects/followguard/',
    badgeKey: 'projects.badge.openSource',
    badgeType: 'open-source'
  },
  {
    name: 'Blue Team Hub',
    href: 'https://eduolihez.github.io/',
    badgeKey: 'projects.badge.openSource',
    badgeType: 'open-source',
    external: true
  },
  {
    name: 'Fluence',
    href: '/projects/fluence/',
    badgeKey: 'projects.badge.privateCode',
    badgeType: 'private-code'
  },
  {
    name: 'Zéora',
    href: '/projects/zeora/',
    badgeKey: 'projects.badge.privateCode',
    badgeType: 'private-code'
  },
];
---

<footer class="relative border-t border-bg-border/60 bg-bg-soft/40 backdrop-blur-xs text-sm">
  <!-- Efecto de línea de resplandor superior sutil -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/25 to-transparent"></div>

  <div class="container-page py-16 grid gap-10 sm:grid-cols-2 md:grid-cols-4 relative z-10">
    <!-- Columna 1: Bio & Info de Marca -->
    <div class="flex flex-col gap-4">
      <div>
        <div class="font-mono font-bold text-base tracking-tight text-text-title">
          {SITE.name}
        </div>
        <p class="mt-1 text-xs text-text-muted leading-relaxed max-w-xs">
          {SITE.jobTitle}
        </p>
      </div>
      <p class="font-mono text-[11px] text-text-faint mt-auto pt-4 border-t border-bg-border/30">
        &copy; {year} {SITE.shortName}<br/>
        <span class="inline-block mt-1 opacity-75">{t('footer.built')}</span>
      </p>
    </div>

    <!-- Columna 2: Proyectos -->
    <div>
      <p class="mb-5 font-mono text-[11px] uppercase tracking-widest text-text-faint font-semibold">
        <a href="/projects/" class="transition hover:text-accent hover:no-underline">{t('footer.projects')}</a>
      </p>
      <ul class="flex flex-col gap-3">
        {
          projects.map((p) => (
            <li>
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent hover:no-underline"
              >
                <span class="border-b border-transparent group-hover:border-accent/30">{p.name}</span>
                {p.badgeKey && (
                  <span class={`rounded-xs px-1.5 py-px text-[10px] font-semibold font-sans tracking-wide leading-normal border transition-colors ${
                    p.badgeType === 'open-source' 
                      ? 'bg-oss/5 text-oss border-oss/15 group-hover:bg-oss/10' 
                      : p.badgeType === 'in-development'
                      ? 'bg-wip/5 text-wip border-wip/15 group-hover:bg-wip/10'
                      : 'bg-closed/5 text-closed border-closed/15 group-hover:bg-closed/10'
                  }`}>
                    {t(p.badgeKey as any)}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Columna 3: Navegación. Va en <nav> con nombre propio: la pagina solo
        declaraba el landmark de la cabecera, asi que un lector de pantalla no
        podia saltar a estos enlaces. El aria-label lo distingue del principal. */}
    <nav aria-label={t('footer.nav')}>
      <p class="mb-5 font-mono text-[11px] uppercase tracking-widest text-text-faint font-semibold">
        {t('footer.nav')}
      </p>
      <ul class="grid grid-cols-2 gap-x-3 gap-y-3 font-mono text-xs">
        <li><a href={`${base}#perfil`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.about')}</a></li>
        <li><a href={`${base}#experiencia`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.experience')}</a></li>
        <li><a href={`${base}#habilidades`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.skills')}</a></li>
        <li><a href={`${base}#proyectos`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.projects')}</a></li>
        <li><a href={`${base}#certificaciones`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.certifications')}</a></li>
        <li><a href={`${base}#faq`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.faq')}</a></li>
        <li><a href={`${base}#contacto`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.contact')}</a></li>
        <li><a href={`${base}blog/`} class="text-text-muted hover:text-accent transition hover:no-underline flex items-center gap-1 group"><span class="opacity-0 group-hover:opacity-100 transition-opacity text-accent text-[10px]">&rarr;</span>{t('nav.blog')}</a></li>
      </ul>
    </nav>

    <!-- Columna 4: Contacto & Redes -->
    <div class="flex flex-col gap-4">
      <div>
        <p class="mb-4 font-mono text-[11px] uppercase tracking-widest text-text-faint font-semibold">
          {t('footer.contact')}
        </p>
        <p class="text-xs text-text-muted font-mono leading-relaxed">
          <span class="not-italic block mb-1 text-text-faint">{t('footer.location')}</span>
          <a class="transition hover:text-accent block font-semibold" href={`mailto:${SITE.social.email}`}>
            {SITE.social.email}
          </a>
        </p>
      </div>
      
      <div class="flex items-center gap-2">
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-bg-border bg-bg-card/40 text-text-faint transition duration-200 hover:-translate-y-0.5 hover:bg-accent/10 hover:text-accent hover:border-accent/30"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" class="h-4 w-4" />
        </a>
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-bg-border bg-bg-card/40 text-text-faint transition duration-200 hover:-translate-y-0.5 hover:bg-accent/10 hover:text-accent hover:border-accent/30"
          aria-label="GitHub"
        >
          <Icon name="github" class="h-4 w-4" />
        </a>
        <a
          href={`mailto:${SITE.social.email}`}
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-bg-border bg-bg-card/40 text-text-faint transition duration-200 hover:-translate-y-0.5 hover:bg-accent/10 hover:text-accent hover:border-accent/30"
          aria-label="Email"
        >
          <Icon name="mail" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-auto flex flex-col gap-2 pt-4 border-t border-bg-border/30">
        <a class="transition hover:text-accent text-accent font-mono text-xs font-semibold hover:no-underline flex items-center gap-1 group" href={aboutPath}>
          <span>{t('footer.aboutSite')}</span>
          <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
        <a
          href="#top"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-text-muted hover:text-accent transition hover:no-underline"
        >
          <Icon name="arrowUp" class="h-3.5 w-3.5" />
          <span>{t('footer.backTop')}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
