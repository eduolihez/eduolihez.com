---
/**
 * <Footer /> - Pie compacto: marca, contacto, proyectos publicados y una barra
 * final. La navegacion por secciones vive en la cabecera y en la paleta
 * (Ctrl/Cmd+K); repetirla aqui solo añadia ruido.
 */
import { useTranslations, localeBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Los enlaces del pie apuntaban todos a "/", asi que desde /en/ o /ca/
// devolvian al visitante a la home castellana: se resuelven con localeBase().
const base = localeBase(lang);
const year = new Date().getFullYear();
const aboutPath =
  lang === 'en' ? '/en/about-this-website/' : lang === 'ca' ? '/ca/sobre-aquesta-web/' : '/sobre-esta-web/';

/**
 * Proyectos publicados bajo /projects/ y /apps/.
 *
 * IMPORTANTE (SEO): estas paginas no tienen otro enlace entrante estatico (la
 * seccion "Proyectos" de la portada se sirve desde MySQL), asi que sin esta
 * lista serian "paginas huerfanas" para un rastreador. Por eso se mantiene en
 * TODAS las paginas, como HTML estatico, sin depender del backend.
 */
const projects = [
  { name: 'Password Centinel', href: '/apps/password-centinel/' },
  { name: 'PromptMaster', href: '/apps/prompt-master/' },
  { name: 'NoWait', href: '/apps/nowait/' },
  { name: 'FollowGuard', href: '/projects/followguard/' },
  { name: 'Fluence', href: '/projects/fluence/' },
  { name: 'Zéora', href: '/projects/zeora/' },
  { name: 'Blue Team Hub', href: 'https://eduolihez.github.io/', external: true },
];

const social = [
  { label: 'LinkedIn', href: SITE.social.linkedin, icon: 'linkedin', external: true },
  { label: 'GitHub', href: SITE.social.github, icon: 'github', external: true },
  { label: t('hero.cta.cv'), href: SITE.cv[lang] ?? SITE.cv.es, icon: 'download', external: false },
];
---

<footer class="border-t border-bg-border bg-bg-soft text-sm">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:gap-16">
    <!-- Marca y contacto -->
    <div>
      <a href={base} class="font-mono text-sm font-semibold tracking-tight text-text-title">
        EO <span class="text-accent">//</span> <span class="font-medium text-text-muted">security</span>
      </a>
      <p class="mt-3 max-w-sm text-text-muted">{SITE.jobTitle}</p>

      <p class="mt-4 flex items-center gap-2 font-mono text-xs text-text-muted">
        <Icon name="location" class="h-3.5 w-3.5 shrink-0 text-text-faint" />
        {t('footer.location')}
      </p>
      <a
        href={`mailto:${SITE.social.email}`}
        class="mt-1.5 flex items-center gap-2 font-mono text-xs font-semibold text-text transition hover:text-accent"
      >
        <Icon name="mail" class="h-3.5 w-3.5 shrink-0 text-text-faint" />
        {SITE.social.email}
      </a>

      <ul class="mt-5 flex flex-wrap gap-2" aria-label={t('footer.contact')}>
        {
          social.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.external ? '_blank' : undefined}
                rel={s.external ? 'noopener noreferrer' : undefined}
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-bg-border bg-bg-card text-text-muted transition hover:border-accent hover:text-accent"
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Proyectos publicados (enlaces estaticos: ver nota de SEO arriba) -->
    <nav aria-label={t('footer.projects')}>
      <p class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-text-faint">
        <a href="/projects/" class="transition hover:text-accent">{t('footer.projects')}</a>
      </p>
      <ul class="grid gap-x-8 gap-y-2.5 font-mono text-xs sm:grid-cols-2">
        {
          projects.map((p) => (
            <li>
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-2 text-text-muted transition hover:text-accent"
              >
                <Icon
                  name={p.external ? 'external' : 'arrowRight'}
                  class="h-3 w-3 shrink-0 text-text-faint transition group-hover:text-accent"
                />
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Barra final -->
  <div class="border-t border-bg-border">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4 font-mono text-xs text-text-faint">
      <p>
        &copy; {year} {SITE.shortName}
        <span aria-hidden="true">·</span>
        <a href={aboutPath} class="transition hover:text-accent">{t('footer.aboutSite')}</a>
      </p>
      <div class="flex items-center gap-5">
        <button
          type="button"
          data-palette-open
          class="hidden items-center gap-1.5 transition hover:text-accent sm:inline-flex"
          aria-label={t('palette.open')}
        >
          <Icon name="terminal" class="h-3.5 w-3.5" />
          <span aria-hidden="true">⌘K</span>
        </button>
        <a href="#top" class="inline-flex items-center gap-1.5 transition hover:text-accent">
          <Icon name="arrowUp" class="h-3.5 w-3.5" />
          {t('footer.backTop')}
        </a>
      </div>
    </div>
  </div>
</footer>
