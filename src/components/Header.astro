---
/**
 * Header - Cabecera fija minimalista con navegacion por anclas, selector
 * de idioma (ES/EN/CA) y menu movil. El JS va en un script externo procesado
 * por Astro (compatible con la CSP estricta).
 */
import { useTranslations, localeBase } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
import { SITE } from '../config';
import Announcement from './Announcement.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localeBase(lang);

// Menu movil y paleta: todas las secciones.
const nav = [
  { href: `${base}#experiencia`, label: t('nav.experience') },
  { href: `${base}#habilidades`, label: t('nav.skills') },
  { href: `${base}#proyectos`, label: t('nav.projects') },
  { href: `${base}#certificaciones`, label: t('nav.certifications') },
  // Con la barra final: la web se compila con build.format 'directory', asi
  // que la pagina real es /blog/. Sin la barra, Apache responde un 301 a
  // /blog/ en cada clic (un salto de mas) y el enlace interno deja de
  // coincidir con la canonica que declara la propia pagina.
  // Solo en espanol y catalan: el blog no tiene contenido en ingles todavia
  // (ver BlogPreview.astro), asi que un enlace a un listado vacio en ese idioma
  // solo genera contenido fino y confunde al visitante.
  ...(lang === 'es' || lang === 'ca' ? [{ href: `${base}blog/`, label: t('nav.blog') }] : []),
  { href: `${base}#faq`, label: t('nav.faq') },
  { href: `${base}#contacto`, label: t('nav.contact') },
];

// Barra de escritorio: solo lo esencial. Certificaciones y FAQ siguen a un
// Ctrl+K de distancia (paleta) y en el menu movil.
const DESKTOP_HIDDEN = new Set([`${base}#certificaciones`, `${base}#faq`]);
const desktopNav = nav.filter((item) => !DESKTOP_HIDDEN.has(item.href));

// Enlaces de idioma (a la home de cada idioma).
const langLinks: { code: Lang; href: string }[] = [
  { code: 'es', href: '/' },
  { code: 'en', href: '/en/' },
  { code: 'ca', href: '/ca/' },
];

const flagSvgs = {
  es: `<svg class="h-3 w-4 rounded-xs" viewBox="0 0 750 500" aria-hidden="true" fill="none"><rect width="750" height="500" fill="#c60b1e"/><rect y="125" width="750" height="250" fill="#f1bf00"/></svg>`,
  en: `<svg class="h-3 w-4 rounded-xs" viewBox="0 0 60 30" aria-hidden="true" fill="none"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/><path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/><path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/></svg>`,
  ca: `<svg class="h-3 w-4 rounded-xs" viewBox="0 0 9 6" aria-hidden="true" fill="none"><rect width="9" height="6" fill="#FCDD09"/><rect y="0.67" width="9" height="0.67" fill="#DA121A"/><rect y="2" width="9" height="0.67" fill="#DA121A"/><rect y="3.33" width="9" height="0.67" fill="#DA121A"/><rect y="4.67" width="9" height="0.67" fill="#DA121A"/></svg>`,
};
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-bg-border/60 bg-bg/80 backdrop-blur-md"
>
  <!-- Aviso opcional, controlado desde /admin -> Ajustes. Va DENTRO de la
       cabecera fija: si estuviera fuera, la cabecera lo taparia al estar
       posicionada sobre el. Cuando no hay aviso, no ocupa nada. -->
  <Announcement lang={lang} />

  <nav
    class="container-page flex h-14 items-center justify-between"
    aria-label="Principal"
  >
    <a
      href={base}
      class="mr-4 shrink-0 font-mono text-sm font-semibold tracking-tight text-text-title"
      aria-label={`${SITE.shortName} — ${t('nav.about')}`}
    >
      EO <span class="text-accent">//</span> <span class="font-medium text-text-muted">security</span>
    </a>

    {/* lg (1024px), no md (768px): a 768px el logo + 7 enlaces + icono de
        GitHub + selector de idioma no caben con margen -- se midio el
        selector de idioma desaparecer del todo en esa franja (ver auditoria
        visual). lg da holgura real en vez de quedar al filo. */}
    <ul class="hidden items-center gap-1 lg:flex">
      {
        desktopNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-md px-2.5 py-2 text-sm text-text-muted transition hover:text-text"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <!-- Paleta de comandos (Ctrl/Cmd+K) -->
      <button
        type="button"
        data-palette-open
        class="bar-btn hidden gap-1.5 px-2.5 py-1.5 font-mono text-xs sm:inline-flex"
        aria-label={t('palette.open')}
        aria-keyshortcuts="Control+K Meta+K"
      >
        <Icon name="search" class="h-3.5 w-3.5" />
        <span aria-hidden="true" class="text-accent" data-shortcut-mod>Ctrl</span><span aria-hidden="true">K</span>
      </button>

      <!-- Tema claro/oscuro: por defecto sigue al sistema; al pulsar se guarda. -->
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        class="bar-btn inline-flex p-2"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <Icon name="moon" class="theme-icon-moon h-4 w-4" />
        <Icon name="sun" class="theme-icon-sun h-4 w-4" />
      </button>

      <!-- Selector de idioma (dropdown) -->
      <div class="relative">
        <button
          id="lang-toggle"
          type="button"
          class="bar-btn inline-flex gap-2 px-2.5 py-1.5 font-mono text-xs font-medium"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label={`${t('nav.language')}: ${lang.toUpperCase()}`}
        >
          <span class="flex items-center shrink-0 select-none" set:html={flagSvgs[lang]} />
          <span>{lang.toUpperCase()}</span>
          <svg class="h-3 w-3 text-text-faint" viewBox="0 0 24 24" aria-hidden="true"
            ><path fill="currentColor" d="m7 10 5 5 5-5Z"></path></svg
          >
        </button>
        <ul
          id="lang-menu"
          class="absolute right-0 mt-1 hidden min-w-[9rem] overflow-hidden rounded-md border border-bg-border bg-bg-card py-1 shadow-xl"
          role="menu"
        >
          {
            langLinks.map((l) => (
              <li role="none">
                <a
                  role="menuitem"
                  href={l.href}
                  class={`flex items-center px-3 py-2 text-sm transition hover:bg-bg-soft ${
                    l.code === lang ? 'text-accent' : 'text-text-muted hover:text-text'
                  }`}
                >
                  <span class="flex items-center shrink-0 select-none" set:html={flagSvgs[l.code]} />
                  <span class="font-mono text-xs ml-2">{l.code.toUpperCase()}</span>
                  <span class="ml-2">{languages[l.code]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Boton menu movil -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-text-muted transition hover:text-text lg:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
          ><path fill="currentColor" d="M3 6h18v2H3m0 5h18v-2H3m0 7h18v-2H3Z"></path></svg
        >
      </button>
    </div>
  </nav>

  <!-- Menu movil -->
  <div id="mobile-menu" class="hidden border-t border-bg-border bg-bg lg:hidden">
    <ul class="container-page space-y-1 py-4">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-link block rounded-md px-3 py-2.5 text-base text-text-muted transition hover:bg-bg-soft hover:text-text"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  /* Misma estetica para el atajo, el tema y el idioma. */
  .bar-btn {
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid var(--color-bg-border);
    background: var(--color-bg-card);
    color: var(--color-text-muted);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }
  .bar-btn:hover {
    border-color: var(--color-bg-border-hover);
    color: var(--color-text);
  }
  .bar-btn:active {
    transform: scale(0.96);
  }
</style>

<script>
  // Menu movil + dropdown de idioma (procesado por Astro -> externo, CSP 'self').
  function initHeader() {
    const menuToggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (menuToggle && menu) {
      const close = () => {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      };
      menuToggle.addEventListener('click', () => {
        const open = !menu.classList.contains('hidden');
        if (open) close();
        else {
          menu.classList.remove('hidden');
          menuToggle.setAttribute('aria-expanded', 'true');
        }
      });
      menu.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', close));
    }

    const langToggle = document.getElementById('lang-toggle');
    const langMenu = document.getElementById('lang-menu');
    if (langToggle && langMenu) {
      const closeLang = () => {
        langMenu.classList.add('hidden');
        langToggle.setAttribute('aria-expanded', 'false');
      };
      langToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !langMenu.classList.contains('hidden');
        if (open) closeLang();
        else {
          langMenu.classList.remove('hidden');
          langToggle.setAttribute('aria-expanded', 'true');
        }
      });
      // Cierra al hacer clic fuera o con Escape.
      document.addEventListener('click', closeLang);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLang();
      });
    }
  }
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
