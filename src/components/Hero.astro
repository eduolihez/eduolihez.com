---
/**
 * <Hero /> - Perfil. Cuadricula de fondo, titular en mono con una linea
 * serif cursiva, bloque tipo terminal y, a la derecha, una tarjeta con la
 * foto y el flujo de triaje (diagrama, no datos en vivo).
 *
 * "Disponible" se oculta solo si en el panel pones open_to_work=0 (lo
 * comprueba el script de abajo via /api/settings.php, sin recompilar).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE, api } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const cvHref = SITE.cv[lang] ?? SITE.cv.es;
// Misma URL (con lang) que Announcement y Contact: getSettings() comparte una
// sola peticion por URL, y con URLs distintas volverian a ser dos.
const settingsUrl = api(`/api/settings.php?lang=${lang}`);

// Etapas del flujo de triaje. Los textos salen de tu experiencia real (ver
// src/data/experience.ts); es un diagrama del proceso, no datos en vivo.
const flow = [
  { icon: 'logs', title: t('hero.flow.logs'), sub: t('hero.flow.logs.sub') },
  { icon: 'shield', title: t('hero.flow.xdr'), sub: t('hero.flow.xdr.sub') },
  { icon: 'search', title: t('hero.flow.triage'), sub: t('hero.flow.triage.sub') },
  { icon: 'bolt', title: t('hero.flow.response'), sub: t('hero.flow.response.sub') },
];
---

<section id="perfil" class="relative overflow-hidden" data-settings={settingsUrl}>
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    class="container-page relative grid gap-12 pb-16 pt-28 sm:pt-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-center lg:gap-14"
  >
    <div>
      <p style="--i:0" class="boot-line flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-[0.18em] text-text-muted">
        <span id="hero-status" class="inline-flex items-center gap-2 text-accent">
          <span class="sig-dot h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t('hero.status')}
        </span>
      </p>

      <h1
        style="--i:1"
        class="boot-line mt-5 font-mono text-[clamp(2rem,4.6vw,3.25rem)] font-bold leading-[1.05] tracking-tight text-text-title"
      >
        {SITE.name}
      </h1>

      <p style="--i:2" class="boot-line mt-5 font-serif text-2xl italic leading-snug text-text sm:text-3xl">
        {t('hero.lead')} <span class="text-accent">{t('hero.lead.em')}</span>
      </p>

      <p style="--i:3" class="boot-line mt-5 font-mono text-sm leading-relaxed text-accent">{t('hero.role')}</p>

      <p style="--i:4" class="boot-line mt-4 max-w-xl text-base leading-relaxed text-text-muted">
        {t('hero.tagline')}
      </p>

      <div style="--i:5" class="boot-line mt-8 flex flex-wrap gap-3">
        <a href="#contacto" class="btn-primary">{t('hero.cta.contact')}</a>
        <button id="cv-download-btn" type="button" class="btn-ghost">
          <Icon name="download" class="h-4 w-4" />
          {t('hero.cta.cv')}
        </button>
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <Icon name="linkedin" class="h-4 w-4" />
          {t('hero.cta.linkedin')}
        </a>
        <button type="button" data-palette-open class="btn-ghost hidden font-mono sm:inline-flex">
          <span class="text-accent" aria-hidden="true"><span data-shortcut-mod>Ctrl</span> K</span>
          {t('hero.cta.palette')}
        </button>
      </div>

      <!-- Bloque tipo terminal: texto estatico y verificable, sin metricas inventadas. -->
      <div style="--i:6" class="boot-line mt-9 space-y-1 font-mono text-xs leading-relaxed text-text-muted">
        <p><span class="text-accent" aria-hidden="true">$</span> whoami</p>
        <p><span class="text-accent" aria-hidden="true">→</span> {SITE.jobTitle}</p>
        <p><span class="text-accent" aria-hidden="true">$</span> stack</p>
        <p><span class="text-accent" aria-hidden="true">→</span> Trend Micro Vision One · Fortinet · Python · IAM</p>
        <p><span class="text-accent" aria-hidden="true">$</span> pwd</p>
        <p><span class="text-accent" aria-hidden="true">→</span> {t('hero.location')} · {t('hero.languages')}</p>
      </div>
    </div>

    <!-- Tarjeta: foto + diagrama del flujo de triaje -->
    <div class="boot-line relative" style="--i:3">
      <div
        class="rounded-2xl border border-bg-border bg-bg-card p-5"
        style="box-shadow: var(--shadow-card)"
      >
        <div class="flex items-center gap-4">
          <div class="relative shrink-0">
            <img
              id="avatar-img"
              src={SITE.avatar}
              alt={`${t('hero.photoAlt')} ${SITE.name}`}
              width="72"
              height="72"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-[72px] w-[72px] rounded-2xl border border-bg-border object-cover"
            />
            <span
              class="absolute -bottom-1 -right-1 grid h-5 w-5 place-items-center rounded-full border-2 border-bg-card bg-bg-card"
              aria-hidden="true"
            >
              <span class="sig-dot h-2.5 w-2.5 rounded-full bg-accent"></span>
            </span>
          </div>
          <div class="min-w-0">
            <p class="truncate font-semibold text-text-title">{SITE.shortName}</p>
            <p class="font-mono text-xs text-text-faint">{t('hero.card.role')}</p>
            <ul class="mt-2 flex flex-wrap gap-1.5" aria-label={t('hero.card.focus')}>
              {
                ['SOC', 'Cloud', 'IAM', 'AI Sec'].map((chip) => (
                  <li class="rounded-full border border-accent/30 bg-accent-soft px-2 py-0.5 font-mono text-[10px] text-accent">
                    {chip}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="mt-6 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-text-faint">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          {t('hero.flow.label')}
        </p>

        <div class="relative mt-4">
          <!-- Linea que une las etapas y pulso de señal que la recorre -->
          <span class="absolute bottom-5 left-[17px] top-5 w-0.5 overflow-hidden rounded-full bg-bg-border" aria-hidden="true">
            <span class="flow-pulse block h-full w-full bg-gradient-to-b from-transparent via-accent to-transparent"></span>
          </span>
          <ol class="relative space-y-5" aria-label={t('hero.flow.label')}>
          {
            flow.map((step, i) => (
              <li class="flow-step relative flex items-center gap-3.5" style={`--s:${i}`}>
                <span
                  class={`grid h-9 w-9 shrink-0 place-items-center rounded-lg border ${
                    i === flow.length - 1
                      ? 'border-accent/50 bg-accent-soft text-accent'
                      : 'border-bg-border bg-bg-card text-text-muted'
                  }`}
                >
                  <Icon name={step.icon} class="h-[18px] w-[18px]" />
                </span>
                <span class="min-w-0">
                  <span class="block font-mono text-[13px] font-semibold leading-tight text-text-title">
                    <span class="text-text-faint" aria-hidden="true">0{i + 1}</span> {step.title}
                  </span>
                  <span class="mt-0.5 block text-xs leading-snug text-text-muted">{step.sub}</span>
                </span>
              </li>
            ))
          }
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal para CV en actualización -->
  <div id="cv-modal" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="cv-modal-title">
    <div class="relative max-h-[85vh] w-full max-w-md overflow-y-auto rounded-xl border border-bg-border bg-bg-card p-6 shadow-2xl">
      <button id="cv-modal-close" type="button" class="absolute right-3 top-3 rounded-md p-1.5 text-text-muted transition hover:bg-bg-soft hover:text-text" aria-label={t('projects.close')}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z"></path>
        </svg>
      </button>

      <div class="flex flex-col items-center text-center mt-4 font-mono">
        <span class="relative flex h-12 w-12 items-center justify-center rounded-full bg-accent/10 text-accent mb-4 border border-accent/20">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent/5 opacity-75"></span>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" class="text-accent animate-pulse">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
          </svg>
        </span>

        <h2 class="text-lg font-bold text-text uppercase tracking-wider" id="cv-modal-title">{t('cv.modal.title')}</h2>

        <p class="mt-4 text-sm text-text-muted leading-relaxed" id="cv-modal-body">
          {t('cv.modal.body')}
        </p>

        <div class="mt-6 rounded-sm border border-bg-border bg-bg-soft/50 p-3 text-xs text-text-faint w-full">
          <span>Status: OPTIMIZING_CV // Severity: INFO</span>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row gap-3 w-full">
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-primary flex-1 font-sans text-xs flex items-center justify-center gap-2">
            <Icon name="linkedin" class="h-4 w-4" />
            {t('cv.modal.linkedin')}
          </a>
          <a href={`mailto:${SITE.social.email}`} class="btn-ghost flex-1 font-sans text-xs flex items-center justify-center gap-2">
            <Icon name="mail" class="h-4 w-4" />
            {t('cv.modal.email')}
          </a>
        </div>
        <button type="button" id="cv-modal-btn-close" class="btn-ghost mt-3 w-full font-sans text-xs">
          {t('cv.modal.close')}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { getSettings } from '../scripts/shared';

  // Oculta "Disponible" si en el panel open_to_work=0. Si la API falla se
  // deja visible (mismo comportamiento que antes: disponible por defecto).
  function initAvailability() {
    const section = document.getElementById('perfil');
    const status = document.getElementById('hero-status');
    const url = section?.getAttribute('data-settings');
    if (!status || !url) return;

    getSettings(url)
      .then((data) => {
        const closed = data && String((data as { open_to_work?: unknown }).open_to_work) === '0';
        status.classList.toggle('hidden', Boolean(closed));
      })
      .catch(() => status.classList.remove('hidden'));
  }

  // Lógica del modal de CV en actualización
  function initCvModal() {
    const btn = document.getElementById('cv-download-btn');
    const modal = document.getElementById('cv-modal');
    const closeBtn = document.getElementById('cv-modal-close');
    const closeBtn2 = document.getElementById('cv-modal-btn-close');

    if (!btn || !modal) return;

    const showModal = () => {
      modal.removeAttribute('hidden');
      void modal.offsetWidth; // force reflow
      modal.classList.add('open');
      document.body.style.overflow = 'hidden'; // block scroll
    };

    const hideModal = () => {
      modal.classList.remove('open');
      setTimeout(() => {
        if (!modal.classList.contains('open')) {
          modal.setAttribute('hidden', '');
          document.body.style.overflow = ''; // restore scroll
        }
      }, 200); // match transition speed
    };

    btn.addEventListener('click', showModal);
    if (closeBtn) closeBtn.addEventListener('click', hideModal);
    if (closeBtn2) closeBtn2.addEventListener('click', hideModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        hideModal();
      }
    });
  }

  // Inicialización
  function initAll() {
    initAvailability();
    initCvModal();
  }

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
