---
/**
 * <Hero /> - Portada "Expediente": banda en tinta (--ink, igual en ambos
 * temas). Izquierda: nombre, rol, una frase, CTAs y metadato (ubicacion,
 * idiomas, disponibilidad). Derecha: la ficha <EvidenceCard /> con el puesto
 * actual y las evidencias E-nn enlazadas a su fuente. Sin terminal ni datos
 * en vivo; funciona sin JS y sin PHP.
 *
 * "Disponible" se oculta si en el panel pones open_to_work=0 (lo comprueba
 * el script de abajo via /api/settings.php, sin recompilar). Vive en un hueco
 * de altura fija para que ocultarlo no mueva nada (CLS).
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE, api } from '../config';
import Icon from './Icon.astro';
import EvidenceCard from './EvidenceCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Misma URL (con lang) que Announcement y Contact: getSettings() comparte una
// sola peticion por URL, y con URLs distintas volverian a ser dos.
const settingsUrl = api(`/api/settings.php?lang=${lang}`);
---

<section id="perfil" class="hero-band" data-settings={settingsUrl}>
  <!-- Movil: principal -> ficha -> metadato (la ficha justo tras los CTAs).
       Escritorio: principal y metadato a la izquierda, ficha a la derecha. -->
  <div class="hero-layout container-page pb-12 pt-20 sm:pt-28 lg:pb-20">
    <div class="hero-ink hero-main min-w-0">
      <h1 class="text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.02] tracking-[-0.035em] text-text-title">
        {SITE.name}
      </h1>
      <p class="mt-4 text-base font-medium leading-snug text-text sm:text-lg">{t('hero.role.short')}</p>
      <p class="mt-4 max-w-[34ch] text-xl leading-snug text-text-muted sm:text-2xl">
        {t('hero.lead')} <span class="font-semibold text-text-title">{t('hero.lead.em')}</span>
      </p>

      <div class="hero-ctas mt-6 sm:mt-8">
        <a href="#contacto" class="btn-primary">{t('hero.cta.contact')}</a>
        <button type="button" class="btn-ghost" data-cv-open aria-haspopup="dialog" aria-controls="cv-modal">
          <Icon name="download" class="h-4 w-4" />
          {t('hero.cta.cv')}
        </button>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">
          <Icon name="linkedin" class="h-4 w-4" />
          {t('hero.cta.linkedin')}
        </a>
      </div>
      <a href={`mailto:${SITE.social.email}`} class="hero-mail">
        <Icon name="mail" class="h-4 w-4 shrink-0" />
        {SITE.social.email}
      </a>
    </div>

    <EvidenceCard lang={lang} />

    <div class="hero-ink hero-aside min-w-0">
      <ul class="hero-meta" aria-label={t('hero.meta')}>
        <li><Icon name="location" class="h-4 w-4 shrink-0" />{t('hero.location')}</li>
        <li><Icon name="languages" class="h-4 w-4 shrink-0" />{t('hero.languages')}</li>
      </ul>
      <p class="hero-status-slot mt-3">
        <span id="hero-status" class="hero-status">{t('hero.status')}</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { getSettings } from '../scripts/shared';

  // Oculta "Disponible" si en el panel open_to_work=0. Si la API falla se
  // deja visible (mismo comportamiento que antes: disponible por defecto).
  function initAvailability() {
    const section = document.getElementById('perfil');
    const status = document.getElementById('hero-status');
    const url = section?.getAttribute('data-settings');
    if (!status || !url) return;

    getSettings(url)
      .then((data) => {
        const closed = data && String((data as { open_to_work?: unknown }).open_to_work) === '0';
        status.classList.toggle('hidden', Boolean(closed));
      })
      .catch(() => status.classList.remove('hidden'));
  }

  initAvailability();
  document.addEventListener('astro:page-load', initAvailability);
</script>
