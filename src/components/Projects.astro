---
/**
 * <Projects /> - Isla dinamica (lee de MySQL via PHP). Minimalista.
 * - Script PROCESADO por Astro (externo) -> compatible con CSP estricta.
 * - safeUrl(): sanea las URLs de la BD (bloquea javascript:, S3).
 * - Modal de detalle accesible (F6): descripcion larga, stack y enlaces.
 * Config (endpoint + textos) se pasa por data-* en #projects-grid.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';
import { fetchProjectSummaries } from '../lib/projects';
import { safeUrl } from '../scripts/shared';
import StatusPanel from './StatusPanel.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/projects.php?lang=${lang}`);

// Primer pintado en build-time (ver src/lib/projects.ts): initProjects()
// vacia y reconstruye #projects-grid en cuanto carga, esto solo evita que un
// rastreador sin JS -- o el primer frame para todos los demas -- vea el
// contenedor vacio.
const ssrProjects = await fetchProjectSummaries(lang);
const labels = {
  loading: t('projects.loading'),
  error: t('projects.error'),
  empty: t('projects.empty'),
  repo: t('projects.repo'),
  demo: t('projects.demo'),
  featured: t('projects.featured'),
  details: t('projects.details'),
  close: t('projects.close'),
  badgeOpenSource: t('projects.badge.openSource'),
  badgeInDevelopment: t('projects.badge.inDevelopment'),
  badgePrivateCode: t('projects.badge.privateCode'),
};
---

<section id="proyectos" class="border-b border-bg-border bg-bg-soft py-14 sm:py-16">
  <div class="container-page">
    <div class="reveal mb-8">
      <h2 class="section-title">{t('projects.title')}</h2>
      <p class="section-subtitle">{t('projects.subtitle')}</p>
    </div>

    <!-- Filtros de Proyectos -->
    <div id="projects-filters" class="hidden mb-6 flex flex-wrap gap-2">
      <button type="button" class="project-filter-btn is-active" aria-pressed="true" data-filter="all">
        {t('projects.filter.all')}
      </button>
      <button type="button" class="project-filter-btn" aria-pressed="false" data-filter="open-source">
        {t('projects.filter.openSource')}
      </button>
      <button type="button" class="project-filter-btn" aria-pressed="false" data-filter="in-development">
        {t('projects.filter.inDevelopment')}
      </button>
      <button type="button" class="project-filter-btn" aria-pressed="false" data-filter="private-code">
        {t('projects.filter.privateCode')}
      </button>
    </div>

    <!-- Reserva de alto: cargando, vacio y error ocupan lo mismo que una fila de tarjetas. -->
    <div class="projects-body">
      <StatusPanel
        id="projects-status"
        class={ssrProjects.length ? 'hidden' : ''}
        loadingText={t('projects.loading')}
        retryText={t('status.retry')}
      />

      <div
        id="projects-grid"
        class="grid gap-4 md:grid-cols-2"
        data-api={apiUrl}
        data-labels={JSON.stringify(labels)}
      >
        {ssrProjects.map((p, i) => (
          <article class:list={['project-card flex flex-col rounded-lg border border-bg-border bg-bg-card p-5', { 'is-lead': i === 0 }]}>
            <h3 class="text-base font-semibold text-text">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">{p.summary}</p>
            {p.stack?.length ? (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.stack.map((s) => (
                  <li class="rounded-sm border border-bg-border bg-bg-soft/20 px-1.5 py-0.5 font-mono text-[11px] text-text-muted">{s}</li>
                ))}
              </ul>
            ) : null}
            <div class="mt-auto flex flex-wrap items-center gap-x-4 pt-4">
              {safeUrl(p.repo_url) && (
                <a href={safeUrl(p.repo_url)} class="project-link" target="_blank" rel="noopener noreferrer">
                  {labels.repo}
                </a>
              )}
              {safeUrl(p.demo_url) && (
                <a href={safeUrl(p.demo_url)} class="project-link" target="_blank" rel="noopener noreferrer">
                  {labels.demo}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div id="projects-show-more-wrap" class="mt-6 hidden flex justify-center">
      <button
        type="button"
        id="projects-show-more"
        aria-expanded="false"
        data-label-more={t('projects.showAll')}
        data-label-less={t('projects.showLess')}
        class="btn-ghost min-h-11 cursor-pointer"
      >
        {t('projects.showAll')}
      </button>
    </div>
  </div>

  <!-- Modal de detalle -->
  <div
    id="project-modal"
    class="modal-backdrop"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="pm-title"
  >
    <div
      class="relative max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-lg border border-bg-border bg-bg-card p-6"
    >
      <button
        id="pm-close"
        type="button"
        class="absolute right-1 top-1 inline-flex h-11 w-11 items-center justify-center rounded-md text-text-muted transition hover:bg-bg-soft hover:text-text"
        aria-label="Cerrar"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z"
          ></path></svg
        >
      </button>
      <img
        id="pm-image"
        class="mb-4 hidden aspect-video w-full rounded-lg border border-bg-border object-cover"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
      />
      <h3 id="pm-title" class="pr-8 text-lg font-semibold text-text"></h3>
      <p id="pm-desc" class="mt-3 whitespace-pre-line text-sm leading-relaxed text-text-muted"></p>
      <ul id="pm-stack" class="mt-4 flex flex-wrap gap-1.5"></ul>
      <div id="pm-links" class="mt-5 flex flex-wrap gap-2"></div>
    </div>
  </div>
</section>

<script>
  import { initProjects } from '../scripts/projects';
  initProjects();
  document.addEventListener('astro:page-load', initProjects);
</script>
