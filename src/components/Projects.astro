---
/**
 * <Projects /> - Isla dinamica (lee de MySQL via PHP). Minimalista.
 * - Script PROCESADO por Astro (externo) -> compatible con CSP estricta.
 * - safeUrl(): sanea las URLs de la BD (bloquea javascript:, S3).
 * - Modal de detalle accesible (F6): descripcion larga, stack y enlaces.
 * Config (endpoint + textos) se pasa por data-* en #projects-grid.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { api } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const apiUrl = api(`/api/projects.php?lang=${lang}`);
const labels = {
  loading: t('projects.loading'),
  error: t('projects.error'),
  empty: t('projects.empty'),
  repo: t('projects.repo'),
  demo: t('projects.demo'),
  featured: t('projects.featured'),
  details: t('projects.details'),
  close: t('projects.close'),
  badgeOpenSource: t('projects.badge.openSource'),
  badgeInDevelopment: t('projects.badge.inDevelopment'),
  badgePrivateCode: t('projects.badge.privateCode'),
};
---

<section id="proyectos" class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
  <div class="container-page">
    <div class="reveal mb-12">
      <p class="section-kicker">{t('kicker.projects')}</p>
      <h2 class="section-title">{t('projects.title')}</h2>
      <p class="section-subtitle">{t('projects.subtitle')}</p>
    </div>

    <!-- Filtros de Proyectos -->
    <div
      id="projects-filters"
      class="hidden mb-8 flex flex-wrap gap-2 animate-fade-in"
    >
      <button
        type="button"
        class="project-filter-btn px-4 py-1.5 text-xs font-semibold rounded-lg bg-accent text-bg transition duration-200 border border-accent shadow-xs cursor-pointer"
        data-filter="all"
      >
        {t('projects.filter.all')}
      </button>
      <button
        type="button"
        class="project-filter-btn px-4 py-1.5 text-xs font-semibold rounded-lg bg-bg-soft/40 text-text-muted transition duration-200 border border-bg-border/60 hover:bg-bg-card hover:text-text shadow-xs cursor-pointer"
        data-filter="open-source"
      >
        {t('projects.filter.openSource')}
      </button>
      <button
        type="button"
        class="project-filter-btn px-4 py-1.5 text-xs font-semibold rounded-lg bg-bg-soft/40 text-text-muted transition duration-200 border border-bg-border/60 hover:bg-bg-card hover:text-text shadow-xs cursor-pointer"
        data-filter="in-development"
      >
        {t('projects.filter.inDevelopment')}
      </button>
      <button
        type="button"
        class="project-filter-btn px-4 py-1.5 text-xs font-semibold rounded-lg bg-bg-soft/40 text-text-muted transition duration-200 border border-bg-border/60 hover:bg-bg-card hover:text-text shadow-xs cursor-pointer"
        data-filter="private-code"
      >
        {t('projects.filter.privateCode')}
      </button>
    </div>

    <div id="projects-status" class="reveal is-visible flex items-center gap-3 text-sm text-text-muted">
      <span
        class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
      ></span>
      <span id="projects-status-text">{t('projects.loading')}</span>
    </div>

    <div
      id="projects-grid"
      class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      data-api={apiUrl}
      data-labels={JSON.stringify(labels)}
    >
    </div>
  </div>

  <!-- Modal de detalle -->
  <div
    id="project-modal"
    class="modal-backdrop"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="pm-title"
  >
    <div
      class="relative max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-xl border border-bg-border bg-bg-card p-6 shadow-2xl"
    >
      <button
        id="pm-close"
        type="button"
        class="absolute right-3 top-3 rounded-md p-1.5 text-text-muted transition hover:bg-bg-soft hover:text-text"
        aria-label="Cerrar"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z"
          ></path></svg
        >
      </button>
      <img
        id="pm-image"
        class="mb-4 hidden aspect-video w-full rounded-lg border border-bg-border object-cover"
        alt=""
      />
      <h3 id="pm-title" class="pr-8 text-lg font-semibold text-text"></h3>
      <p id="pm-desc" class="mt-3 whitespace-pre-line text-sm leading-relaxed text-text-muted"></p>
      <ul id="pm-stack" class="mt-4 flex flex-wrap gap-1.5"></ul>
      <div id="pm-links" class="mt-5 flex flex-wrap gap-2"></div>
    </div>
  </div>
</section>

<script>
  function initProjects() {
    const grid = document.getElementById('projects-grid');
    const status = document.getElementById('projects-status');
    const statusText = document.getElementById('projects-status-text');
    if (!grid || grid.dataset.loaded) return;

    const apiUrl = grid.dataset.api || '';
    const labels = JSON.parse(grid.dataset.labels || '{}');

    // SVGs for Premium Buttons
    const githubSvg = `<svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/></svg>`;
    const externalSvg = `<svg class="h-3.5 w-3.5 stroke-current" fill="none" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>`;
    const eyeSvg = `<svg class="h-3.5 w-3.5 stroke-current" fill="none" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`;

    // --- Seguridad (S3): solo se aceptan URLs de esquema seguro ---
    function safeUrl(url) {
      if (typeof url !== 'string') return '';
      const u = url.trim();
      if (/^(https?:\/\/|mailto:|\/)/i.test(u)) return u;
      return '';
    }

    // --- Modal ---
    const modal = document.getElementById('project-modal');
    const pmImage = document.getElementById('pm-image');
    const pmTitle = document.getElementById('pm-title');
    const pmDesc = document.getElementById('pm-desc');
    const pmStack = document.getElementById('pm-stack');
    const pmLinks = document.getElementById('pm-links');
    const pmClose = document.getElementById('pm-close');
    let lastFocus = null;

    function linkEl(href, text, iconSvg, isPrimary = false) {
      const safe = safeUrl(href);
      if (!safe) return null;
      const a = document.createElement('a');
      a.href = safe;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      
      const spanText = document.createElement('span');
      spanText.textContent = text;
      
      a.innerHTML = iconSvg || '';
      a.appendChild(spanText);
      
      a.className = isPrimary 
        ? 'inline-flex items-center gap-1.5 rounded-lg border border-accent bg-accent/10 hover:bg-accent hover:text-bg px-3 py-1.5 text-xs font-semibold text-accent transition duration-200 shadow-xs hover:no-underline'
        : 'inline-flex items-center gap-1.5 rounded-lg border border-bg-border bg-bg-soft/40 hover:bg-bg-card hover:border-text-faint/40 px-3 py-1.5 text-xs font-semibold text-text-muted hover:text-text transition duration-200 shadow-xs hover:no-underline';
      return a;
    }

    function openModal(p) {
      if (!modal) return;
      lastFocus = document.activeElement;
      pmTitle.textContent = p.title || '';
      pmDesc.textContent = p.description || p.summary || '';
      const img = safeUrl(p.image_url);
      if (img) {
        pmImage.src = img;
        pmImage.alt = p.title || '';
        pmImage.classList.remove('hidden');
      } else {
        pmImage.classList.add('hidden');
        pmImage.removeAttribute('src');
      }
      
      pmStack.innerHTML = '';
      // Prepend badges to the modal stack
      (Array.isArray(p.badges) ? p.badges : []).forEach((b) => {
        const li = document.createElement('li');
        if (b === 'open-source') {
          li.className = 'badge bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 font-semibold';
          li.textContent = labels.badgeOpenSource || 'Open Source';
        } else if (b === 'in-development') {
          li.className = 'badge bg-amber-500/10 text-amber-500 border border-amber-500/20 font-semibold';
          li.textContent = labels.badgeInDevelopment || 'En Desarrollo';
        } else if (b === 'private-code') {
          li.className = 'badge bg-blue-500/10 text-blue-400 border border-blue-500/20 font-semibold';
          li.textContent = labels.badgePrivateCode || 'Código Privado';
        } else {
          return;
        }
        pmStack.appendChild(li);
      });

      (Array.isArray(p.stack) ? p.stack : []).forEach((s) => {
        const li = document.createElement('li');
        li.className = 'badge';
        li.textContent = s;
        pmStack.appendChild(li);
      });

      pmLinks.innerHTML = '';
      if (p.demo_url) {
        const el = linkEl(p.demo_url, labels.demo, externalSvg, true);
        if (el) pmLinks.appendChild(el);
      }
      if (p.repo_url) {
        const el = linkEl(p.repo_url, labels.repo, githubSvg, false);
        if (el) pmLinks.appendChild(el);
      }
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add('open'));
      pmClose.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('open');
      setTimeout(() => {
        modal.hidden = true;
      }, 180);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    if (modal) {
      pmClose.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });
    }

    // --- Tarjeta ---
    function makeCard(p) {
      const card = document.createElement('article');
      card.className =
        'reveal is-visible group flex flex-col overflow-hidden rounded-lg border border-bg-border bg-bg-card transition hover:border-text-faint/40 shadow-xs';

      if (Array.isArray(p.badges) && p.badges.length) {
        card.setAttribute('data-badges', p.badges.join(','));
      } else {
        card.setAttribute('data-badges', '');
      }

      const img = safeUrl(p.image_url);
      if (img) {
        const wrap = document.createElement('div');
        wrap.className = 'relative aspect-video overflow-hidden bg-bg-soft';
        const im = document.createElement('img');
        im.src = img;
        im.alt = p.title || '';
        im.loading = 'lazy';
        im.decoding = 'async';
        im.className = 'h-full w-full object-cover';
        wrap.appendChild(im);
        if (Number(p.featured) === 1) {
          const b = document.createElement('span');
          b.className =
            'absolute left-2 top-2 rounded-sm bg-accent px-1.5 py-0.5 text-[11px] font-semibold text-bg';
          b.textContent = labels.featured;
          wrap.appendChild(b);
        }
        card.appendChild(wrap);
      }

      const body = document.createElement('div');
      body.className = 'flex flex-1 flex-col p-5';

      const h = document.createElement('h3');
      h.className = 'text-base font-semibold text-text';
      h.textContent = p.title || '';
      body.appendChild(h);

      // Render de Badges Especiales
      if (Array.isArray(p.badges) && p.badges.length) {
        const badgeContainer = document.createElement('div');
        badgeContainer.className = 'flex flex-wrap gap-1.5 mt-1.5 mb-0.5';
        p.badges.forEach((b) => {
          const badgeSpan = document.createElement('span');
          if (b === 'open-source') {
            badgeSpan.className = 'rounded-sm bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-500 border border-emerald-500/20';
            badgeSpan.textContent = labels.badgeOpenSource || 'Open Source';
          } else if (b === 'in-development') {
            badgeSpan.className = 'rounded-sm bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold text-amber-500 border border-amber-500/20';
            badgeSpan.textContent = labels.badgeInDevelopment || 'En Desarrollo';
          } else if (b === 'private-code') {
            badgeSpan.className = 'rounded-sm bg-blue-500/10 px-2 py-0.5 text-[10px] font-semibold text-blue-400 border border-blue-500/20';
            badgeSpan.textContent = labels.badgePrivateCode || 'Código Privado';
          } else {
            return;
          }
          badgeContainer.appendChild(badgeSpan);
        });
        body.appendChild(badgeContainer);
      }

      const sum = document.createElement('p');
      sum.className = 'mt-2 text-sm leading-relaxed text-text-muted';
      sum.textContent = p.summary || '';
      body.appendChild(sum);

      if (Array.isArray(p.stack) && p.stack.length) {
        const st = document.createElement('ul');
        st.className = 'mt-4 flex flex-wrap gap-1.5';
        p.stack.forEach((s) => {
          const li = document.createElement('li');
          li.className =
            'rounded-sm border border-bg-border px-1.5 py-0.5 font-mono text-[11px] text-text-muted bg-bg-soft/20';
          li.textContent = s;
          st.appendChild(li);
        });
        body.appendChild(st);
      }

      const links = document.createElement('div');
      links.className = 'mt-auto pt-5 flex flex-wrap items-center gap-2 border-t border-bg-border/40';
      const hasDetail = (p.description && p.description.trim()) || img;
      if (hasDetail) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.innerHTML = eyeSvg + `<span>${labels.details}</span>`;
        btn.className =
          'inline-flex items-center gap-1.5 rounded-lg border border-bg-border bg-bg-soft/40 hover:bg-bg-card hover:border-text-faint/40 px-3 py-1.5 text-xs font-semibold text-text-muted hover:text-text transition duration-200 shadow-xs cursor-pointer';
        btn.addEventListener('click', () => openModal(p));
        links.appendChild(btn);
      }
      
      if (p.demo_url) {
        const el = linkEl(p.demo_url, labels.demo, externalSvg, true);
        if (el) links.appendChild(el);
      }
      if (p.repo_url) {
        const el = linkEl(p.repo_url, labels.repo, githubSvg, false);
        if (el) links.appendChild(el);
      }
      
      if (links.childElementCount) body.appendChild(links);

      card.appendChild(body);
      return card;
    }

    function message(text) {
      if (status) status.classList.add('hidden');
      const p = document.createElement('p');
      p.className = 'text-sm text-text-muted';
      p.textContent = text;
      grid.appendChild(p);
    }

    function fetchWithRetry(url, options = {}, retries = 3, delay = 500) {
      return fetch(url, options)
        .then((res) => {
          if (!res.ok) {
            if (retries > 0) {
              return new Promise((resolve) => setTimeout(resolve, delay))
                .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
            }
            throw new Error('HTTP ' + res.status);
          }
          return res.json();
        })
        .catch((err) => {
          if (retries > 0) {
            return new Promise((resolve) => setTimeout(resolve, delay))
              .then(() => fetchWithRetry(url, options, retries - 1, delay * 1.5));
          }
          throw err;
        });
    }

    fetchWithRetry(apiUrl, { headers: { Accept: 'application/json' } })
      .then((data) => {
        grid.dataset.loaded = '1';
        const items = Array.isArray(data) ? data : data.items || [];
        if (status) status.classList.add('hidden');
        if (!items.length) return message(labels.empty);
        
        // Show filters container
        const filtersContainer = document.getElementById('projects-filters');
        if (filtersContainer) filtersContainer.classList.remove('hidden');
        
        items.forEach((p) => grid.appendChild(makeCard(p)));

        // Setup filter buttons click handling
        const filterButtons = document.querySelectorAll('.project-filter-btn');
        filterButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            filterButtons.forEach(b => {
              b.classList.remove('bg-accent', 'text-bg', 'border-accent');
              b.classList.add('bg-bg-soft/40', 'text-text-muted', 'border-bg-border/60');
            });
            btn.classList.add('bg-accent', 'text-bg', 'border-accent');
            btn.classList.remove('bg-bg-soft/40', 'text-text-muted', 'border-bg-border/60');
            
            const filterValue = btn.getAttribute('data-filter');
            const cards = grid.querySelectorAll('article');
            cards.forEach(card => {
              const badgesAttr = card.getAttribute('data-badges') || '';
              const badges = badgesAttr ? badgesAttr.split(',') : [];
              if (filterValue === 'all' || badges.includes(filterValue)) {
                card.classList.remove('hidden');
              } else {
                card.classList.add('hidden');
              }
            });
          });
        });
      })
      .catch(() => {
        if (statusText) statusText.textContent = labels.error;
        if (status) status.querySelector('span')?.classList.remove('animate-spin');
      });
  }
  initProjects();
  document.addEventListener('astro:page-load', initProjects);
</script>
