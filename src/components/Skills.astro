---
/**
 * <Skills /> - Habilidades agrupadas por categoria, como un glosario denso:
 * categoria (con su icono) a la izquierda y sus habilidades en una linea que
 * fluye a la derecha. Sin carrusel, sin ventana, sin JS.
 *
 * SEO/GEO: las habilidades estan todas en el HTML estatico. La lista tambien
 * viaja en el JSON-LD (Seo.astro) y en /llms.txt.
 */
import { useTranslations, pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { skillGroups, skillRefHref } from '../data/skills';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="habilidades" class="border-b border-bg-border py-14 sm:py-16">
  <div class="container-page">
    <div class="mb-8">
      <h2 class="section-title">{t('skills.title')}</h2>
      <p class="section-subtitle">{t('skills.subtitle')}</p>
    </div>

    <dl class="border-y border-bg-border">
      {
        skillGroups.map((group) => (
          <div class="grid gap-x-8 gap-y-1.5 border-b border-bg-border py-3.5 last:border-b-0 sm:grid-cols-[14rem_1fr]">
            <dt class="flex items-start gap-2 text-sm font-semibold leading-snug text-text">
              <Icon name={group.icon} class="mt-0.5 h-4 w-4 shrink-0 text-text-muted" />
              {pick(group.category, lang)}
            </dt>
            <dd>
              <ul class="dot-list skills-list text-sm leading-relaxed text-text-muted">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {group.refs && group.refs.length > 0 && (
                <p class="mt-2 text-xs text-text-muted">
                  <span class="font-mono">{t('skills.evidence')}:</span>
                  {group.refs.map((ref, i) => (
                    <>
                      {i > 0 ? ', ' : ' '}
                      <a href={skillRefHref(ref, lang)} class="skills-ref text-accent underline underline-offset-2">{ref.label}</a>
                    </>
                  ))}
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
