---
/**
 * <StackStrip /> - Una sola linea estatica con las tecnologias del puesto
 * actual (src/data/experience.ts, las mismas que respaldan la ficha del hero).
 * Sin marquee: lo que no cabe en la linea se recorta por elemento entero
 * (altura fija de una linea), sin scroll horizontal.
 */
import { experiences } from '../data/experience';

const current = experiences.find((e) => e.current) ?? experiences[0];
const items = current.tech;
---

<div class="stack-strip no-print">
  <div class="container-page flex items-center gap-4 py-3">
    <span class="shrink-0 font-mono text-xs text-text-muted">Stack</span>
    <ul class="stack-line min-w-0 flex-1 text-sm text-text">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>
