---
/**
 * Página 400 (Petición Incorrecta).
 * Astro la compila a /400/index.html, que el .htaccess sirve como página de error.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="400 · Petición incorrecta"
  description="La solicitud no pudo ser procesada por el servidor."
  lang="es"
  path="/400/"
  withFaq={false}
  noindex={true}
>
  <section class="container-page flex min-h-[75vh] flex-col items-center justify-center gap-10 py-12 lg:flex-row lg:gap-16">
    <!-- Lado Izquierdo: Número de Error Gigante -->
    <div class="text-center lg:text-left lg:w-1/3">
      <h1 class="font-mono text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-linear-to-br from-accent to-accent-cyan drop-shadow-[0_0_35px_rgba(74,222,128,0.25)] md:text-9xl lg:text-[10rem]">
        400
      </h1>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl uppercase font-mono">
        BAD_REQUEST
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted max-w-xs mx-auto lg:mx-0">
        El servidor detectó una anomalía o un error de sintaxis en la petición entrante.
      </p>
    </div>

    <!-- Lado Derecho: Terminal -->
    <div class="w-full max-w-lg lg:w-2/3">
      <div class="rounded-lg border border-bg-border bg-bg-soft p-6 shadow-2xl md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-bg-border pb-4">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
          </div>
          <span class="font-mono text-xs text-text-faint">system_error.log</span>
        </div>

        <div class="font-mono text-sm leading-relaxed">
          <p class="text-text-muted">
            <span class="text-accent">$</span> curl -I https://eduolihez.com/invalid-request
          </p>
          <p class="mt-2 text-red-400">
            HTTP/1.1 400 Bad Request
          </p>
          <p class="mt-4 text-text">
            <span class="text-accent font-bold">[!] ERROR DE PROTOCOLO:</span>
            La solicitud enviada por el navegador contiene cabeceras inválidas, cookies corruptas o un formato no admitido por el servidor.
          </p>
          
          <div class="mt-6 rounded-sm border border-red-500/20 bg-red-500/5 p-3 text-xs text-text-muted">
            <span class="block font-semibold text-red-400 mb-1">Diagnóstico técnico:</span>
            <span>Code: 400_BAD_REQUEST // Origin: Client_Header_Error // Severity: LOW</span>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <span class="text-xs text-text-faint"># Soluciones de cliente:</span>
            <span class="text-xs text-text-muted">1. Limpia las cookies y caché del navegador.</span>
            <span class="text-xs text-text-muted">2. Verifica los parámetros o la URL ingresada.</span>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center lg:text-left">
        <a href="/" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left mr-1 inline-block" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
