---
/** Pagina 400. Marcado compartido en ErrorPage.astro. */
import ErrorPage from '../components/ErrorPage.astro';
const actions = [{ href: '/', label: 'Back to home' }, { href: '/blog/', label: 'Search the blog' }, { href: '/#contacto', label: 'Contact' }];
---

<ErrorPage
  code="400"
  status="BAD_REQUEST"
  title="400 · Bad request"
  description="The server could not process this request."
  path="/400/"
  heading="That request could not be processed"
  summary="Something in the address or in the data your browser sent was not valid. Check the URL and try again, or clear this site's cookies."
  actions={actions}
>
</ErrorPage>
