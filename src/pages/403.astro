---
/** Pagina 403. Marcado compartido en ErrorPage.astro. */
import ErrorPage from '../components/ErrorPage.astro';
const actions = [{ href: '/', label: 'Back to home' }, { href: '/#contacto', label: 'Contact' }];
---

<ErrorPage
  code="403"
  status="FORBIDDEN"
  title="403 · Access denied"
  description="You do not have permission to view this resource."
  path="/403/"
  heading="You do not have access to this page"
  summary="This area is restricted. If you are the administrator, sign in first. If you think this is a mistake, get in touch."
  actions={actions}
>
</ErrorPage>
