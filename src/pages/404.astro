---
/** Pagina 404. Marcado compartido en ErrorPage.astro. */
import ErrorPage from '../components/ErrorPage.astro';
const actions = [{ href: '/', label: 'Back to home' }, { href: '/blog/', label: 'Search the blog' }, { href: '/#contacto', label: 'Contact' }];
---

<ErrorPage
  code="404"
  status="NOT_FOUND"
  title="404 · Page not found"
  description="The page you are looking for does not exist or has moved."
  path="/404.html"
  heading="This page does not exist"
  summary="The address may have a typo, or the page was moved or deleted. Go back to the start, look in the blog, or write to me."
  actions={actions}
>
  <span aria-hidden="true">/</span>
  <span id="request-uri" class="error-page__uri">URL_Solicitada</span>
</ErrorPage>

<!-- Rellena la URL real que se ha intentado abrir.
     SIN `is:inline`: Astro debe PROCESAR este script para meter su hash
     SHA-256 en la CSP al compilar; con `is:inline` quedaba fuera y el
     navegador lo bloqueaba en produccion. -->
<script>
  const uriEl = document.getElementById('request-uri');
  if (uriEl) {
    uriEl.textContent = window.location.pathname;
  }
</script>
