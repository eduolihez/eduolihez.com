---
/**
 * Página 404 (No Encontrada).
 * Astro la compila a /404.html en la raíz, que el .htaccess sirve como página de error.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 · Página no encontrada"
  description="La página que buscas no existe o se ha movido."
  lang="es"
  path="/404.html"
  withFaq={false}
  noindex={true}
>
  <section class="container-page flex min-h-[75vh] flex-col items-center justify-center gap-10 py-12 lg:flex-row lg:gap-16">
    <!-- Lado Izquierdo: Número de Error Gigante -->
    <div class="text-center lg:text-left lg:w-1/3">
      <h1 class="font-mono text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-linear-to-br from-accent to-yellow-500 drop-shadow-[0_0_35px_rgba(74,222,128,0.25)] md:text-9xl lg:text-[10rem]">
        404
      </h1>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl uppercase font-mono">
        NOT_FOUND
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted max-w-xs mx-auto lg:mx-0">
        La ruta solicitada no corresponde a ningún recurso activo en el servidor.
      </p>
    </div>

    <!-- Lado Derecho: Terminal -->
    <div class="w-full max-w-lg lg:w-2/3">
      <div class="rounded-lg border border-bg-border bg-bg-soft p-6 shadow-2xl md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-bg-border pb-4">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-accent animate-pulse" title="Estado: Listo"></span>
            <span class="font-mono text-xs text-accent">PAGE_NOT_FOUND</span>
          </div>
          <span class="font-mono text-xs text-text-faint">route_resolver.log</span>
        </div>

        <div class="font-mono text-sm leading-relaxed">
          <p class="text-text-muted">
            <span class="text-accent">$</span> locate --target=requested_route
          </p>
          <p class="mt-2 text-accent">
            ERROR: 404 ROUTE NOT FOUND
          </p>
          <p class="mt-4 text-text">
            <span class="text-accent font-bold">[?] DETECCIÓN:</span>
            El recurso o la dirección URL solicitada no se encuentra en el servidor. Es posible que haya sido eliminada, que se haya cambiado de nombre o que no sea correcta.
          </p>
          
          <div class="mt-6 rounded-sm border border-bg-border bg-bg-card p-3 text-xs text-text-muted">
            <span class="block font-semibold text-text mb-1">Diagnóstico técnico:</span>
            <span>Code: 404_NOT_FOUND // URI: <span id="request-uri">URL_Solicitada</span> // Status: ARCHIVED_OR_INVALID</span>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <span class="text-xs text-text-faint"># Sugerencias:</span>
            <span class="text-xs text-text-muted">1. Revisa errores de escritura en la barra de direcciones.</span>
            <span class="text-xs text-text-muted">2. Haz clic en el botón inferior para volver al inicio.</span>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center lg:text-left">
        <a href="/" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left mr-1 inline-block" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Rellena la URL real que se ha intentado abrir.

       SIN `is:inline`: Astro debe PROCESAR este script para poder calcular su
       hash SHA-256 y meterlo en la CSP al compilar. Con `is:inline` el script
       se copiaba tal cual, quedaba fuera de la CSP y el navegador lo bloqueaba
       en producción (el diagnóstico se quedaba en "URL_Solicitada"). -->
  <script>
    // Los scripts procesados son módulos (diferidos): el DOM ya está listo
    // cuando se ejecutan, así que no hace falta esperar a DOMContentLoaded.
    const uriEl = document.getElementById('request-uri');
    if (uriEl) {
      uriEl.textContent = window.location.pathname;
    }
  </script>
</BaseLayout>
