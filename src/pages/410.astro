---
/**
 * Página 410 (Contenido retirado).
 * Astro la compila a /410/index.html, que el .htaccess sirve como página de error.
 *
 * Se usa para las URLs de proyectos retirados (BadaVeu, Mes Badalona). A
 * diferencia del 404, el 410 le dice al buscador que la retirada es
 * deliberada y permanente, y eso acelera bastante la desindexación.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="410 · Content removed"
  description="This project is no longer available on eduolihez.com."
  lang="en"
  path="/410/"
  withFaq={false}
  noindex={true}
>
  <section class="container-page flex min-h-[75vh] flex-col items-center justify-center gap-10 py-12 lg:flex-row lg:gap-16">
    <!-- Lado Izquierdo: Número de Error Gigante -->
    <div class="text-center lg:text-left lg:w-1/3">
      <h1 class="font-mono text-7xl font-bold tracking-tight text-warn sm:text-8xl">
        410
      </h1>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl uppercase font-mono">
        GONE
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted max-w-xs mx-auto lg:mx-0">
        The project you are looking for has been permanently removed from this site.
      </p>
    </div>

    <!-- Lado Derecho: Terminal -->
    <div class="w-full max-w-lg lg:w-2/3">
      <div class="rounded-lg border border-warn/20 bg-bg-soft p-6 shadow-2xl md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-bg-border pb-4">
          <div class="flex items-center gap-2">
            <span class="h-3.5 w-3.5 rounded-full bg-warn" aria-hidden="true"></span>
            <span class="font-mono text-xs font-semibold text-warn">RESOURCE_RETIRED</span>
          </div>
          <span class="font-mono text-xs text-text-faint">retirement.log</span>
        </div>

        <div class="font-mono text-sm leading-relaxed">
          <p class="text-text-muted">
            <span class="text-warn">$</span> fetch --resource
          </p>
          <p class="mt-2 text-warn font-bold">
            STATUS: 410 GONE (PERMANENTLY REMOVED)
          </p>
          <p class="mt-4 text-text">
            <span class="text-warn font-bold">[i] NOT AN ERROR:</span>
            this content existed and was taken down on purpose. There is no newer
            version to redirect you to, so the server says so plainly instead
            of pretending the page never existed.
          </p>

          <div class="mt-6 rounded-sm border border-warn/20 bg-warn/5 p-4 text-xs text-warn">
            <div class="grid grid-cols-3 gap-y-1 font-semibold">
              <span>Status:</span>
              <span class="col-span-2 text-text">410 Gone</span>
              <span>Reason:</span>
              <span class="col-span-2 text-text">Project retired from the portfolio</span>
              <span>Indexing:</span>
              <span class="col-span-2 text-text">Removal requested from search engines</span>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <span class="text-xs text-text-faint"># What you can do:</span>
            <span class="text-xs text-text-muted">1. Browse the projects that are still published.</span>
            <span class="text-xs text-text-muted">2. Looking for something specific? Write to me and I will point you to it.</span>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 text-center sm:flex-row lg:text-left">
        <a href="/projects/" class="btn-primary">View projects</a>
        <a href="/" class="btn-ghost">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
