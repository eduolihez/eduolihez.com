---
/**
 * Página 410 (Contenido retirado).
 * Astro la compila a /410/index.html, que el .htaccess sirve como página de error.
 *
 * Se usa para las URLs de proyectos retirados (BadaVeu, Mes Badalona). A
 * diferencia del 404, el 410 le dice al buscador que la retirada es
 * deliberada y permanente, y eso acelera bastante la desindexación.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="410 · Contenido retirado"
  description="Este proyecto ya no está disponible en eduolihez.com."
  lang="es"
  path="/410/"
  withFaq={false}
  noindex={true}
>
  <section class="container-page flex min-h-[75vh] flex-col items-center justify-center gap-10 py-12 lg:flex-row lg:gap-16">
    <!-- Lado Izquierdo: Número de Error Gigante -->
    <div class="text-center lg:text-left lg:w-1/3">
      <h1 class="font-mono text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-amber-500 to-orange-600 drop-shadow-[0_0_35px_rgba(245,158,11,0.25)] md:text-9xl lg:text-[10rem]">
        410
      </h1>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl uppercase font-mono">
        GONE
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted max-w-xs mx-auto lg:mx-0">
        El proyecto que buscas se ha retirado de este sitio de forma permanente.
      </p>
    </div>

    <!-- Lado Derecho: Terminal -->
    <div class="w-full max-w-lg lg:w-2/3">
      <div class="rounded-lg border border-amber-500/20 bg-bg-soft p-6 shadow-2xl md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-bg-border pb-4">
          <div class="flex items-center gap-2">
            <span class="h-3.5 w-3.5 rounded-full bg-amber-500" title="Recurso retirado"></span>
            <span class="font-mono text-xs font-semibold text-amber-400">RESOURCE_RETIRED</span>
          </div>
          <span class="font-mono text-xs text-text-faint">registro.log</span>
        </div>

        <div class="font-mono text-sm leading-relaxed">
          <p class="text-text-muted">
            <span class="text-amber-400">$</span> fetch --resource
          </p>
          <p class="mt-2 text-amber-500 font-bold">
            STATUS: 410 GONE (RETIRADO DE FORMA PERMANENTE)
          </p>
          <p class="mt-4 text-text">
            <span class="text-amber-400 font-bold">[i] NO ES UN ERROR:</span>
            este contenido existía y se ha retirado a propósito. No hay una
            versión nueva a la que redirigirte, así que el servidor lo dice
            claramente en vez de fingir que la página nunca existió.
          </p>

          <div class="mt-6 rounded border border-amber-500/20 bg-amber-500/5 p-4 text-xs text-amber-300">
            <div class="grid grid-cols-3 gap-y-1 font-semibold">
              <span>Estado:</span>
              <span class="col-span-2 text-text">410 Gone</span>
              <span>Motivo:</span>
              <span class="col-span-2 text-text">Proyecto retirado del portfolio</span>
              <span>Indexación:</span>
              <span class="col-span-2 text-text">Retirada solicitada a los buscadores</span>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <span class="text-xs text-text-faint"># ¿Qué puedes hacer?</span>
            <span class="text-xs text-text-muted">1. Consulta el resto de proyectos publicados.</span>
            <span class="text-xs text-text-muted">2. Si buscabas algo concreto, escríbeme y te digo dónde está.</span>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-3 text-center sm:flex-row lg:text-left">
        <a href="/projects/" class="btn-primary">Ver proyectos</a>
        <a href="/" class="btn-ghost">Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>
