---
/** Pagina 410. Marcado compartido en ErrorPage.astro. */
import ErrorPage from '../components/ErrorPage.astro';
const actions = [{ href: '/projects/', label: 'View projects' }, { href: '/', label: 'Back to home' }, { href: '/#contacto', label: 'Contact' }];
---

<ErrorPage
  code="410"
  status="GONE"
  title="410 · Content removed"
  description="This project is no longer available on eduolihez.com."
  path="/410/"
  heading="This content was removed on purpose"
  summary="It existed and was taken down, and there is no newer version to send you to. The projects that are still published are listed below."
  actions={actions}
>
</ErrorPage>
