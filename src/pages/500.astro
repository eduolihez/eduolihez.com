---
/**
 * Página 500 (Error Interno del Servidor).
 * Astro la compila a /500.html en la raíz, que el .htaccess sirve como página de error.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="500 · Error del servidor"
  description="Ha ocurrido un error interno en el servidor."
  lang="es"
  path="/500/"
  withFaq={false}
  noindex={true}
>
  <section class="container-page flex min-h-[75vh] flex-col items-center justify-center gap-10 py-12 lg:flex-row lg:gap-16">
    <!-- Lado Izquierdo: Número de Error Gigante -->
    <div class="text-center lg:text-left lg:w-1/3">
      <h1 class="font-mono text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-red-600 to-rose-900 drop-shadow-[0_0_35px_rgba(220,38,38,0.25)] md:text-9xl lg:text-[10rem]">
        500
      </h1>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-text sm:text-3xl uppercase font-mono">
        SERVER_ERROR
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-text-muted max-w-xs mx-auto lg:mx-0">
        El servidor ha registrado una anomalía crítica e inesperada.
      </p>
    </div>

    <!-- Lado Derecho: Terminal -->
    <div class="w-full max-w-lg lg:w-2/3">
      <div class="rounded-lg border border-red-950/60 bg-bg-soft p-6 shadow-2xl md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-bg-border pb-4">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-red-600 animate-ping absolute" title="Fallo Crítico"></span>
            <span class="h-3 w-3 rounded-full bg-red-500 relative" title="Fallo Crítico"></span>
            <span class="font-mono text-xs font-bold text-red-500">CRITICAL_SYSTEM_ERR</span>
          </div>
          <span class="font-mono text-xs text-text-faint">kernel_panic.log</span>
        </div>

        <div class="font-mono text-sm leading-relaxed">
          <p class="text-text-muted">
            <span class="text-red-500">#</span> systemctl status backend-service
          </p>
          <p class="mt-2 text-red-500 font-bold">
            ● backend-service.service - Portfolio Core Service
          </p>
          <p class="text-red-400 pl-4">
            Active: failed (Result: exit-code) since Saturday 2026-07-25
          </p>
          <p class="mt-4 text-text">
            <span class="text-red-500 font-bold">[!] FALLO DE EJECUCIÓN (500):</span>
            El servidor ha experimentado una anomalía inesperada que impide completar la solicitud. Este evento se asocia habitualmente a tareas de mantenimiento, caída de servicios o fallos de configuración.
          </p>
          
          <div class="mt-6 rounded border border-red-950/60 bg-red-950/30 p-4 text-xs text-red-300 font-mono">
            <div class="font-semibold text-red-400 mb-1">Volcado de pila simulado:</div>
            <div class="text-[11px] leading-4 text-text-muted">
              [PANIC] Traceback (most recent call):<br/>
              &nbsp;&nbsp;File "db.php", line 28, in connect_database<br/>
              &nbsp;&nbsp;PDOException: SQLSTATE[HY000] [2002] Connection timed out<br/>
              &nbsp;&nbsp;Process terminated with status 500. Log dispatched.
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-2">
            <span class="text-xs text-text-faint"># Acciones recomendadas:</span>
            <span class="text-xs text-text-muted">1. Espera unos momentos e intenta refrescar la página.</span>
            <span class="text-xs text-text-muted">2. Si persiste, el equipo técnico ya está al tanto y trabajando en ello.</span>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center lg:text-left">
        <a href="/" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left mr-1 inline-block" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
