---
/** Pagina 500. Marcado compartido en ErrorPage.astro. */
import ErrorPage from '../components/ErrorPage.astro';
const actions = [{ href: '/', label: 'Back to home' }, { href: '/blog/', label: 'Search the blog' }, { href: '/#contacto', label: 'Contact' }];
---

<ErrorPage
  code="500"
  status="INTERNAL_SERVER_ERROR"
  title="500 · Server error"
  description="An internal server error occurred."
  path="/500/"
  heading="Something failed on the server"
  summary="The request was valid but the server could not complete it. Wait a moment and reload. If it keeps happening, let me know."
  actions={actions}
>
</ErrorPage>
