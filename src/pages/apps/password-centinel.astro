---
/**
 * /apps/password-centinel/ — landing de la extension Password Centinel.
 * Sustituye a public/projects/passwdcentinel/. Contenido en src/data/apps.ts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppPage from '../../components/AppPage.astro';
import { getApp } from '../../data/apps';
import { SITE } from '../../config';
import { pick } from '../../i18n/utils';

const app = getApp('password-centinel')!;
const lang = 'es';
const title = 'Password Centinel — Gestor de contraseñas local | Eduardo Olivares';
const description = pick(app.tagline, lang);

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: pick(app.description, lang),
  url: new URL('/apps/password-centinel/', SITE.domain).href,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Chrome, Chromium',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/apps/password-centinel/"
  withFaq={false}
  breadcrumbName="Password Centinel"
  breadcrumbs={[{ name: 'Proyectos', path: '/projects/' }]}
  alternates={{
    es: '/apps/password-centinel/',
    en: '/en/apps/password-centinel/',
    ca: '/apps/password-centinel/',
  }}
>
  <AppPage app={app} lang={lang} backHref="/projects/" backLabel="Volver a Proyectos" />

  <script type="application/ld+json" set:html={JSON.stringify(softwareApp)} />
</BaseLayout>
