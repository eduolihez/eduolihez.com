---
/**
 * /blog/ — Indice de articulos, ahora renderizado EN BUILD TIME (no client-side).
 * ---------------------------------------------------------------------------
 * Antes este listado se pintaba en el navegador via fetch() a /api/posts.php
 * (ver src/scripts/blog.ts), igual que el detalle de un articulo hacia antes
 * de la migracion documentada en src/lib/posts.ts. Eso tenia dos costes reales:
 *
 *  1. CLS critico (medido: 0.374 movil / 0.762 escritorio -- el umbral "malo"
 *     es 0.25). La cuadricula entera aparecia de golpe tras el fetch,
 *     empujando todo lo que hay debajo justo cuando la pagina ya parecia
 *     cargada.
 *  2. Invisible para rastreadores que no ejecutan JavaScript (GPTBot,
 *     ClaudeBot, PerplexityBot no lo hacen): un fetch a /blog/ crudo no
 *     mostraba ni un titulo, ni un enlace, ni un articulo -- justo la pagina
 *     que deberia ser la puerta de entrada a los 13 posts.
 *
 * El detalle de cada articulo (src/pages/blog/post/[slug].astro) ya se genera
 * en build-time desde fetchAllPostDetails() y esta pagina usaba el mismo
 * patron en BlogPreview.astro para las 3 ultimas entradas de la portada:
 * este archivo simplemente lo aplica al listado completo. El unico coste
 * real es el ya asumido en src/lib/posts.ts -- `npm run build` depende de
 * que la API este viva -- que no cambia con este archivo.
 *
 * El filtro por etiqueta sigue siendo interactivo, pero ahora solo
 * muestra/oculta tarjetas ya presentes en el HTML (ver <script> al final):
 * no vuelve a pedir nada a la API.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE } from '../../config';
import { fetchAllPostSummaries, isoDate } from '../../lib/posts';
import { formatDate } from '../../scripts/blog';

const lang = 'es';
const t = useTranslations(lang);

const title = 'Blog de ciberseguridad: IAM, Microsoft 365 y SOC | Edu Olivares';
const description =
  'Artículos prácticos de ciberseguridad: IAM y Entra ID, Microsoft 365, phishing, NIS2, hardening y automatización del SOC con Python.';

// El indice existe en espanol y catalan; en ingles /en/blog/ redirige a la home.
const alternates = { es: '/blog/', ca: '/ca/blog/' };

const posts = await fetchAllPostSummaries(lang);
// Categoria, no etiqueta: son ~5 valores fijos pensados para navegar el
// listado (ver POST_CATEGORIES en server/lib/post.php). Las tags siguen
// existiendo por articulo (SEO, tarjeta) pero con 13 articulos y ~5 tags
// libres cada uno, un filtro por tag llegaba a mas de 40 botones.
const categories = [...new Set(posts.map((p) => p.category).filter((c): c is string => Boolean(c)))].sort((a, b) =>
  a.localeCompare(b)
);
const blogIndex = {
  name: title,
  description,
  posts: posts.map((p) => ({
    headline: p.title,
    url: new URL(`/blog/post/${encodeURIComponent(p.slug || '')}/`, SITE.domain).href,
    datePublished: isoDate(p.published_at),
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/blog/"
  alternates={alternates}
  withFaq={false}
  breadcrumbName="Blog"
  blogIndex={blogIndex}
>
  <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
    <div class="container-page">
      <a
        href="/"
        class="group mb-8 inline-flex min-h-11 items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Volver al inicio
      </a>

      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="section-title">{t('blog.title')}</h1>
          <p class="section-subtitle">{t('blog.subtitle')}</p>
        </div>
        <a
          href="/blog/rss.xml"
          class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-bg-border px-3 py-1.5 font-mono text-xs text-text-muted transition hover:border-accent/40 hover:text-accent"
        >
          RSS
        </a>
      </div>

      {posts.length === 0 && <p class="status-panel" data-state="empty">{t('blog.empty')}</p>}

      {categories.length > 0 && (
        <div id="blog-filters" class="mb-8 flex flex-wrap gap-2" data-all="Todos">
          <button
            type="button"
            class="blog-filter-btn project-filter-btn is-active"
            data-filter="all"
          >
            Todos
          </button>
          {categories.map((category) => (
            <button
              type="button"
              class="blog-filter-btn project-filter-btn"
              data-filter={category}
            >
              {category}
            </button>
          ))}
        </div>
      )}

      {/* Lista editorial sin portadas decorativas (las portadas generadas solo
          repiten el título): fecha, minutos y categoría en mono; el enlace del
          título cubre la fila entera. */}
      <div id="blog-grid" class="blog-list">
        {posts.map((post) => {
          const href = `/blog/post/${encodeURIComponent(post.slug || '')}/`;
          return (
            <article class="blog-entry" data-category={post.category || undefined}>
              <p class="blog-entry-meta">
                <time datetime={isoDate(post.published_at).slice(0, 10)}>{formatDate(post.published_at, lang)}</time>
                {post.read_minutes ? <span>{post.read_minutes} min</span> : null}
                {post.category ? <span>{post.category}</span> : null}
              </p>
              <div class="min-w-0">
                <h2 class="blog-entry-title font-bold">
                  <a href={href} class="blog-entry-link">{post.title}</a>
                </h2>
                <p class="blog-entry-summary">{post.summary}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initStaticBlogFilters } from '../../scripts/blog';
  initStaticBlogFilters();
</script>
