---
/**
 * /blog/ — Indice de articulos en espanol.
 *
 * El listado se carga desde el API de PHP al abrir la pagina, asi que lo que
 * publiques en /admin sale al momento sin recompilar la web.
 *
 * La logica vive en src/scripts/blog.ts, compartida con ingles y catalan.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { api } from '../../config';
import StatusPanel from '../../components/StatusPanel.astro';

const lang = 'es';
const t = useTranslations(lang);

const title = 'Blog de Ciberseguridad | Eduardo Olivares';
const description =
  'Artículos, tutoriales y análisis de ciberseguridad, respuesta a incidentes, malware, Blue Team y automatización con Python.';

const apiUrl = api(`/api/posts.php?lang=${lang}`);
const alternates = { es: '/blog/', en: '/en/blog/', ca: '/ca/blog/' };
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/blog/"
  withFaq={false}
  alternates={alternates}
  breadcrumbName="Blog"
>
  <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
    <div class="container-page">
      <a
        href="/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Volver al inicio
      </a>

      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-kicker">Divulgación técnica</p>
          <h1 class="section-title">{t('blog.title')}</h1>
          <p class="section-subtitle">{t('blog.subtitle')}</p>
        </div>
        <a
          href="/blog/rss.xml"
          class="inline-flex items-center gap-1.5 rounded-md border border-bg-border px-3 py-1.5 font-mono text-xs text-text-muted transition hover:border-accent/40 hover:text-accent"
        >
          RSS
        </a>
      </div>

      <!-- Estado de carga / vacio / error -->
      <StatusPanel
        id="blog-status"
        class="mb-8"
        loadingText={t('blog.loading')}
        retryText={t('status.retry')}
      />

      <!-- Filtros por etiqueta (los rellena blog.ts a partir de los articulos) -->
      <div id="blog-filters" class="mb-8 hidden flex-wrap gap-2" data-all="Todos"></div>

      <!-- Cuadricula de articulos (la rellena blog.ts) -->
      <div
        id="blog-grid"
        class="hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-api={apiUrl}
        data-loading={t('blog.loading')}
        data-empty={t('blog.empty')}
        data-error={t('blog.error')}
        data-readmore={t('blog.readMore')}
        data-lang={lang}
        data-detail="/blog/post/"
      >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initBlogList } from '../../scripts/blog';
  initBlogList();
</script>
