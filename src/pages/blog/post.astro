---
/**
 * /blog/post/ — Detalle de un articulo (espanol).
 *
 * El articulo se elige con ?slug= y se carga del API al abrir la pagina.
 *
 * SEO: como todos los articulos comparten esta ruta, lo que se compila aqui es
 * solo el molde. Al cargar, src/scripts/blog.ts reescribe el titulo, la
 * descripcion, la canonica, las etiquetas Open Graph y el bloque BlogPosting
 * del final con los datos reales del articulo. Sin eso, para un buscador todos
 * los articulos serian la misma pagina duplicada.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE, api } from '../../config';

const lang = 'es';
const t = useTranslations(lang);

const defaultTitle = 'Artículo | Blog | Eduardo Olivares';
const defaultDesc = 'Artículo del blog de ciberseguridad de Eduardo Olivares.';

const apiUrl = api('/api/post.php');
---

<BaseLayout
  title={defaultTitle}
  description={defaultDesc}
  lang={lang}
  path="/blog/post/"
  withFaq={false}
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }]}
  breadcrumbName="Artículo"
>
  <article
    id="post-detail-wrapper"
    class="border-b border-bg-border bg-bg-soft py-20 sm:py-28"
    data-api={apiUrl}
    data-lang={lang}
    data-site={SITE.shortName}
    data-author={SITE.name}
    data-error={t('blog.error')}
    data-notfound={t('blog.notFound')}
    data-missingslug={t('blog.noSlug')}
  >
    <div class="container-page max-w-3xl">
      <a
        href="/blog/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> {t('blog.back')}
      </a>

      <!-- Carga / error -->
      <div id="post-status" class="my-12 flex items-center gap-3 text-sm text-text-muted">
        <span class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
        ></span>
        <span id="post-status-text">{t('blog.loading')}</span>
      </div>

      <!-- Contenido (lo rellena blog.ts) -->
      <div id="post-content-container" class="hidden">
        <header class="mb-8">
          <div class="mb-3 flex items-center gap-3">
            <time id="post-date" class="font-mono text-xs text-text-muted"></time>
            <span id="post-read" class="hidden font-mono text-xs text-text-faint"></span>
            <span
              class="rounded-sm border border-bg-border px-1.5 py-0.5 font-mono text-[10px] uppercase text-text-faint"
              >ES</span
            >
          </div>
          <h1
            id="post-title"
            class="mb-4 text-3xl font-bold leading-tight text-text-title sm:text-4xl"
          >
          </h1>
          <p
            id="post-summary"
            class="border-l-2 border-accent pl-4 text-base italic text-text-muted"
          >
          </p>
          <div id="post-tags" class="mt-4 hidden"></div>
        </header>

        <div id="post-cover-wrapper" class="mb-10 hidden">
          <img
            id="post-cover"
            src=""
            alt=""
            class="max-h-[400px] w-full rounded-xl border border-bg-border object-cover"
          />
        </div>

        <div id="post-body" class="prose max-w-none leading-relaxed text-text"></div>
      </div>
    </div>
  </article>

  <!--
    Molde de los datos estructurados del articulo. Va vacio a proposito y lo
    rellena blog.ts. Se reutiliza este <script> en lugar de crear uno nuevo
    porque la CSP solo se comprueba cuando el elemento entra en el documento:
    un <script> insertado despues desde JavaScript quedaria bloqueado por no
    llevar hash en la politica.
  -->
  <script type="application/ld+json" id="post-jsonld" is:inline>{}</script>
</BaseLayout>

<script>
  import { initBlogPost } from '../../scripts/blog';
  initBlogPost();
</script>
