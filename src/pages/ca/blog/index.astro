---
/**
 * /ca/blog/ — Index del blog en catala.
 *
 * El llistat es carrega des de l'API de PHP en obrir la pagina, de manera que
 * el que publiquis a /admin surt immediatament sense recompilar el web.
 *
 * La logica viu a src/scripts/blog.ts, compartida amb el castella i l'angles.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { api } from '../../../config';
import StatusPanel from '../../../components/StatusPanel.astro';

const lang = 'ca';
const t = useTranslations(lang);

const title = 'Blog de Ciberseguretat | Eduardo Olivares';
const description =
  'Articles, tutorials i anàlisi sobre ciberseguretat, resposta a incidents, programari maliciós, Blue Team i automatització amb Python.';

const apiUrl = api(`/api/posts.php?lang=${lang}`);
const alternates = { es: '/blog/', en: '/en/blog/', ca: '/ca/blog/' };
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/ca/blog/"
  withFaq={false}
  alternates={alternates}
  breadcrumbName="Blog"
>
  <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
    <div class="container-page">
      <a
        href="/ca/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Tornar a l'inici
      </a>

      <div class="reveal mb-12">
        <p class="section-kicker">Divulgació tècnica</p>
        <h1 class="section-title">{t('blog.title')}</h1>
        <p class="section-subtitle">{t('blog.subtitle')}</p>
      </div>

      <!-- Estat de carrega -->
      <StatusPanel
        id="blog-status"
        class="mb-8"
        loadingText={t('blog.loading')}
        retryText={t('status.retry')}
      />

      <!-- Llistat d'articles (l'omple blog.ts) -->
      <div
        id="blog-grid"
        class="hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-api={apiUrl}
        data-loading={t('blog.loading')}
        data-empty={t('blog.empty')}
        data-error={t('blog.error')}
        data-readmore={t('blog.readMore')}
        data-lang={lang}
        data-detail="/ca/blog/post/"
      >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initBlogList } from '../../../scripts/blog';
  initBlogList();
</script>
