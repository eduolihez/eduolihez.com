---
/**
 * /ca/blog/ — Índex d'articles en català, renderitzat EN BUILD TIME.
 * Mateix patró que src/pages/blog/index.astro (vegeu aquell fitxer pel "perquè"
 * complet): el llistat és HTML real al servidor, no un fetch al navegador, de
 * manera que els rastrejadors que no executen JavaScript també el veuen.
 *
 * Les categories venen de l'API en castellà (POST_CATEGORIES a
 * server/lib/post.php); aquí només se'n tradueix l'etiqueta del botó, el
 * valor del filtre (data-category) es manté perquè coincideixi amb el de
 * cada targeta.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { SITE } from '../../../config';
import { fetchAllPostSummaries, isoDate } from '../../../lib/posts';
import { formatDate } from '../../../scripts/blog';

const lang = 'ca';
const t = useTranslations(lang);

const title = 'Blog de ciberseguretat: IAM, Microsoft 365 i SOC | Edu Olivares';
const description =
  'Articles pràctics de ciberseguretat: IAM i Entra ID, Microsoft 365, phishing, NIS2, hardening i automatització del SOC amb Python.';

const alternates = { es: '/blog/', ca: '/ca/blog/' };

const CATEGORY_LABELS_CA: Record<string, string> = {
  'Blue Team & SOC': 'Blue Team i SOC',
  'Cloud Security e IAM': 'Cloud Security i IAM',
  'Vulnerabilidades': 'Vulnerabilitats',
  'Automatización': 'Automatització',
  'IA aplicada a seguridad': 'IA aplicada a la seguretat',
  'Herramientas y proyectos': 'Eines i projectes',
  'Carrera y trayectoria': 'Carrera i trajectòria',
  'Normativa y cumplimiento': 'Normativa i compliment',
};

const posts = await fetchAllPostSummaries(lang);
const categories = [...new Set(posts.map((p) => p.category).filter((c): c is string => Boolean(c)))].sort((a, b) =>
  a.localeCompare(b)
);
const blogIndex = {
  name: title,
  description,
  posts: posts.map((p) => ({
    headline: p.title,
    url: new URL(`/ca/blog/post/${encodeURIComponent(p.slug || '')}/`, SITE.domain).href,
    datePublished: isoDate(p.published_at),
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/ca/blog/"
  alternates={alternates}
  withFaq={false}
  breadcrumbName="Blog"
  blogIndex={blogIndex}
>
  <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
    <div class="container-page">
      <a
        href="/ca/"
        class="group mb-8 inline-flex min-h-11 items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Tornar a l'inici
      </a>

      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="section-title">{t('blog.title')}</h1>
          <p class="section-subtitle">{t('blog.subtitle')}</p>
        </div>
        <a
          href="/blog/rss.xml"
          class="inline-flex min-h-11 items-center px-1 font-mono text-xs text-text-muted underline decoration-bg-border underline-offset-4 transition hover:text-accent hover:decoration-accent"
        >
          RSS
        </a>
      </div>

      {posts.length === 0 && <p class="status-panel" data-state="empty">{t('blog.empty')}</p>}

      {categories.length > 0 && (
        <div id="blog-filters" class="mb-8 flex flex-wrap gap-2" data-all="Tots">
          <button
            type="button"
            class="blog-filter-btn project-filter-btn is-active"
            data-filter="all"
          >
            Tots
          </button>
          {categories.map((category) => (
            <button
              type="button"
              class="blog-filter-btn project-filter-btn"
              data-filter={category}
            >
              {CATEGORY_LABELS_CA[category] ?? category}
            </button>
          ))}
        </div>
      )}

      {/* Llista editorial sense portades decoratives: data, minuts i categoria
          en mono; l'enllaç del títol cobreix la fila sencera. */}
      <div id="blog-grid" class="blog-list">
        {posts.map((post) => {
          const href = `/ca/blog/post/${encodeURIComponent(post.slug || '')}/`;
          return (
            <article class="blog-entry" data-category={post.category || undefined}>
              <p class="blog-entry-meta">
                <time datetime={isoDate(post.published_at).slice(0, 10)}>{formatDate(post.published_at, lang)}</time>
                {post.read_minutes ? <span>{post.read_minutes} min</span> : null}
                {post.category ? <span>{CATEGORY_LABELS_CA[post.category] ?? post.category}</span> : null}
              </p>
              <div class="min-w-0">
                <h2 class="blog-entry-title font-bold">
                  <a href={href} class="blog-entry-link">{post.title}</a>
                </h2>
                <p class="blog-entry-summary">{post.summary}</p>
              </div>
            </article>
          );
        })}
      </div>

      <div id="blog-show-more-wrap" class="mt-6 flex hidden justify-center">
        <button
          type="button"
          id="blog-show-more"
          aria-expanded="false"
          data-label-more={t('blog.showMore')}
          data-label-less={t('blog.showLess')}
          class="btn-ghost min-h-11 cursor-pointer"
        >
          {t('blog.showMore')}
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initStaticBlogFilters } from '../../../scripts/blog';
  initStaticBlogFilters();
</script>
