---
/**
 * /ca/blog/post/ — Detall d'un article (catala).
 *
 * L'article es tria amb ?slug= i es carrega de l'API en obrir la pagina.
 *
 * SEO: com que tots els articles comparteixen aquesta ruta, el que es compila
 * aqui es nomes el motlle. En carregar, src/scripts/blog.ts reescriu el titol,
 * la descripcio, la canonica, les etiquetes Open Graph i el bloc BlogPosting
 * del final amb les dades reals de l'article. Sense aixo, per a un cercador
 * tots els articles serien la mateixa pagina duplicada.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { SITE, api } from '../../../config';

const lang = 'ca';
const t = useTranslations(lang);

const defaultTitle = 'Article | Blog | Eduardo Olivares';
const defaultDesc = "Article del blog de ciberseguretat d'Eduardo Olivares.";

const apiUrl = api('/api/post.php');
---

<BaseLayout
  title={defaultTitle}
  description={defaultDesc}
  lang={lang}
  path="/ca/blog/post/"
  withFaq={false}
  breadcrumbs={[{ name: 'Blog', path: '/ca/blog/' }]}
  breadcrumbName="Article"
>
  <article
    id="post-detail-wrapper"
    class="border-b border-bg-border bg-bg-soft py-20 sm:py-28"
    data-api={apiUrl}
    data-lang={lang}
    data-site={SITE.shortName}
    data-author={SITE.name}
    data-error={t('blog.error')}
    data-notfound={t('blog.notFound')}
    data-missingslug={t('blog.noSlug')}
  >
    <div class="container-page max-w-3xl">
      <a
        href="/ca/blog/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> {t('blog.back')}
      </a>

      <!-- Carrega / error -->
      <div id="post-status" class="my-12 flex items-center gap-3 text-sm text-text-muted">
        <span class="h-4 w-4 animate-spin rounded-full border-2 border-bg-border border-t-accent"
        ></span>
        <span id="post-status-text">{t('blog.loading')}</span>
      </div>

      <!-- Contingut (l'omple blog.ts) -->
      <div id="post-content-container" class="hidden">
        <header class="mb-8">
          <div class="mb-3 flex items-center gap-3">
            <time id="post-date" class="font-mono text-xs text-text-muted"></time>
            <span
              class="rounded border border-bg-border px-1.5 py-0.5 font-mono text-[10px] uppercase text-text-faint"
              >CA</span
            >
          </div>
          <h1
            id="post-title"
            class="mb-4 text-3xl font-bold leading-tight text-text-title sm:text-4xl"
          >
          </h1>
          <p
            id="post-summary"
            class="border-l-2 border-accent pl-4 text-base italic text-text-muted"
          >
          </p>
        </header>

        <div id="post-cover-wrapper" class="mb-10 hidden">
          <img
            id="post-cover"
            src=""
            alt=""
            class="max-h-[400px] w-full rounded-xl border border-bg-border object-cover"
          />
        </div>

        <div id="post-body" class="prose max-w-none leading-relaxed text-text"></div>
      </div>
    </div>
  </article>

  <!--
    Motlle de les dades estructurades de l'article. Va buit a proposit i
    l'omple blog.ts. Es reaprofita aquest <script> en lloc de crear-ne un de
    nou perque la CSP nomes es comprova quan l'element entra al document: un
    <script> inserit despres des de JavaScript quedaria bloquejat per no
    portar hash a la politica.
  -->
  <script type="application/ld+json" id="post-jsonld" is:inline>{}</script>
</BaseLayout>

<script>
  import { initBlogPost } from '../../../scripts/blog';
  initBlogPost();
</script>
