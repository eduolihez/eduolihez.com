---
/**
 * /ca/sobre-aquesta-web/ — Com esta construit aquest web (CATALA).
 *
 * No es una pagina de maqueting: descriu els controls concrets que porta el
 * lloc i per que hi son. El contingut tecnic viu a src/data/about-tech.ts,
 * compartit amb les versions en castella i angles.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutTech from '../../components/AboutTech.astro';

const lang = 'ca';
const title = 'Com està construït aquest web | Eduardo Olivares';
const description =
  "Arquitectura, controls de seguretat i decisions tècniques del portfolio: CSP amb hash per build, enduriment del panell PHP, analítica pròpia sense galetes i SEO estructurat.";

/** Aquesta mateixa pagina en els altres dos idiomes (per als hreflang). */
const alternates = {
  es: '/sobre-esta-web/',
  en: '/en/about-this-website/',
  ca: '/ca/sobre-aquesta-web/',
};

const labels = {
  stackTitle: 'Resum del stack',
  sourceNote:
    "Cada punt d'aquesta pàgina correspon a codi que pots obrir al repositori. Si trobes res que no quadri, el canal per avisar-me és a /.well-known/security.txt",
  metricsTitle: 'Mètriques de rendiment (PageSpeed Insights)',
  metricsNote:
    '* Mesura sobre el servidor de producció de CDMON amb HTTPS i TLS actius. És una foto d\'un moment concret, no una garantia permanent: comprova-ho tu mateix si t\'interessa.',
  metrics: ['Rendiment', 'Accessibilitat', 'Bones pràctiques', 'SEO'],
  ctaCode: 'Veure el codi a GitHub',
  ctaContact: "Parlar-ne",
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/ca/sobre-aquesta-web/"
  withFaq={false}
  alternates={alternates}
  breadcrumbName="Sobre aquesta web"
>
  <section class="border-b border-bg-border py-20 sm:py-28">
    <div class="container-page max-w-4xl">
      <a
        href="/ca/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Tornar a l'inici
      </a>

      <div class="reveal mb-14">
        <p class="section-kicker">00 / Arquitectura</p>
        <h1 class="mb-4 text-3xl font-bold tracking-tight text-text sm:text-5xl">
          Com està construït aquest web
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
          Treballo en un SOC, així que aquest web és també una declaració d'intencions: si no fos
          capaç d'assegurar el meu propi lloc, poc tindria a aportar assegurant el de ningú. A sota
          hi ha les decisions que hi ha al darrere i el motiu de cadascuna, no una llista de
          tecnologies.
        </p>
      </div>

      <AboutTech lang={lang} labels={labels} contactHref="/ca/#contacto" />
    </div>
  </section>
</BaseLayout>
