---
/**
 * /en/about-this-website/ — How this site is built (ENGLISH).
 *
 * Not a marketing page: it describes the concrete controls the site ships and
 * why they are there. The technical content lives in src/data/about-tech.ts,
 * shared with the Spanish and Catalan versions.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutTech from '../../components/AboutTech.astro';

const lang = 'en';
const title = 'How this site is built | Eduardo Olivares';
const description =
  'Architecture, security controls and technical decisions behind the portfolio: per-build CSP hashes, a hardened PHP panel, cookie-free first-party analytics and structured SEO.';

/** This same page in the other two languages (for hreflang). */
const alternates = {
  es: '/sobre-esta-web/',
  en: '/en/about-this-website/',
  ca: '/ca/sobre-aquesta-web/',
};

const labels = {
  stackTitle: 'Stack at a glance',
  sourceNote:
    'Every point on this page maps to code you can open in the repository. If something does not add up, the channel to tell me is in /.well-known/security.txt',
  metricsTitle: 'Performance metrics (PageSpeed Insights)',
  metricsNote:
    '* Measured against the CDMON production server with HTTPS and TLS enabled. It is a snapshot of one moment, not a standing guarantee: check it yourself if it matters to you.',
  metrics: ['Performance', 'Accessibility', 'Best Practices', 'SEO'],
  ctaCode: 'View the code on GitHub',
  ctaContact: 'Talk about this',
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/en/about-this-website/"
  withFaq={false}
  alternates={alternates}
  breadcrumbName="About this website"
>
  <section class="border-b border-bg-border py-20 sm:py-28">
    <div class="container-page max-w-4xl">
      <a
        href="/en/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Back to home
      </a>

      <div class="reveal mb-14">
        <p class="section-kicker">00 / Architecture</p>
        <h1 class="mb-4 text-3xl font-bold tracking-tight text-text sm:text-5xl">
          How this site is built
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
          I work in a SOC, so this site doubles as a statement of intent: if I could not secure my
          own website, I would have little to offer securing anyone else's. What follows are the
          decisions behind it and the reason for each one — not a list of technologies.
        </p>
      </div>

      <AboutTech lang={lang} labels={labels} contactHref="/en/#contacto" />
    </div>
  </section>
</BaseLayout>
