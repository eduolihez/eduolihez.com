---
/**
 * /en/blog/ — Blog index in English.
 *
 * The list is fetched from the PHP API on page load, so anything published in
 * /admin shows up immediately without rebuilding the site.
 *
 * The logic lives in src/scripts/blog.ts, shared with the Spanish and Catalan
 * versions.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { api } from '../../../config';
import StatusPanel from '../../../components/StatusPanel.astro';

const lang = 'en';
const t = useTranslations(lang);

const title = 'Cybersecurity Blog | Eduardo Olivares';
const description =
  'Articles, tutorials, and analysis on cybersecurity, incident response, malware, Blue Team, and Python automation.';

const apiUrl = api(`/api/posts.php?lang=${lang}`);
const alternates = { es: '/blog/', en: '/en/blog/', ca: '/ca/blog/' };
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/en/blog/"
  withFaq={false}
  alternates={alternates}
  breadcrumbName="Blog"
>
  <section class="border-b border-bg-border bg-bg-soft py-20 sm:py-28">
    <div class="container-page">
      <a
        href="/en/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Back to home
      </a>

      <div class="reveal mb-12">
        <p class="section-kicker">Technical writing</p>
        <h1 class="section-title">{t('blog.title')}</h1>
        <p class="section-subtitle">{t('blog.subtitle')}</p>
      </div>

      <!-- Loading state -->
      <StatusPanel
        id="blog-status"
        class="mb-8"
        loadingText={t('blog.loading')}
        retryText={t('status.retry')}
      />

      <!-- Tag filters (filled in by blog.ts from the loaded articles) -->
      <div id="blog-filters" class="mb-8 hidden flex-wrap gap-2" data-all="All"></div>

      <!-- Blog grid (filled in by blog.ts) -->
      <div
        id="blog-grid"
        class="hidden grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-api={apiUrl}
        data-loading={t('blog.loading')}
        data-empty={t('blog.empty')}
        data-error={t('blog.error')}
        data-readmore={t('blog.readMore')}
        data-lang={lang}
        data-detail="/en/blog/post/"
      >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initBlogList } from '../../../scripts/blog';
  initBlogList();
</script>
