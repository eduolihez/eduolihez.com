---
/**
 * Main page in ENGLISH (route "/en/").
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioSections from '../../components/PortfolioSections.astro';

const lang = 'en';
const title = 'Eduardo Olivares | SOC Analyst in Barcelona & Badalona';
const description =
  // Google corta en ~160 caracteres; el resto no se llega a leer.
  'SOC and cybersecurity analyst in Barcelona and Badalona, Spain: threat detection, cloud security, IAM and AI security. Trend Micro Vision One and Fortinet.';

/** Las tres portadas SI son traducciones entre si: hreflang explicito.
 *  Ya no se hereda por defecto para no ponerselo a paginas sin traducir. */
const alternates = { es: '/', en: '/en/', ca: '/ca/' };
---

<BaseLayout title={title} description={description} lang={lang} path="/en/" alternates={alternates}>
  <PortfolioSections lang={lang} />
</BaseLayout>
