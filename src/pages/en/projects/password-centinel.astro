---
/**
 * /en/projects/password-centinel/ — English welcome landing for Password
 * Centinel. See src/pages/projects/password-centinel.astro for the Spanish
 * version.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectLanding from '../../../components/ProjectLanding.astro';
import { getApp } from '../../../data/apps';
import { pick } from '../../../i18n/utils';

const app = getApp('password-centinel')!;
const lang = 'en';
const title = "You're all set! — Password Centinel | Eduardo Olivares";
const description = pick(app.tagline, lang);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/en/projects/password-centinel/"
  withFaq={false}
  noindex={true}
  breadcrumbName="Password Centinel"
  breadcrumbs={[{ name: 'Projects', path: '/projects/' }]}
  alternates={{
    es: '/projects/password-centinel/',
    en: '/en/projects/password-centinel/',
    ca: '/projects/password-centinel/',
  }}
>
  <ProjectLanding app={app} lang={lang} moreHref="/en/apps/password-centinel/" moreLabel="More details and privacy" />
</BaseLayout>
