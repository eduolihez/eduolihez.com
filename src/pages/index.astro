---
/**
 * Pagina principal en ESPANOL (ruta "/").
 *
 * SEO: el titulo lleva el puesto Y la ciudad. Es lo que hace que la pagina
 * pueda salir al buscar "analista SOC Badalona" o "ciberseguridad Barcelona",
 * no solo al buscar el nombre. Longitud ~60 caracteres para que Google no lo
 * corte; la descripcion, ~155.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioSections from '../components/PortfolioSections.astro';

const lang = 'es';
// Cloud Security e IAM delante (el foco profesional, igual que en LinkedIn) y
// Barcelona en vez de Badalona: es la ciudad que busca un reclutador. Badalona
// sigue en la direccion y en el bloque Person de Schema.org.
const title = 'Eduardo Olivares | Analista de Ciberseguridad Cloud e IAM en Barcelona';
const description =
  // 160 caracteres es donde Google corta: lo que sobra no se llega a leer.
  'Analista de ciberseguridad en Barcelona: SOC, Cloud Security, IAM y seguridad del correo. Trend Micro Vision One, Fortinet y automatización con Python.';

/** Las tres portadas SI son traducciones entre si: hreflang explicito.
 *  Ya no se hereda por defecto para no ponerselo a paginas sin traducir. */
const alternates = { es: '/', en: '/en/', ca: '/ca/' };
---

<BaseLayout title={title} description={description} lang={lang} path="/" alternates={alternates}>
  <PortfolioSections lang={lang} />
</BaseLayout>
