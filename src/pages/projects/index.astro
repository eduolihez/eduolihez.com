---
/**
 * /projects/ — indice de los proyectos con web propia.
 *
 * POR QUE EXISTE: todas las webs de proyecto cuelgan de /projects/, pero esa
 * ruta no tenia ningun archivo. Con "Options -Indexes" en el .htaccess, pedir
 * https://eduolihez.com/projects/ devolvia un 403: justo el directorio padre
 * de cada URL del sitemap. Ahora es una pagina real que ademas hace de
 * concentrador de enlaces internos hacia los seis proyectos.
 *
 * Se genera con Astro (no es HTML suelto en /public) para heredar el layout,
 * la CSP con hashes y todo el SEO del resto del sitio.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';

const lang = 'es';
const title = 'Proyectos publicados | Eduardo Olivares';
const description =
  'Herramientas de seguridad, extensiones de navegador y desarrollos web de Eduardo Olivares: Password Sentinel, PromptMaster, FollowGuard, Fluence y Zéora.';

const projects = [
  {
    name: 'Password Sentinel',
    href: '/projects/passwdcentinel/',
    tagline: 'Extensión de seguridad para Chrome',
    summary:
      'Audita la fuerza de tus contraseñas, comprueba filtraciones vía Have I Been Pwned y genera credenciales seguras. Todo dentro del navegador.',
    stack: ['JavaScript', 'Chrome API', 'HIBP'],
    lang: 'English',
  },
  {
    name: 'PromptMaster',
    href: '/projects/promptmaster/',
    tagline: 'Optimizador de prompts de IA',
    summary:
      'Convierte instrucciones vagas en prompts estructurados con rol, contexto y formato, sin salir de ChatGPT, Claude o Gemini.',
    stack: ['JavaScript', 'Chrome API', 'Tailwind'],
    lang: 'Español',
  },
  {
    name: 'FollowGuard',
    href: '/projects/followguard/',
    tagline: 'Ciberinteligencia en redes sociales',
    summary:
      'Analiza el grafo social de tus seguidores para detectar bots y perfiles falsos, con scoring de autenticidad y mapa de red.',
    stack: ['Python', 'Análisis de grafos'],
    lang: 'Español',
  },
  {
    name: 'Fluence',
    href: '/projects/fluence/',
    tagline: 'Crecimiento orgánico en Instagram',
    summary:
      'Aplicación de escritorio que interactúa con cuentas reales de tu nicho con comportamiento humano. Procesado local, sin servidores propios.',
    stack: ['Desktop', 'Automatización'],
    lang: 'English',
  },
  {
    name: 'Zéora',
    href: '/projects/zeora/',
    tagline: 'Webs para negocios de servicios',
    summary:
      'Webs profesionales listas en 72 horas para fontaneros, electricistas y reformistas, con SEO local y mantenimiento mensual.',
    stack: ['HTML', 'SEO local'],
    lang: 'Español',
  },
];

/** Lista ordenada de los proyectos, para que las IAs los lean de una vez. */
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Proyectos de Eduardo Olivares',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    description: p.summary,
    url: new URL(p.href, SITE.domain).href,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/projects/"
  withFaq={false}
  breadcrumbName="Proyectos"
>
  <section class="py-20 sm:py-28 border-b border-bg-border">
    <div class="container-page max-w-4xl">
      <a
        href="/"
        class="group mb-8 inline-flex items-center gap-2 font-mono text-xs text-text-muted transition hover:text-accent"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span> Volver al inicio
      </a>

      <div class="reveal mb-14">
        <p class="section-kicker">Laboratorio</p>
        <h1 class="mb-4 text-3xl font-bold tracking-tight text-text sm:text-5xl">
          Proyectos publicados
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
          Cada uno de estos proyectos tiene su propia web en este dominio. Son desarrollos
          propios: herramientas de seguridad, extensiones de navegador y plataformas
          ciudadanas, construidas de principio a fin.
        </p>
      </div>

      <ul class="grid gap-5 sm:grid-cols-2">
        {
          projects.map((p) => (
            <li class="reveal flex flex-col rounded-xl border border-bg-border bg-bg-card p-6 transition hover:border-accent/40">
              <div class="mb-3 flex items-baseline justify-between gap-3">
                <h2 class="text-lg font-semibold text-text">
                  <a href={p.href} class="transition hover:text-accent hover:no-underline">
                    {p.name}
                  </a>
                </h2>
                <span class="shrink-0 font-mono text-[11px] text-text-faint">{p.lang}</span>
              </div>
              <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">
                {p.tagline}
              </p>
              <p class="mb-5 text-sm leading-relaxed text-text-muted">{p.summary}</p>
              <ul class="mt-auto flex flex-wrap gap-1.5">
                {p.stack.map((s) => (
                  <li class="rounded border border-bg-border bg-bg-soft/20 px-1.5 py-0.5 font-mono text-[11px] text-text-muted">
                    {s}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</BaseLayout>
