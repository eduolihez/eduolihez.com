---
/**
 * /projects/password-centinel/ — landing de bienvenida tras instalar
 * Password Centinel. Ver src/pages/projects/nowait.astro para el porque de
 * esta pagina frente a /apps/password-centinel/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectLanding from '../../components/ProjectLanding.astro';
import { getApp } from '../../data/apps';
import { pick } from '../../i18n/utils';

const app = getApp('password-centinel')!;
const lang = 'es';
const title = '¡Ya está listo! — Password Centinel | Eduardo Olivares';
const description = pick(app.tagline, lang);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/projects/password-centinel/"
  withFaq={false}
  noindex={true}
  breadcrumbName="Password Centinel"
  breadcrumbs={[{ name: 'Proyectos', path: '/projects/' }]}
  alternates={{
    es: '/projects/password-centinel/',
    en: '/en/projects/password-centinel/',
    ca: '/projects/password-centinel/',
  }}
>
  <ProjectLanding app={app} lang={lang} moreHref="/apps/password-centinel/" moreLabel="Más detalles y privacidad" />
</BaseLayout>
