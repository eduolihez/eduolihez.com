---
/**
 * /projects/prompt-master/ — landing de bienvenida tras instalar
 * PromptMaster. Ver src/pages/projects/nowait.astro para el porque de esta
 * pagina frente a /apps/prompt-master/.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectLanding from '../../components/ProjectLanding.astro';
import { getApp } from '../../data/apps';
import { pick } from '../../i18n/utils';

const app = getApp('prompt-master')!;
const lang = 'es';
const title = '¡Ya está listo! — PromptMaster | Eduardo Olivares';
const description = pick(app.tagline, lang);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/projects/prompt-master/"
  withFaq={false}
  noindex={true}
  breadcrumbName="PromptMaster"
  breadcrumbs={[{ name: 'Proyectos', path: '/projects/' }]}
  alternates={{
    es: '/projects/prompt-master/',
    en: '/en/projects/prompt-master/',
    ca: '/projects/prompt-master/',
  }}
>
  <ProjectLanding app={app} lang={lang} moreHref="/apps/prompt-master/" moreLabel="Más detalles y privacidad" />
</BaseLayout>
